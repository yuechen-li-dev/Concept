module Innate;
profile Core;
// The compiler's innate concepts: rules every Concept program satisfies,
// written in Concept and applied by the compiler to every declaration of
// their kind. No program can omit, weaken, or redefine them.
//
// This module ships inside the compiler. Its source hash is the innate
// identity recorded in every semantic module artifact.
// See docs/design/EVT2-INNATE-CONCEPTS.md.
// Legacy predicate compatibility. Refuted names the declaration the
// diagnostic points at, and a message that says what is wrong and how to fix
// it. Remaining legacy predicates retain this fixed compatibility shape.
enum Verdict
{
    Holds,
    Refuted(declaration at, string message),
}
// ---- Ownership -------------------------------------------------------------
// Structural Drop releases a value's `owned` fields. A field whose type has a
// Drop but is not declared `owned` would hold destruction authority it never
// exercises, so its resource would leak. In a generic instance the fix belongs
// in the template.
[[diagnostic("CV4653")]]
innate concept DroppableFieldIsOwned<FieldDeclaration F>
{
    requires DroppableFieldIsOwnedHolds(F);
}
enum OwnershipEvidence {
    Valid
}
enum OwnershipRefutation {
    DroppableFieldMustBeOwned(declaration field)
}
comptime Verdict<OwnershipEvidence, OwnershipRefutation> DroppableFieldIsOwnedHolds(declaration field)
{
    typename held = compiler.TypeOf(field);
    return match
    {
        when compiler.Owned(field) or compiler.IsBorrowLike(held) or not compiler.HasDrop(held) => Verdict::Proven(OwnershipEvidence::Valid),
        otherwise => Verdict::Disproven(OwnershipRefutation::DroppableFieldMustBeOwned(field)),
    };
}
comptime string DroppableFieldIsOwnedHoldsDescribe(OwnershipRefutation refutation)
{
    return match (refutation)
    {
        OwnershipRefutation::DroppableFieldMustBeOwned(field) => OwnershipProblem(field),
    };
}
comptime string OwnershipProblem(declaration field)
{
    typename held = compiler.TypeOf(field);
    string heldName = compiler.TypeName(held);
    string template = compiler.TemplateName(compiler.Parent(field));
    string problem = "field " + compiler.QualifiedName(field) + " holds " + heldName + ", which has a Drop; ";
    return match
    {
        when template != "" => problem + "declare it `owned " + compiler.DeclaredTypeName(field) + " " + compiler.Name(field) + ";` in " + template,
        otherwise => problem + "declare it `owned " + heldName + " " + compiler.Name(field) + ";`",
    };
}
// A movable aggregate cannot copy an immovable value through one of its
// fields. Raw and sparse storage carry their own initialization authority;
// references carry a borrow rather than the value.
[[diagnostic("CV4138")]]
innate concept MovableFieldDoesNotEmbedImmovable<FieldDeclaration F>
{
    requires MovableFieldDoesNotEmbedImmovableHolds(F);
}
comptime Verdict MovableFieldDoesNotEmbedImmovableHolds(declaration field)
{
    declaration parent = compiler.Parent(field);
    typename held = compiler.TypeOf(field);
    return match
    {
        when compiler.IsImmovable(parent) or compiler.IsPartialStorage(held) or compiler.IsBorrowLike(held) or not compiler.IsImmovableType(held) => Verdict::Holds,
        otherwise => Verdict::Refuted(field, "struct " + compiler.Name(parent) + " cannot embed immovable field " + compiler.TypeName(held)),
    };
}
// ---- C ABI -----------------------------------------------------------------
// A [[repr(C)]] struct is a C value: a nonempty record whose fields are C
// scalars, handles, fixed arrays of C values, or other repr(C) records, with
// no destruction authority. The message names the path to the first field
// that is not.
[[diagnostic("C_ABI_REPR_INVALID")]]
innate concept CReprIsPlainData<TypeDeclaration T>
{
    requires CReprIsPlainDataHolds(T);
}
comptime Verdict CReprIsPlainDataHolds(declaration aggregate)
{
    typename self = compiler.TypeOf(aggregate);
    string problem = CValueProblem(self);
    return match
    {
        when not compiler.HasAttributeArgument(aggregate, "repr", "C") or not compiler.IsStruct(self) => Verdict::Holds,
        when problem == "" => Verdict::Holds,
        otherwise => Verdict::Refuted(aggregate, compiler.Name(aggregate) + ": " + problem),
    };
}
// Why value is not a C value, or "" when it is. Every TypeShape is decided
// here; a new shape stops this from compiling until someone decides it.
comptime string CValueProblem(typename value) bounded(32)
{
    return match (compiler.Shape(value))
    {
        TypeShape::Scalar(name) => match
        {
            when IsCScalar(name) => "",
            otherwise => "type is not a supported C scalar or aggregate",
        },
        TypeShape::Handle(name) => "",
        TypeShape::FixedArray(element) => CValueProblem(element),
        TypeShape::RuntimeArray(element) => "array extent is not fixed",
        TypeShape::Record(record) => CRecordProblem(record, value),
        TypeShape::Struct(aggregate) => CRecordProblem(aggregate, value),
        TypeShape::Enum(decl) => "type is not a supported C scalar or aggregate",
        TypeShape::Owned(target) => "borrowed, owned, or pointer fields need a separate explicit foreign contract",
        TypeShape::Reference(target) => "borrowed, owned, or pointer fields need a separate explicit foreign contract",
        TypeShape::Pointer(target) => "borrowed, owned, or pointer fields need a separate explicit foreign contract",
        TypeShape::Dyn(spelling) => "borrowed, owned, or pointer fields need a separate explicit foreign contract",
        TypeShape::Callable(spelling) => "field has no fixed C value representation",
        TypeShape::Async(spelling) => "field has no fixed C value representation",
        TypeShape::Generic(applied) => "field has no fixed C value representation",
        TypeShape::Other(spelling) => "type is not a supported C scalar or aggregate",
    };
}
// A struct is a C value when it is a nonempty [[repr(C)]] record of C values
// without destruction authority. Arms are tried in order, so the fields are
// walked only once the record itself qualifies.
comptime string CRecordProblem(declaration record, typename value) bounded(32)
{
    return match
    {
        when not compiler.HasAttributeArgument(record, "repr", "C") => "aggregate lacks [[repr(C)]]",
        when not compiler.IsRecord(record) or compiler.IsRefStruct(record) or compiler.IsImmovable(record) or compiler.IsClass(record) or compiler.IsTable(record) or compiler.FieldCount(record) == 0 => "repr(C) requires a nonempty record struct",
        when CFieldsProblem(record) != "" => CFieldsProblem(record),
        when compiler.NeedsDrop(value) => "aggregate carries destruction authority",
        otherwise => "",
    };
}
// The first field that is not a C value, with its path.
comptime string CFieldsProblem(declaration record) bounded(32)
{
    for (i in 0 .. compiler.FieldCount(record))
    {
        declaration field = compiler.Field(record, i);
        string problem = CValueProblem(compiler.TypeOf(field));
        if (problem != "")
        { return "field " + compiler.Name(field) + ": " + problem; }
    }
    return "";
}
// The scalars with a fixed C representation. bool, half, and string are not.
comptime bool IsCScalar(string name)
{
    return name == "int" or name == "uint" or name == "uint8" or name == "uint16" or name == "uint32" or name == "byte" or name == "uint64" or name == "usize" or name == "isize" or name == "float" or name == "double";
}
