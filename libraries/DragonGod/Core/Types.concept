module DragonGod.Core.Types;
profile Core;

record struct ProcessorId
{
    int value;
};

record struct MachineId
{
    int value;
};

record struct BatchId
{
    int value;
};

record struct AgentId
{
    int value;
};

record struct StateId
{
    int value;
};

record struct ActuationId
{
    int value;
};

record struct Reason
{
    int code;
};

record struct StaticKernelConfiguration
{
    int identity;
};

enum KernelStatus
{
    Ready,
    HaltRequested,
    Failed,
}

record struct KernelContext
{
    ProcessorId processor;
    KernelStatus status;
};

KernelContext MakeKernelContext(int processor)
{
    return KernelContext{ProcessorId{processor}, KernelStatus::Ready};
}
