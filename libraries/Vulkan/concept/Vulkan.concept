module Vulkan;
profile Core;

// Vulkan 1.4 compute in ordinary Concept.
//
// What the library decides for you:
//   * object lifetimes: every created object is an owned value whose Drop
//     releases it exactly once, in reverse order of creation;
//   * failures: every VkResult failure is a VulkanError, propagated with `?`;
//   * descriptors: bindings are push descriptors, so there are no pools or
//     sets to manage;
//   * synchronization: each recorded command declares which buffers it reads
//     and writes; the Recording derives the synchronization2 barriers from
//     those declarations, including the final device-to-host barrier;
//   * staging: uploading to or downloading from a device-local buffer goes
//     through a temporary host-visible buffer automatically.
//
// What stays yours: which device memory a buffer lives in (Placement), which
// kernels exist, and the order of the work. Kernel wrappers generated by
// `concept vulkan-bind` also take the access declarations from the SPIR-V.
//
// The C boundary is native/concept_vulkan.h.

extern "C" handle VkInstance;
extern "C" handle VkPhysicalDevice;
extern "C" handle VkDevice;
extern "C" handle VkQueue;
extern "C" handle VkCommandPool;
extern "C" handle VkCommandBuffer;
extern "C" handle VkFence;
extern "C" handle VkBuffer;
extern "C" handle VkDeviceMemory;
extern "C" handle VkShaderModule;
extern "C" handle VkDescriptorSetLayout;
extern "C" handle VkPipelineLayout;
extern "C" handle VkPipeline;
extern "C" handle VkPipelineCache;
extern "C" handle VkQueryPool;

// ---- Errors -------------------------------------------------------------

// The failing VkResult codes (negative in C).
enum VulkanError
{
    OutOfHostMemory,
    OutOfDeviceMemory,
    InitializationFailed,
    DeviceLost,
    MemoryMapFailed,
    LayerNotPresent,
    ExtensionNotPresent,
    FeatureNotPresent,
    IncompatibleDriver,
    TooManyObjects,
    FormatNotSupported,
    FragmentedPool,
    Unknown(int code),
}

// Non-negative codes are success or status; only failures become errors.
Result<void, VulkanError> Check(int code)
{
    if (code >= 0) { return Result::Ok(); }
    return Result::Error(ErrorFromCode(code));
}

VulkanError ErrorFromCode(int code)
{
    return match (code)
    {
        -1 => VulkanError::OutOfHostMemory,
        -2 => VulkanError::OutOfDeviceMemory,
        -3 => VulkanError::InitializationFailed,
        -4 => VulkanError::DeviceLost,
        -5 => VulkanError::MemoryMapFailed,
        -6 => VulkanError::LayerNotPresent,
        -7 => VulkanError::ExtensionNotPresent,
        -8 => VulkanError::FeatureNotPresent,
        -9 => VulkanError::IncompatibleDriver,
        -10 => VulkanError::TooManyObjects,
        -11 => VulkanError::FormatNotSupported,
        -12 => VulkanError::FragmentedPool,
        _ => VulkanError::Unknown(code),
    };
}

// ---- The C boundary (native/concept_vulkan.h) ---------------------------

[[repr(C)]]
record struct ContextCreation
{
    int code;
    uint32 queueFamily;
    VkInstance instance;
    VkPhysicalDevice physical;
    VkDevice device;
    VkQueue queue;
    VkCommandPool commands;
    VkPipelineCache cache;
};

[[repr(C)]]
record struct DeviceFacts
{
    uint32 apiVersion;
    uint32 deviceType;
    uint32 subgroupSize;
    uint32 maxWorkgroupInvocations;
    uint32 timestampValidBits;
    float timestampPeriod;
    uint64 maxStorageBufferRange;
    byte<array>[256] name;
};

[[repr(C)]]
record struct BufferCreation
{
    int code;
    uint32 hostVisible;
    VkBuffer buffer;
    VkDeviceMemory memory;
};

[[repr(C)]]
record struct BindingSlot
{
    uint32 binding;
    uint32 kind;
};

[[repr(C)]]
record struct PipelineCreation
{
    int code;
    uint32 pushBytes;
    VkShaderModule shader;
    VkDescriptorSetLayout setLayout;
    VkPipelineLayout layout;
    VkPipeline pipeline;
};

[[repr(C)]]
record struct RecordingBegin
{
    int code;
    uint32 timestamps;
    VkCommandBuffer commands;
    VkQueryPool queries;
};

[[repr(C)]]
record struct DescriptorWrite
{
    VkBuffer buffer;
    uint64 offset;
    uint64 range;
    uint32 binding;
    uint32 kind;
};

[[repr(C)]]
record struct SubmissionRecord
{
    int code;
    uint32 reserved;
    VkFence fence;
};

[[repr(C)]]
record struct Elapsed
{
    int code;
    uint32 reserved;
    double nanoseconds;
};

extern "C" ContextCreation ConceptVkCreateContext();
extern "C" void ConceptVkDestroyContext(VkInstance instance, VkDevice device, VkCommandPool commands, VkPipelineCache cache);
extern "C" DeviceFacts ConceptVkDeviceFacts(VkPhysicalDevice physical);
extern "C" BufferCreation ConceptVkCreateBuffer(VkPhysicalDevice physical, VkDevice device, uint64 bytes, uint32 placement);
extern "C" void ConceptVkDestroyBuffer(VkDevice device, VkBuffer buffer, VkDeviceMemory memory);
extern "C" int ConceptVkWriteBytes(VkDevice device, VkDeviceMemory memory, uint64 offset, ReadOnlySpan<byte> bytes);
extern "C" int ConceptVkReadBytes(VkDevice device, VkDeviceMemory memory, uint64 offset, Span<byte> destination);
extern "C" PipelineCreation ConceptVkCreatePipeline(VkDevice device, VkPipelineCache cache, string kernel, string entry, ReadOnlySpan<BindingSlot> bindings, uint32 pushBytes);
extern "C" void ConceptVkDestroyPipeline(VkDevice device, VkShaderModule shader, VkDescriptorSetLayout setLayout, VkPipelineLayout layout, VkPipeline pipeline);
extern "C" RecordingBegin ConceptVkBeginRecording(VkDevice device, VkCommandPool commands, uint32 timestamps);
extern "C" void ConceptVkEndAbandoned(VkDevice device, VkCommandPool commands, VkCommandBuffer recording, VkQueryPool queries);
extern "C" void ConceptVkCmdBarrier(VkCommandBuffer recording, uint32 sourceStages, uint32 sourceWrites, uint32 destinationStages);
extern "C" void ConceptVkCmdDispatch(VkCommandBuffer recording, VkPipeline pipeline, VkPipelineLayout layout, ReadOnlySpan<DescriptorWrite> writes, ReadOnlySpan<byte> pushConstants, uint32 x, uint32 y, uint32 z);
extern "C" void ConceptVkCmdCopy(VkCommandBuffer recording, VkBuffer source, VkBuffer destination, uint64 bytes);
extern "C" void ConceptVkCmdFill(VkCommandBuffer recording, VkBuffer buffer, uint64 bytes, uint32 word);
extern "C" void ConceptVkCmdTimestamp(VkCommandBuffer recording, VkQueryPool queries, uint32 index);
extern "C" SubmissionRecord ConceptVkSubmit(VkDevice device, VkQueue queue, VkCommandBuffer recording);
extern "C" int ConceptVkWait(VkDevice device, VkFence fence);
extern "C" void ConceptVkRelease(VkDevice device, VkCommandPool commands, VkCommandBuffer recording, VkFence fence, VkQueryPool queries);
extern "C" Elapsed ConceptVkElapsed(VkDevice device, VkPhysicalDevice physical, VkQueryPool queries, uint32 from, uint32 to);

// ---- Context ------------------------------------------------------------

enum DeviceKind
{
    Other,
    Integrated,
    Discrete,
    Virtual,
    Cpu,
}

DeviceKind DeviceKindOf(ref const DeviceFacts facts)
{
    return match (facts.deviceType)
    {
        1 => DeviceKind::Integrated,
        2 => DeviceKind::Discrete,
        3 => DeviceKind::Virtual,
        4 => DeviceKind::Cpu,
        _ => DeviceKind::Other,
    };
}

// A Vulkan 1.4 device with a compute queue, a command pool and a pipeline
// cache. A discrete GPU is preferred; CONCEPT_VULKAN_DEVICE (an index, or a
// substring of the device name) chooses explicitly.
class Context
{
public:
    VkInstance instance;
    VkPhysicalDevice physical;
    VkDevice device;
    VkQueue queue;
    VkCommandPool commands;
    VkPipelineCache cache;
};

void Drop(owned Context context)
{
    ConceptVkDestroyContext(context.instance, context.device, context.commands, context.cache);
}

Result<Context, VulkanError> CreateContext()
{
    ContextCreation created = ConceptVkCreateContext();
    Check(created.code)?;
    owned Context context = Context{created.instance, created.physical, created.device, created.queue, created.commands, created.cache};
    return Result::Ok(move context);
}

DeviceFacts Facts(ref const Context context)
{
    return ConceptVkDeviceFacts(context.physical);
}

// ---- Buffers ------------------------------------------------------------

// Where a buffer's memory lives. Device is fastest for kernels; Upload and
// Readback are host-visible staging; Shared is device-local memory the host
// can also map when the device has it (resizable BAR, integrated GPUs).
enum Placement
{
    Device,
    Upload,
    Readback,
    Shared,
}

uint32 PlacementCode(Placement placement)
{
    return match (placement)
    {
        Placement::Device => 0,
        Placement::Upload => 1,
        Placement::Readback => 2,
        Placement::Shared => 3,
    };
}

// Count elements of T in device memory. Dropping it frees the memory once.
template <typename T>
class Buffer
{
public:
    VkDevice device;
    VkBuffer buffer;
    VkDeviceMemory memory;
    usize count;
    bool hostVisible;
};

template <typename T>
void Drop(owned Buffer<T> buffer)
{
    ConceptVkDestroyBuffer(buffer.device, buffer.buffer, buffer.memory);
}

template <typename T>
Result<Buffer<T>, VulkanError> CreateBuffer(ref const Context context, usize count, Placement placement)
{
    usize<byte> bytes = count * SizeOf<T>();
    BufferCreation created = ConceptVkCreateBuffer(context.physical, context.device, Magnitude(bytes) as uint64, PlacementCode(placement));
    Check(created.code)?;
    owned Buffer<T> buffer = Buffer<T>{context.device, created.buffer, created.memory, count, created.hostVisible != 0};
    return Result::Ok(move buffer);
}

template <typename T>
usize<byte> ByteSize(ref const Buffer<T> buffer)
{
    return buffer.count * SizeOf<T>();
}

// Copies data into the start of target. A host-visible buffer is written
// directly; a device-local one goes through a temporary Upload buffer and a
// one-off copy that is waited for.
template <typename T>
Result<void, VulkanError> Upload(ref const Context context, ref const Buffer<T> target, ReadOnlySpan<T> data)
{
    assert((Len(data) as usize) <= target.count, "Upload: more data than the buffer holds");
    if (target.hostVisible)
    {
        return Check(ConceptVkWriteBytes(target.device, target.memory, 0, AsBytes(data)));
    }
    owned Buffer<T> staging = CreateBuffer<T>(ref const context, Len(data) as usize, Placement::Upload)?;
    Check(ConceptVkWriteBytes(staging.device, staging.memory, 0, AsBytes(data)))?;
    owned Recording recording = BeginRecording(ref const context, 0)?;
    Copy(ref recording, ref const staging, ref const target);
    owned Submission work = Submit(move recording)?;
    return Wait(ref work);
}

// Copies the start of source into destination (as many elements as
// destination holds). A device-local buffer is read through a temporary
// Readback buffer.
template <typename T>
Result<void, VulkanError> Download(ref const Context context, ref const Buffer<T> source, Span<T> destination)
{
    assert((Len(destination) as usize) <= source.count, "Download: destination is larger than the buffer");
    if (source.hostVisible)
    {
        return Check(ConceptVkReadBytes(source.device, source.memory, 0, AsBytes(destination)));
    }
    owned Buffer<T> staging = CreateBuffer<T>(ref const context, Len(destination) as usize, Placement::Readback)?;
    owned Recording recording = BeginRecording(ref const context, 0)?;
    Copy(ref recording, ref const source, ref const staging);
    owned Submission work = Submit(move recording)?;
    Wait(ref work)?;
    return Check(ConceptVkReadBytes(staging.device, staging.memory, 0, AsBytes(destination)));
}

// ---- Pipelines ----------------------------------------------------------

enum DescriptorKind
{
    StorageBuffer,
    UniformBuffer,
}

uint32 DescriptorKindCode(DescriptorKind kind)
{
    return match (kind)
    {
        DescriptorKind::StorageBuffer => 0,
        DescriptorKind::UniformBuffer => 1,
    };
}

// A compute pipeline. Its set-0 bindings are push descriptors, so binding
// buffers is part of recording a dispatch rather than a separate object.
class Pipeline
{
public:
    VkDevice device;
    VkShaderModule shader;
    VkDescriptorSetLayout setLayout;
    VkPipelineLayout layout;
    VkPipeline pipeline;
    uint32 pushBytes;
};

void Drop(owned Pipeline pipeline)
{
    ConceptVkDestroyPipeline(pipeline.device, pipeline.shader, pipeline.setLayout, pipeline.layout, pipeline.pipeline);
}

// kernel is a SPIR-V path; relative paths resolve against
// CONCEPT_VULKAN_KERNELS when set (`concept test` sets it to the test's
// directory). entry is the entry point name ("main" for GLSL).
Result<Pipeline, VulkanError> CreatePipeline(ref const Context context, string kernel, string entry, ReadOnlySpan<BindingSlot> bindings, uint32 pushBytes)
{
    PipelineCreation created = ConceptVkCreatePipeline(context.device, context.cache, kernel, entry, bindings, pushBytes);
    Check(created.code)?;
    owned Pipeline pipeline = Pipeline{context.device, created.shader, created.setLayout, created.layout, created.pipeline, pushBytes};
    return Result::Ok(move pipeline);
}

// ---- Recording ----------------------------------------------------------

// Pipeline stages a command runs in, as far as synchronization is concerned.
bits Stages : uint32
{
    compute: 0;
    transfer: 1;
    host: 2;
}

Stages NoStages()
{
    return Stages{0};
}

Stages ComputeStage()
{
    return NoStages() with { compute = true; };
}

Stages TransferStage()
{
    return NoStages() with { transfer = true; };
}

Stages HostStage()
{
    return NoStages() with { host = true; };
}

enum Access
{
    Read,
    Write,
}

// One buffer bound to one binding of a dispatch, with what the kernel does
// to it. Generated kernel wrappers fill Access from the SPIR-V.
record struct Binding
{
    uint32 slot;
    VkBuffer buffer;
    uint64 bytes;
    DescriptorKind kind;
    Access access;
};

template <typename T>
Binding Bind(uint32 slot, ref const Buffer<T> buffer, Access access)
{
    return Binding{slot, buffer.buffer, Magnitude(ByteSize(ref const buffer)) as uint64, DescriptorKind::StorageBuffer, access};
}

template <typename T>
Binding BindUniform(uint32 slot, ref const Buffer<T> buffer)
{
    return Binding{slot, buffer.buffer, Magnitude(ByteSize(ref const buffer)) as uint64, DescriptorKind::UniformBuffer, Access::Read};
}

// What happened to one buffer since the last barrier that covered it.
record struct Tracked
{
    Option<VkBuffer> buffer;
    Stages readStages;
    Stages writeStages;
};

// A buffer use by one command.
record struct Use
{
    VkBuffer buffer;
    Stages stage;
    bool writes;
};

// A command buffer being recorded. Every command declares the buffers it
// touches; Record derives the barriers. Dropping an unsubmitted recording
// frees it.
class Recording
{
public:
    VkDevice device;
    VkQueue queue;
    VkCommandPool pool;
    VkPhysicalDevice physical;
    VkCommandBuffer commands;
    VkQueryPool queries;
    uint32 timestamps;
    uint32 timestampsUsed;
    Tracked<array>[64] tracked;
    int trackedCount;
    int barriers;
    bool submitted;
};

void Drop(owned Recording recording)
{
    if (not recording.submitted)
    {
        ConceptVkEndAbandoned(recording.device, recording.pool, recording.commands, recording.queries);
    }
}

// timestamps is how many timestamp queries the recording may write.
Result<Recording, VulkanError> BeginRecording(ref const Context context, uint32 timestamps)
{
    RecordingBegin begun = ConceptVkBeginRecording(context.device, context.commands, timestamps);
    Check(begun.code)?;
    Tracked empty = Tracked{Option::None, NoStages(), NoStages()};
    owned Recording recording = Recording{context.device, context.queue, context.commands, context.physical, begun.commands, begun.queries, timestamps, 0, [empty...], 0, 0, false};
    return Result::Ok(move recording);
}

bool Tracks(ref const Tracked entry, VkBuffer buffer)
{
    return match (entry.buffer)
    {
        Option::Some(tracked) => tracked == buffer,
        Option::None => false,
    };
}

int TrackedIndex(ref Recording recording, VkBuffer buffer)
{
    for (i in 0..recording.trackedCount)
    {
        if (Tracks(ref const recording.tracked[i], buffer))
        {
            return i;
        }
    }
    assert(recording.trackedCount < 64, "a recording tracks at most 64 buffers");
    int index = recording.trackedCount;
    recording.tracked[index] = Tracked{Option::Some(buffer), NoStages(), NoStages()};
    recording.trackedCount = index + 1;
    return index;
}

Stages Union(Stages left, Stages right)
{
    return Stages{left.raw | right.raw};
}

Stages Without(Stages stages, Stages removed)
{
    return Stages{stages.raw - (stages.raw & removed.raw)};
}

bool Any(Stages stages)
{
    return stages.raw != 0;
}

// Derives and records the barrier a command needs before it touches uses,
// then records those uses. Read-after-write and write-after-write need a
// memory dependency on the earlier writes; write-after-read needs only an
// execution dependency on the earlier reads. One global synchronization2
// barrier covers every hazard of the command.
void Touch(ref Recording recording, ReadOnlySpan<Use> uses)
{
    Stages sourceStages = NoStages();
    Stages destinationStages = NoStages();
    bool sourceWrites = false;
    for (u in 0..Len(uses))
    {
        Use use = uses[u];
        int index = TrackedIndex(ref recording, use.buffer);
        Tracked entry = recording.tracked[index];
        if (Any(entry.writeStages))
        {
            sourceStages = Union(sourceStages, entry.writeStages);
            sourceWrites = true;
            destinationStages = Union(destinationStages, use.stage);
        }
        if (use.writes and Any(entry.readStages))
        {
            sourceStages = Union(sourceStages, entry.readStages);
            destinationStages = Union(destinationStages, use.stage);
        }
    }
    if (Any(sourceStages))
    {
        uint32 memoryDependency = 0;
        if (sourceWrites)
        {
            memoryDependency = 1;
        }
        ConceptVkCmdBarrier(recording.commands, sourceStages.raw, memoryDependency, destinationStages.raw);
        recording.barriers = recording.barriers + 1;
        // Everything the barrier waited on is now ordered before this command.
        for (i in 0..recording.trackedCount)
        {
            Tracked covered = recording.tracked[i];
            recording.tracked[i] = covered with { readStages = Without(covered.readStages, sourceStages); writeStages = Without(covered.writeStages, sourceStages); };
        }
    }
    for (u in 0..Len(uses))
    {
        Use use = uses[u];
        int index = TrackedIndex(ref recording, use.buffer);
        Tracked entry = recording.tracked[index];
        if (use.writes)
        {
            recording.tracked[index] = entry with { readStages = NoStages(); writeStages = use.stage; };
        }
        else
        {
            recording.tracked[index] = entry with { readStages = Union(entry.readStages, use.stage); };
        }
    }
}

uint32 AccessWrites(Access access)
{
    return match (access)
    {
        Access::Read => 0,
        Access::Write => 1,
    };
}

// Binds pipeline, pushes the bindings as descriptors and the constants, and
// dispatches groups. Barriers come from each binding's declared access.
void DispatchWith(ref Recording recording, ref const Pipeline pipeline, ReadOnlySpan<Binding> bindings, ReadOnlySpan<byte> pushConstants, uint32 x, uint32 y, uint32 z)
{
    assert(Len(bindings) <= 16, "a dispatch binds at most 16 buffers");
    assert((Len(pushConstants) as uint32) == pipeline.pushBytes, "push constants must match the pipeline's push-constant size");
    Use<array>[16] uses = [Use{bindings[0].buffer, ComputeStage(), false}...];
    DescriptorWrite<array>[16] writes = [DescriptorWrite{bindings[0].buffer, 0, 0, 0, 0}...];
    for (b in 0..Len(bindings))
    {
        Binding binding = bindings[b];
        uses[b] = Use{binding.buffer, ComputeStage(), AccessWrites(binding.access) != 0};
        writes[b] = DescriptorWrite{binding.buffer, 0, binding.bytes, binding.slot, DescriptorKindCode(binding.kind)};
    }
    Touch(ref recording, Subspan(ReadOnlySpan(uses), 0, Len(bindings)));
    ConceptVkCmdDispatch(recording.commands, pipeline.pipeline, pipeline.layout, Subspan(ReadOnlySpan(writes), 0, Len(bindings)), pushConstants, x, y, z);
}

void Dispatch(ref Recording recording, ref const Pipeline pipeline, ReadOnlySpan<Binding> bindings, uint32 x, uint32 y, uint32 z)
{
    byte<array>[1] none = [0];
    DispatchWith(ref recording, ref const pipeline, bindings, Subspan(ReadOnlySpan(none), 0, 0), x, y, z);
}

// Copies all of source into destination (as many elements as both hold).
template <typename T>
void Copy(ref Recording recording, ref const Buffer<T> source, ref const Buffer<T> destination)
{
    usize count = source.count;
    if (destination.count < count)
    {
        count = destination.count;
    }
    usize<byte> bytes = count * SizeOf<T>();
    Use<array>[2] uses = [Use{source.buffer, TransferStage(), false}, Use{destination.buffer, TransferStage(), true}];
    Touch(ref recording, ReadOnlySpan(uses));
    ConceptVkCmdCopy(recording.commands, source.buffer, destination.buffer, Magnitude(bytes) as uint64);
}

// Sets every 32-bit word of buffer to word.
template <typename T>
void Fill(ref Recording recording, ref const Buffer<T> buffer, uint32 word)
{
    Use<array>[1] uses = [Use{buffer.buffer, TransferStage(), true}];
    Touch(ref recording, ReadOnlySpan(uses));
    ConceptVkCmdFill(recording.commands, buffer.buffer, Magnitude(ByteSize(ref const buffer)) as uint64, word);
}

// Writes the next timestamp and returns its index for Elapsed.
uint32 Timestamp(ref Recording recording)
{
    assert(recording.timestampsUsed < recording.timestamps, "no timestamp queries left in this recording");
    uint32 index = recording.timestampsUsed;
    ConceptVkCmdTimestamp(recording.commands, recording.queries, index);
    recording.timestampsUsed = index + 1;
    return index;
}

// Submitted work. Wait blocks until it finishes; Drop waits if nobody did,
// then frees the command buffer, fence and queries.
class Submission
{
public:
    VkDevice device;
    VkPhysicalDevice physical;
    VkCommandPool pool;
    VkCommandBuffer commands;
    VkFence fence;
    VkQueryPool queries;
    bool waited;
};

void Drop(owned Submission submission)
{
    if (not submission.waited)
    {
        discard ConceptVkWait(submission.device, submission.fence);
    }
    ConceptVkRelease(submission.device, submission.pool, submission.commands, submission.fence, submission.queries);
}

// Ends the recording and submits it. Any buffer written on the device gets a
// final barrier to the host, so host reads after Wait see the results.
Result<Submission, VulkanError> Submit(owned Recording recording)
{
    Stages written = NoStages();
    for (i in 0..recording.trackedCount)
    {
        written = Union(written, recording.tracked[i].writeStages);
    }
    if (Any(written))
    {
        ConceptVkCmdBarrier(recording.commands, written.raw, 1, HostStage().raw);
        recording.barriers = recording.barriers + 1;
    }
    recording.submitted = true;
    SubmissionRecord submitted = ConceptVkSubmit(recording.device, recording.queue, recording.commands);
    if (submitted.code < 0)
    {
        ConceptVkEndAbandoned(recording.device, recording.pool, recording.commands, recording.queries);
        return Result::Error(ErrorFromCode(submitted.code));
    }
    owned Submission submission = Submission{recording.device, recording.physical, recording.pool, recording.commands, submitted.fence, recording.queries, false};
    return Result::Ok(move submission);
}

Result<void, VulkanError> Wait(ref Submission submission)
{
    if (submission.waited)
    {
        return Result::Ok();
    }
    submission.waited = true;
    return Check(ConceptVkWait(submission.device, submission.fence));
}

// Nanoseconds between two timestamps of a finished submission.
Result<double, VulkanError> ElapsedNanoseconds(ref const Submission submission, uint32 from, uint32 to)
{
    assert(submission.waited, "timestamps are read after Wait");
    Elapsed elapsed = ConceptVkElapsed(submission.device, submission.physical, submission.queries, from, to);
    Check(elapsed.code)?;
    return Result::Ok(elapsed.nanoseconds);
}
