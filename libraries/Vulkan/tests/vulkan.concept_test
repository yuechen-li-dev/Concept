module Vulkan.Tests;
profile Core;
import Vulkan;

// Observers exported by native/test_device.c.
extern "C" int ConceptVkTestLiveBuffers();
extern "C" int ConceptVkTestLivePipelines();
extern "C" int ConceptVkTestLiveContexts();
extern "C" int ConceptVkTestPendingSubmissions();
extern "C" int ConceptVkTestDoubleDestroys();

// Keeps only the status of a creation, dropping a created buffer.
Result<void, VulkanError> Discarded(Result<Buffer, VulkanError> created)
{
    return match (move created)
    {
        Result::Ok(buffer) => Result::Ok(),
        Result::Error(error) => Result::Error(error),
    };
}

int ErrorCode(VulkanError error)
{
    return match (error)
    {
        VulkanError::OutOfHostMemory => -1,
        VulkanError::OutOfDeviceMemory => -2,
        VulkanError::InitializationFailed => -3,
        VulkanError::DeviceLost => -4,
        VulkanError::MemoryMapFailed => -5,
        VulkanError::LayerNotPresent => -6,
        VulkanError::ExtensionNotPresent => -7,
        VulkanError::FeatureNotPresent => -8,
        VulkanError::IncompatibleDriver => -9,
        VulkanError::TooManyObjects => -10,
        VulkanError::FormatNotSupported => -11,
        VulkanError::FragmentedPool => -12,
        VulkanError::Unknown(code) => code,
    };
}

BufferUsage StorageTransfer()
{
    BufferUsage none = BufferUsage{0};
    return none with { storage = true; transferDestination = true; };
}

MemoryProperty HostVisible()
{
    MemoryProperty none = MemoryProperty{0};
    return none with { hostVisible = true; hostCoherent = true; };
}

int FailureCode(Result<void, VulkanError> result)
{
    return match (result)
    {
        Result::Ok => 0,
        Result::Error(error) => ErrorCode(error),
    };
}

[[fact]]
void EveryFailingCodeRoundTrips()
{
    for (code in 1..14)
    {
        Assert.Equal(FailureCode(Check(0 - code)), 0 - code, "a negative code is an error that keeps its value");
    }
    Assert.Equal(FailureCode(Check(-1000)), -1000, "an unlisted code is Unknown(code)");
    Assert.LGTM(Check(0), "VK_SUCCESS");
    Assert.LGTM(Check(2), "VK_TIMEOUT is a status, not a failure");
}

[[fact]]
void FlagWordsMatchTheVulkanBits()
{
    Assert.True(StorageTransfer().raw == 34, "STORAGE (0x20) | TRANSFER_DST (0x2)");
    Assert.True(HostVisible().raw == 6, "HOST_VISIBLE (0x2) | HOST_COHERENT (0x4)");
}

int LiveWhileHeld(ref const Context context)
{
    owned Buffer buffer = CreateBuffer(ref const context, 256, StorageTransfer(), HostVisible())!;
    return ConceptVkTestLiveBuffers();
}

void Consume(owned Buffer buffer)
{
}

[[fact]]
void DroppingABufferDestroysItOnce()
{
    owned Context context = CreateComputeContext()!;
    Assert.Equal(LiveWhileHeld(ref const context), 1, "the buffer is live while owned");
    Assert.Equal(ConceptVkTestLiveBuffers(), 0, "leaving scope destroyed it");
    owned Buffer moved = CreateBuffer(ref const context, 64, StorageTransfer(), HostVisible())!;
    Consume(move moved);
    Assert.Equal(ConceptVkTestLiveBuffers(), 0, "moving hands destruction to the new owner");
    Assert.Equal(ConceptVkTestDoubleDestroys(), 0, "nothing was destroyed twice");
}

[[fact]]
void FailedCreationOwnsNothing()
{
    owned Context context = CreateComputeContext()!;
    BufferUsage none = BufferUsage{0};
    Assert.Equal(FailureCode(Discarded(CreateBuffer(ref const context, 64, none, HostVisible()))), -3, "no usage is VK_ERROR_INITIALIZATION_FAILED");
    Assert.Equal(ConceptVkTestLiveBuffers(), 0, "a failed creation leaves nothing live");
}

int RunAndCount(ref const Context context)
{
    owned ComputePipeline pipeline = CreateComputePipeline(ref const context, "kernels/double.spv", 2)!;
    owned Buffer input = CreateBuffer(ref const context, 16, StorageTransfer(), HostVisible())!;
    owned Buffer output = CreateBuffer(ref const context, 16, StorageTransfer(), HostVisible())!;
    WriteInt(ref const input, 2, 21)!;
    BindStorage(ref const pipeline, 0, ref const input);
    BindStorage(ref const pipeline, 1, ref const output);
    owned Submission work = Dispatch(ref const context, ref const pipeline, 1)!;
    Wait(move work)!;
    return ReadInt(ref const output, 2)! * 10 + ConceptVkTestPendingSubmissions();
}

[[fact]]
void ADispatchIsWaitedAndEverythingIsReleased()
{
    owned Context context = CreateComputeContext()!;
    Assert.Equal(RunAndCount(ref const context), 420, "the test device ran double.spv; nothing is pending");
    Assert.Equal(ConceptVkTestLivePipelines() + ConceptVkTestLiveBuffers(), 0, "pipeline and buffers were released");
}

int DropWithoutWaiting(ref const Context context)
{
    owned ComputePipeline pipeline = CreateComputePipeline(ref const context, "kernels/double.spv", 2)!;
    owned Buffer input = CreateBuffer(ref const context, 16, StorageTransfer(), HostVisible())!;
    owned Buffer output = CreateBuffer(ref const context, 16, StorageTransfer(), HostVisible())!;
    BindStorage(ref const pipeline, 0, ref const input);
    BindStorage(ref const pipeline, 1, ref const output);
    owned Submission work = Dispatch(ref const context, ref const pipeline, 1)!;
    return ConceptVkTestPendingSubmissions();
}

[[fact]]
void AnUnwaitedSubmissionIsWaitedWhenDropped()
{
    owned Context context = CreateComputeContext()!;
    Assert.Equal(DropWithoutWaiting(ref const context), 1, "in flight inside the function");
    Assert.Equal(ConceptVkTestPendingSubmissions(), 0, "Drop waited for it");
}
