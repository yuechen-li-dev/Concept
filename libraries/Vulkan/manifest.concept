module Vulkan.Manifest;
profile Core;

// The package manifest types are spelled locally (matching
// Standard.Build.Metadata) because the native project loader reads this file
// without module imports.
record struct Version { int major; int minor; int patch; };
enum PackageKind { Library, Executable, Tool, }
record struct Dependency { string name; };
record struct PackageManifest
{
    string name;
    string author;
    Version version;
    PackageKind kind;
    Dependency<array>[1] dependencies;
    int dependencyCount;
};

comptime PackageManifest Manifest = PackageManifest{
    "Vulkan",
    "Concept",
    Version{0, 2, 0},
    PackageKind::Library,
    [Dependency{""}],
    0
};

record struct NativeTarget
{
    string name;
    NativeLanguage language;
    NativeStandard standard;
    NativeOutputKind kind;
    string output;
    string<array>[1] sources;
    string<array>[1] includes;
    NativeDefine<array>[1] defines;
    string<array>[1] linkInputs;
};

enum NativeLanguage { C, Cpp, }
enum NativeStandard { C11, C17, Cpp17, Cpp20, Cpp23, }
enum NativeOutputKind { Executable, StaticLibrary, }
enum NativeToolchain { Clang, ClangCL, MSVC, GCC, }

record struct NativeDefine { string name; string value; bool hasValue; };
record struct NativeAbiClaim
{
    string header;
    string typeName;
    string companion;
    int size;
    int alignment;
    string<array>[8] fields;
    int<array>[8] offsets;
};
record struct NativeVersion { int major; int minor; int patch; }
record struct NativeProjectManifest
{
    string name;
    string author;
    NativeVersion version;
    NativeToolchain toolchain;
    string<array>[2] sourceRoots;
    NativeTarget<array>[1] targets;
    string<array>[1] companions;
    string<array>[1] tests;
    NativeAbiClaim<array>[9] abi;
};

// Package tests link the GPU-free test device. A real loader-backed
// implementation of native/concept_vulkan.h replaces it on a machine with a
// Vulkan SDK.
comptime NativeProjectManifest Native = NativeProjectManifest{
    "Vulkan", "Concept", NativeVersion{0, 2, 0}, NativeToolchain::GCC,
    ["native", "concept"],
    [NativeTarget{
        "vulkan_test_device", NativeLanguage::C, NativeStandard::C11,
        NativeOutputKind::StaticLibrary, ".native-build/libvulkan_test_device.a",
        ["native/test_device.c"], ["native"],
        [NativeDefine{"CONCEPT_VULKAN_TEST_DEVICE", "1", true}], [""]
    }],
    ["concept/Vulkan.concept"], ["tests/vulkan.concept_test"],
    // Claims share one array width; unused trailing slots are "".
    [NativeAbiClaim{
        "native/concept_vulkan.h", "ContextCreation", "concept/Vulkan.concept",
        56, 8, ["code", "queueFamily", "instance", "physical", "device", "queue", "commands", "cache"], [0, 4, 8, 16, 24, 32, 40, 48]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "DeviceFacts", "concept/Vulkan.concept",
        288, 8, ["apiVersion", "deviceType", "subgroupSize", "maxWorkgroupInvocations", "timestampValidBits", "timestampPeriod", "maxStorageBufferRange", "name"], [0, 4, 8, 12, 16, 20, 24, 32]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "BufferCreation", "concept/Vulkan.concept",
        24, 8, ["code", "hostVisible", "buffer", "memory", "", "", "", ""], [0, 4, 8, 16, 0, 0, 0, 0]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "BindingSlot", "concept/Vulkan.concept",
        8, 4, ["binding", "kind", "", "", "", "", "", ""], [0, 4, 0, 0, 0, 0, 0, 0]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "PipelineCreation", "concept/Vulkan.concept",
        40, 8, ["code", "pushBytes", "shader", "setLayout", "layout", "pipeline", "", ""], [0, 4, 8, 16, 24, 32, 0, 0]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "RecordingBegin", "concept/Vulkan.concept",
        24, 8, ["code", "timestamps", "commands", "queries", "", "", "", ""], [0, 4, 8, 16, 0, 0, 0, 0]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "DescriptorWrite", "concept/Vulkan.concept",
        32, 8, ["buffer", "offset", "range", "binding", "kind", "", "", ""], [0, 8, 16, 24, 28, 0, 0, 0]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "SubmissionRecord", "concept/Vulkan.concept",
        16, 8, ["code", "reserved", "fence", "", "", "", "", ""], [0, 4, 8, 0, 0, 0, 0, 0]
    }, NativeAbiClaim{
        "native/concept_vulkan.h", "Elapsed", "concept/Vulkan.concept",
        16, 8, ["code", "reserved", "nanoseconds", "", "", "", "", ""], [0, 4, 8, 0, 0, 0, 0, 0]
    }]
};
