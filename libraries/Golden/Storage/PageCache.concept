module Golden.Storage.PageCache;
profile Core;
import Standard.Collection.Stores;

enum CacheError
{
    Missing,
    Full,
    DirtyPage,
    NotPinned
}

record struct PageHeader
{
    int filePage;
    int version;
}

struct Page
{
    PageHeader header;
    uint8[256] bytes;
    bool dirty;
    int pinCount;
}

struct PageCache
{
    GenerationalStore<Page, 8> pages;
    int reads;
    int writes;
}

PageCache NewCache()
{
    return PageCache{MakeGenerationalStore<Page, 8>(), 0, 0};
}

Result<GenerationalId<Page>, StoreError> Install(ref PageCache cache, int filePage)
{
    Page page = Page{PageHeader{filePage, 1}, [0 ... 256], false, 0};
    return Insert<Page, 8>(ref cache.pages, move page);
}
requires compiler.InvalidatesBorrows(Install, cache);

Result<void, CacheError> WriteByte(ref PageCache cache, GenerationalId<Page> id, int offset, uint8 value)
{
    if (offset < 0 or offset >= 256)
    {
        return Result::Error(CacheError::Missing);
    }
    Result<ref Page, StoreError> found = GenerationalGetMutable<Page, 8>(ref cache.pages, id);
    match (found)
    {
        Result::Ok(page) => {
            page.bytes[offset] = value;
            page.dirty = true;
            cache.writes++;
            return Result::Ok();
        }
        Result::Error(error) => { return Result::Error(CacheError::Missing); }
    }
}

Result<uint8, CacheError> ReadByte(ref PageCache cache, GenerationalId<Page> id, int offset)
{
    if (offset < 0 or offset >= 256)
    {
        return Result::Error(CacheError::Missing);
    }
    Result<ref const Page, StoreError> found = GenerationalGet<Page, 8>(ref const cache.pages, id);
    match (found)
    {
        Result::Ok(page) => {
            cache.reads++;
            return Result::Ok(page.bytes[offset]);
        }
        Result::Error(error) => { return Result::Error(CacheError::Missing); }
    }
}

Result<void, CacheError> EvictClean(ref PageCache cache, GenerationalId<Page> id)
{
    {
        Result<ref const Page, StoreError> found = GenerationalGet<Page, 8>(ref const cache.pages, id);
        match (found)
        {
            Result::Ok(page) => {
                if (page.dirty or page.pinCount > 0)
                {
                    return Result::Error(CacheError::DirtyPage);
                }
            }
            Result::Error(error) => { return Result::Error(CacheError::Missing); }
        }
    }
    Remove<Page, 8>(ref cache.pages, id)!;
    return Result::Ok();
}
requires compiler.InvalidatesBorrows(EvictClean, cache);

Result<void, CacheError> Pin(ref PageCache cache, GenerationalId<Page> id)
{
    Result<ref Page, StoreError> found = GenerationalGetMutable<Page, 8>(ref cache.pages, id);
    match (found)
    {
        Result::Ok(page) => {
            page.pinCount++;
            return Result::Ok();
        }
        Result::Error(error) => { return Result::Error(CacheError::Missing); }
    }
}

Result<void, CacheError> Unpin(ref PageCache cache, GenerationalId<Page> id)
{
    Result<ref Page, StoreError> found = GenerationalGetMutable<Page, 8>(ref cache.pages, id);
    match (found)
    {
        Result::Ok(page) => {
            if (page.pinCount == 0) { return Result::Error(CacheError::NotPinned); }
            page.pinCount--;
            return Result::Ok();
        }
        Result::Error(error) => { return Result::Error(CacheError::Missing); }
    }
}

int ActiveSlots(ref const PageCache cache)
{
    int count = 0;
    for (i in 0..cache.pages.next)
    {
        GenerationalId<Page> id = GenerationalId<Page>{i, cache.pages.generation[i]};
        if (Contains<Page, 8>(ref const cache.pages, id)) { count++; }
    }
    return count;
}
