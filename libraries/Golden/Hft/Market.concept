module Golden.Hft.Market;
profile Core;
import Standard.Synchronization.Atomic;
import Standard.Machine.AMD64;

comptime int QueueCapacity = 64;
comptime int SequenceSpan = 128;

record struct MarketEvent
{
    int symbol;
    int priceTicks;
    uint64 timestamp;
}

enum MarketError
{
    Empty,
    InvalidPrice
}

struct SignalState
{
    int lastPrice;
    int accepted;
    int rejected;
    int lastDelta;
}

struct MarketQueue
{
    MarketEvent[QueueCapacity] slots;
    AtomicInt head;
    AtomicInt tail;
}

record struct FeedContext { }
record struct SignalContext { }

MarketEvent StampEvent(int symbol, int priceTicks)
{
    return MarketEvent{symbol, priceTicks, ReadTimestamp()};
}

int NextSequence(int sequence)
{
    return(sequence + 1) % SequenceSpan;
}

int QueueDistance(int head, int tail)
{
    return(tail - head + SequenceSpan) % SequenceSpan;
}

[[execution_context(FeedContext)]]
[[semantic_access("Publish", queue)]]
bool Publish(ref MarketQueue queue, MarketEvent event)
{
    int tail = LoadAtomic(ref queue.tail, MemoryOrder::Relaxed);
    int head = LoadAtomic(ref queue.head, MemoryOrder::Acquire);
    if (QueueDistance(head, tail) == QueueCapacity)
    { return false; }
    queue.slots[tail % QueueCapacity] = event;
    StoreAtomic(ref queue.tail, NextSequence(tail), MemoryOrder::Release);
    return true;
}

[[execution_context(SignalContext)]]
[[semantic_access("Consume", queue)]]
Option<MarketEvent> Consume(ref MarketQueue queue)
{
    int head = LoadAtomic(ref queue.head, MemoryOrder::Relaxed);
    int tail = LoadAtomic(ref queue.tail, MemoryOrder::Acquire);
    if (head == tail)
    { return Option::None; }
    MarketEvent event = queue.slots[head % QueueCapacity];
    StoreAtomic(ref queue.head, NextSequence(head), MemoryOrder::Release);
    return Option::Some(event);
}

[[execution_context(SignalContext)]]
Result<MarketEvent, MarketError> NextValid(ref MarketQueue queue)
{
    Option<MarketEvent> next = Consume(ref queue);
    match (next)
    {
        Option::None => { return Result::Error(MarketError::Empty); }
        Option::Some(event) => {
            if (event.priceTicks <= 0)
            { return Result::Error(MarketError::InvalidPrice); }
            return Result::Ok(event);
        }
    }
}

void UpdateSignal(ref SignalState state, MarketEvent event)
{
    if (state.accepted > 0)
    {
        state.lastDelta = event.priceTicks - state.lastPrice;
    }
    state.lastPrice = event.priceTicks;
    state.accepted++;
}

[[execution_context(SignalContext)]]
int DrainSignal(ref MarketQueue queue, ref SignalState state, int budget)
{
    int seen = 0;
    bool active = true;
    for (i in 0 .. budget)
    {
        if (active)
        {
            Result<MarketEvent, MarketError> next = NextValid(ref queue);
            match (next)
            {
                Result::Ok(event) => {
                    UpdateSignal(ref state, event);
                    seen++;
                }
                Result::Error(error) => {
                    if (error == MarketError::Empty) {
                        active = false;
                    }
                    else {
                        state.rejected++;
                    }
                }
            }
        }
    }
    return seen;
}

[[execution_context(SignalContext)]]
int Drain(ref MarketQueue queue, int budget)
{
    int count = 0;
    bool found = true;
    for (i in 0 .. budget)
    {
        if (found)
        {
            Option<MarketEvent> event = Consume(ref queue);
            match (event)
            {
                Option::None => {
                    found = false;
                }
                Option::Some(value) => {
                    count++;
                }
            }
        }
    }
    return count;
}
