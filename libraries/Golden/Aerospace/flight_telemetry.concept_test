module Golden.Aerospace.Tests;
profile Core;
import Golden.Aerospace.FlightTelemetry;

[[fact]]
void CommercialFlightTelemetryTransitionsAreDeterministic()
{
    FlightSample empty = FlightSample{0.0, 0.0, false};
    FlightController controller = FlightController{FlightMode::Preflight, [empty ... 16], 0, 0, 0};
    Assert.LGTM(AcceptNative(ref controller, NativeSample{120.0, 20.0, 1}), "valid climb sample");
    Assert.True(controller.mode == FlightMode::Climb, "positive vertical speed starts climb");
    Assert.LGTM(AcceptNative(ref controller, NativeSample{11000.0, 10.0, 1}), "cruise altitude sample");
    Assert.True(controller.mode == FlightMode::Cruise, "climb enters cruise envelope");
    Assert.LGTM(AcceptNative(ref controller, NativeSample{10500.0, -5.0, 1}), "descent sample");
    Assert.True(controller.mode == FlightMode::Descent, "negative vertical speed starts descent");
    Assert.Equals(CountValid(ref const controller), 3, "three stored samples remain valid");
    Assert.LGTM(Latest(ref const controller), "latest accepted sample is available");
    Assert.True(MayUseTelemetryForGuidance(ref const controller), "valid descent sample remains usable");
    Assert.Error(AcceptNative(ref controller, NativeSample{10000.0, 0.0, 0}), "invalid sensor status is explicit");
    Assert.True(controller.mode == FlightMode::Fault, "invalid sample enters fault state");
    Assert.False(MayUseTelemetryForGuidance(ref const controller), "fault state prevents telemetry guidance");
    Assert.Equals(controller.rejected, 1, "rejection is counted once");
}

[[fact]]
void TelemetryControlPathUsesFixedStorage()
{
    Assert.Concept<NoAllocation>(Accept, "control transition uses a fixed history buffer");
    Assert.Concept<NoAllocation>(AcceptNative, "native scalar interpretation uses no heap");
    Assert.Concept<NoAllocation>(CountValid, "bounded history scan uses no heap");
    Assert.Concept<NoAllocation>(Latest, "latest sample is a fixed-buffer value");
}

[[fact]]
void EmptyControllerHasNoGuidanceSample()
{
    FlightSample empty = FlightSample{0.0, 0.0, false};
    FlightController controller = FlightController{FlightMode::Preflight, [empty ... 16], 0, 0, 0};
    Assert.Error(Latest(ref const controller), "history has no sample");
    Assert.False(MayUseTelemetryForGuidance(ref const controller), "empty history cannot guide");
}
