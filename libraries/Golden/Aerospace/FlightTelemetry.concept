module Golden.Aerospace.FlightTelemetry;
profile Core;

comptime int HistoryCapacity = 16;

enum FlightMode
{
    Preflight,
    Climb,
    Cruise,
    Descent,
    Fault
}

enum TelemetryError
{
    SensorInvalid,
    CapacityExceeded,
    OutOfEnvelope
}

[[repr(C)]] record struct NativeSample
{
    float altitudeMeters;
    float verticalMetersPerSecond;
    uint32 validityFlags;
}

concept CAbiValue<T> {
    requires compiler.CAbiLayout<T>();
}
requires CAbiValue<NativeSample>;

record struct FlightSample
{
    float<m> altitude;
    float<m / s> verticalSpeed;
    bool valid;
}

struct FlightController
{
    FlightMode mode;
    FlightSample[HistoryCapacity] history;
    int historyCount;
    int historyNext;
    int accepted;
    int rejected;
}

FlightSample Interpret(NativeSample native)
{
    bool valid =(native.validityFlags & 1) != 0;
    return FlightSample {
        interpret native.altitudeMeters as float<m>,
        interpret native.verticalMetersPerSecond as float<m / s>,
        valid
    };
}

Result<void, TelemetryError> Accept(ref FlightController controller, FlightSample sample)
{
    if (not sample.valid)
    {
        controller.rejected++;
        controller.mode = FlightMode::Fault;
        return Result::Error(TelemetryError::SensorInvalid);
    }
    if (sample.altitude < 0.0 or sample.altitude > 200000.0)
    {
        controller.rejected++;
        controller.mode = FlightMode::Fault;
        return Result::Error(TelemetryError::OutOfEnvelope);
    }
    controller.history[controller.historyNext] = sample;
    controller.historyNext =(controller.historyNext + 1) % HistoryCapacity;
    if (controller.historyCount < HistoryCapacity) {
        controller.historyCount++;
    }
    controller.accepted++;

    match (controller.mode)
    {
        FlightMode::Preflight => {
            if (sample.verticalSpeed > 0.0) {
                controller.mode = FlightMode::Climb;
            }
        }
        FlightMode::Climb => {
            if (sample.altitude >= 10000.0) {
                controller.mode = FlightMode::Cruise;
            }
        }
        FlightMode::Cruise => {
            if (sample.verticalSpeed < 0.0) {
                controller.mode = FlightMode::Descent;
            }
        }
        FlightMode::Descent => { }
        FlightMode::Fault => { }
    }
    return Result::Ok();
}

Result<void, TelemetryError> AcceptNative(ref FlightController controller, NativeSample native)
{
    return Accept(ref controller, Interpret(native));
}

int CountValid(ref const FlightController controller)
{
    int count = 0;
    for (i in 0 .. controller.historyCount)
    {
        if (controller.history[i].valid) {
            count++;
        }
    }
    return count;
}

Result<FlightSample, TelemetryError> Latest(ref const FlightController controller)
{
    if (controller.historyCount == 0)
    { return Result::Error(TelemetryError::SensorInvalid); }
    return Result::Ok(controller.history[(controller.historyNext + HistoryCapacity - 1) % HistoryCapacity]);
}

bool MayUseTelemetryForGuidance(ref const FlightController controller)
{
    if (controller.mode == FlightMode::Fault or controller.historyCount == 0)
    { return false; }
    Result<FlightSample, TelemetryError> sample = Latest(ref const controller);
    return match (sample)
    {
        Result::Ok(value) => value.valid,
        Result::Error(error) => false,
    };
}
