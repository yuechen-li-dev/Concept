module Golden.Game.Tests;
profile Core;
import Golden.Game.Agents;

[[fact]]
void AgentsAdvanceThroughStableDenseIds()
{
    World world = World {
        DenseStore<Agent, 64>{Uninitialized()}, 0
    };
    Id<Agent> first = Spawn(ref world, 0, 0)!;
    Id<Agent> second = Spawn(ref world, 5, 0)!;
    {
        ref Agent seeker = DenseGetMutable<Agent, 64>(ref world.agents, first)!;
        seeker.intent = Intent::Seek(3, 2);
    }
    {
        ref Agent striker = DenseGetMutable<Agent, 64>(ref world.agents, second)!;
        striker.intent = Intent::Strike(second);
    }
    Tick(ref world);
    Tick(ref world);
    {
        ref const Agent seeker = DenseGet<Agent, 64>(ref const world.agents, first)!;
        Assert.Equals(seeker.x, 2, "seeker advances one cell per tick");
        Assert.Equals(seeker.y, 2, "seeker reaches the target row");
    }
    {
        ref const Agent striker = DenseGet<Agent, 64>(ref const world.agents, second)!;
        Assert.Equals(striker.health, 80, "typed self-target resolves twice");
    }
    Assert.Equals(world.tick, 2, "world clock advances deterministically");
    Assert.Equals(CountSeeking(ref const world), 1, "one agent retains a seek intent");
    Assert.Equals(ApplyDamage(ref world, first, 200)!, 0, "damage clamps health to zero");
}

[[fact]]
void SeekMovesBothWaysAndMutualStrikesLand()
{
    World world = World{MakeDenseStore<Agent, 64>(), 0};
    Id<Agent> left = Spawn(ref world, 0, 0)!;
    Id<Agent> right = Spawn(ref world, 5, 5)!;
    {
        ref Agent a = DenseGetMutable<Agent, 64>(ref world.agents, left)!;
        a.intent = Intent::Seek(2, 1);
    }
    {
        ref Agent b = DenseGetMutable<Agent, 64>(ref world.agents, right)!;
        b.intent = Intent::Seek(3, 4);
    }
    for (i in 0 .. 4) {
        Tick(ref world);
    }
    {
        ref const Agent a = DenseGet<Agent, 64>(ref const world.agents, left)!;
        Assert.Equals(a.x, 2, "right then stop");
        Assert.Equals(a.y, 1, "up then stop");
    }
    {
        ref const Agent b = DenseGet<Agent, 64>(ref const world.agents, right)!;
        Assert.Equals(b.x, 3, "left then stop");
        Assert.Equals(b.y, 4, "down then stop");
    }
    {
        ref Agent a = DenseGetMutable<Agent, 64>(ref world.agents, left)!;
        a.intent = Intent::Strike(right);
    }
    {
        ref Agent b = DenseGetMutable<Agent, 64>(ref world.agents, right)!;
        b.intent = Intent::Strike(left);
    }
    Tick(ref world);
    Assert.Equals(DenseGet<Agent, 64>(ref const world.agents, left)!.health, 90, "first attacker hit");
    Assert.Equals(DenseGet<Agent, 64>(ref const world.agents, right)!.health, 90, "second attacker hit");
}

[[fact]]
void HotAgentTraversalHasNoAllocation()
{
    Assert.Concept<NoAllocation>(Tick, "stable-ID traversal uses inline storage");
    Assert.Concept<NoAllocation>(Spawn, "bounded append uses inline storage");
    Assert.Concept<NoAllocation>(CountSeeking, "intent census is a dense traversal");
}

[[fact]]
void PatrolYieldRequiresExplicitSteps()
{
    instance Patrol patrol(0, 3);
    Step(patrol, Walk);
    Assert.Equals(patrol.state.steps, 1, "first step advances once");
    Step(patrol, Walk);
    Step(patrol, Walk);
    Assert.Equals(patrol.state.steps, 3, "yield preserves explicit state");
    Step(patrol, Walk);
    Assert.Equals(patrol.state.steps, 3, "transition ends the walk");
}
