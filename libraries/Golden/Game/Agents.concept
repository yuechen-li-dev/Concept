module Golden.Game.Agents;
profile Core;
import Standard.Collection.Stores;

comptime int MaxAgents = 64;
comptime int StrikeDamage = 10;

enum Intent
{
    Idle,
    Seek(int x, int y),
    Strike(Id<Agent> target)
}

struct Agent
{
    int x;
    int y;
    int health;
    Intent intent;
}

struct World
{
    DenseStore<Agent, 64> agents;
    int tick;
}

Result<Id<Agent>, StoreError> Spawn(ref World world, int x, int y)
{
    Agent agent = Agent{x, y, 100, Intent::Idle};
    return Append<Agent, 64>(ref world.agents, agent);
}
requires compiler.InvalidatesBorrows(Spawn, world);

int StepToward(int from, int to)
{
    if (from < to) { return 1; }
    if (from > to) { return - 1; }
    return 0;
}

void Tick(ref World world)
{
    int population = Count<Agent, 64>(ref const world.agents);
    int[MaxAgents] incoming =[0 ... MaxAgents];
    for (i in 0 .. population)
    {
        Id<Agent> id = IdAt<Agent, 64>(ref const world.agents, i)!;
        ref Agent agent = DenseGetMutable<Agent, 64>(ref world.agents, id)!;
        if (agent.health > 0) {
            match (agent.intent)
            {
                Intent::Idle => { }
                Intent::Seek(x, y) => {
                    agent.x += StepToward(agent.x, x);
                    agent.y += StepToward(agent.y, y);
                }
                Intent::Strike(target) => {
                    if (target.index >= 0 and target.index < population) {
                        incoming[target.index] += StrikeDamage;
                    }
                }
            }
        }
    }
    for (i in 0 .. population)
    {
        Id<Agent> id = IdAt<Agent, 64>(ref const world.agents, i)!;
        ref Agent agent = DenseGetMutable<Agent, 64>(ref world.agents, id)!;
        if (incoming[i] >= agent.health) {
            agent.health = 0;
        } else {
            agent.health -= incoming[i];
        }
    }
    world.tick++;
}

Result<int, StoreError> ApplyDamage(ref World world, Id<Agent> target, int amount)
{
    ref Agent agent = DenseGetMutable<Agent, 64>(ref world.agents, target) ?;
    if (amount > 0)
    {
        agent.health -= amount;
        if (agent.health < 0) {
            agent.health = 0;
        }
    }
    return Result::Ok(agent.health);
}

int CountSeeking(ref const World world)
{
    int count = 0;
    for (i in 0 .. Count<Agent, 64>(ref const world.agents))
    {
        Id<Agent> id = IdAt<Agent, 64>(ref const world.agents, i)!;
        ref const Agent agent = DenseGet<Agent, 64>(ref const world.agents, id)!;
        match (agent.intent)
        {
            Intent::Idle => { }
            Intent::Seek(x, y) => {
                count++;
            }
            Intent::Strike(target) => { }
        }
    }
    return count;
}

automata Patrol
with state
{
    int steps;
    int limit;
}
{
    machine Walk
    {
        state Moving
        {
            if (steps >= limit)
            {
                transition Finished;
            }
            steps++;
            yield;
        }

        state Finished
        {
        }
    }
}
