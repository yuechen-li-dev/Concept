module Golden.Differentiators.Hpc.Dot;
profile Core;

concept Floating<T>
{
    requires compiler.Floating<T>();
    requires T Multiply(T left, T right);
    requires T Add(T left, T right);
}

float Multiply(float left, float right) {
    return left * right;
}
double Multiply(double left, double right) {
    return left * right;
}
float Add(float left, float right) {
    return left + right;
}
double Add(double left, double right) {
    return left + right;
}

// A four-lane dot product is small enough that the intended accumulation order
// is visible, and large enough to test a fixed hot-path reduction.
template <typename T>
requires Floating<T>
T Dot4(ReadOnlySpan<T> left, ReadOnlySpan<T> right)
{
    // Scalar storage is a compile-time fact of each closed specialization.
    if (SizeOf<T>() == 4)
    {
        T first = Add(Multiply(left[0], right[0]), Multiply(left[1], right[1]));
        T second = Add(Multiply(left[2], right[2]), Multiply(left[3], right[3]));
        return Add(first, second);
    }
    else
    {
        T total = Multiply(left[0], right[0]);
        for (i in 1 .. 4) {
            total = Add(total, Multiply(left[i], right[i]));
        }
        return total;
    }
}

float DotFloat()
{
    float[4] left =[1.0, 2.0, 3.0, 4.0];
    float[4] right =[4.0, 3.0, 2.0, 1.0];
    float result = Dot4<float>(ReadOnlySpan(left), ReadOnlySpan(right));
    return result;
}

double DotDouble()
{
    double[4] left =[1.0 as double, 2.0 as double, 3.0 as double, 4.0 as double];
    double[4] right =[4.0 as double, 3.0 as double, 2.0 as double, 1.0 as double];
    double result = Dot4<double>(ReadOnlySpan(left), ReadOnlySpan(right));
    return result;
}

// A direct binary32 baseline for inspecting the specialized generated C.
float ReferenceDotFloat(ReadOnlySpan<float> left, ReadOnlySpan<float> right)
{
    float first = left[0] * right[0] + left[1] * right[1];
    float second = left[2] * right[2] + left[3] * right[3];
    return first + second;
}
