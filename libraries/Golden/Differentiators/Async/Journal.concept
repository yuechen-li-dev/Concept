module Golden.Differentiators.Async.Journal;
profile Core;

enum JournalError
{
    Missing,
    Full,
    Stalled
}

struct Request
{
    int sequence;
    int value;
}

void Drop(owned Request request) { }

async Result<int, JournalError> Fetch(int sequence)
{
    if (sequence < 0) { return Result::Error(JournalError::Missing); }
    return Result::Ok(sequence * 2);
}

async Result<int, JournalError> Commit(int value)
{
    if (value > 100) { return Result::Error(JournalError::Full); }
    return Result::Ok(value + 1);
}

[[must_use]]
async Result<int, JournalError> Transfer(int sequence)
{
    owned Request pending = Request{sequence, 0};
    {
        ref int value = ref pending.value;
        value = 1;
    }
    int fetched = await Fetch(pending.sequence) ?;
    pending.value += fetched;
    int committed = await Commit(pending.value) ?;
    return Result::Ok(committed);
}

Result<int, JournalError> DriveWithin(int sequence, int budget)
{
    Async<Result<int, JournalError>> operation = Transfer(sequence);
    int steps = 0;
    while (not Complete(operation)) bounded(8) {
        if (steps >= budget) { return Result::Error(JournalError::Stalled); }
        Step(operation);
        steps++;
    }
    else { return Result::Error(JournalError::Stalled); }
    return Result(operation);
}

Result<int, JournalError> Drive(int sequence)
{
    return DriveWithin(sequence, 8);
}

void SendBestEffort(int sequence)
{
    // Optional journal telemetry is attempted, but its status cannot block
    // the caller's primary work. The ignored Result is explicit.
    discard Drive(sequence);
}
