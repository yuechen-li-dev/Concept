module Golden.Differentiators.Geometry.FrameTests;
profile Core;
import Golden.Differentiators.Geometry.Frame;

[[fact]]
void DimensionedDisplacementContractsThroughBasis()
{
    Assert.True(ProjectDisplacement() == (interpret -2.0 as float<m>),
                "the quarter-turn basis rotates a measured displacement");
}
