module Golden.Claude.Game.WorldOpsTests;
profile Core;
import Golden.Claude.Game.Agents;
import Golden.Claude.Game.WorldOps;
import Standard.Collection.Stores;

[[fact]]
void AFadedFootprintsHandleStaysDeadAfterItsSlotIsReused()
{
    Trails trails = NewTrails();
    GenerationalId<Footprint> old = Leave(ref trails, 3, 4, 1)!;
    Assert.LGTM(Fade(ref trails, old), "fade it");
    GenerationalId<Footprint> fresh = Leave(ref trails, 7, 8, 2)!;
    Assert.Equals(fresh.index, old.index, "the slot is reused");
    Assert.False(StillVisible(ref const trails, old), "the old handle does not see the new footprint");
    Assert.True(StillVisible(ref const trails, fresh), "the new handle does");
    Assert.Error(Fade(ref trails, old), "fading a stale handle is refused");
}

[[fact]]
void SnapshotColumnsSumOnlyTheLiveRows()
{
    World world = NewWorld();
    Id<Agent> a = Spawn(ref world, 1, 2)!;
    Id<Agent> b = Spawn(ref world, 4, 5)!;
    Assert.LGTM(Command(ref world, a, Intent::Seek(3, 2)), "a walks east");
    RunTicks(ref world, 2);
    Positions frame = Positions{[99 ...], [99 ...]};
    int rows = Snapshot(ref const world, ref frame);
    Assert.Equals(rows, 2, "two agents");
    ReadOnlySpan<int> xs = ReadOnlySpan(frame.x);
    ReadOnlySpan<int> ys = ReadOnlySpan(frame.y);
    Assert.Equals(Sum(Subspan(xs, 0, rows)), 7, "3 + 4; the 99 filler is outside the sub-span");
    Assert.Equals(Sum(Subspan(ys, 0, rows)), 7, "2 + 5");
}

[[fact]]
void WorldOpsAllocateNothing()
{
    Assert.Concept<NoAllocation>(Snapshot, "writes into the caller's table");
    Assert.Concept<NoAllocation>(Sum, "span reduction");
    Assert.Concept<NoAllocation>(RunTicks, "caller-owned budget");
}
