module Golden.Claude.Game.Agents;
profile Core;
import Standard.Collection.Stores;
import Standard.Math;

// A grid skirmish. Each tick has two phases:
//   1. decide: every living agent moves or declares a strike;
//   2. resolve: declared damage is applied all at once.
// Resolving after deciding makes the outcome independent of store order (two
// agents that strike each other both land their blow) and means no agent is
// mutated while another one is borrowed.

comptime int MaxAgents = 64;
comptime int StrikeDamage = 10;
comptime int FullHealth = 100;

enum Intent
{
    Idle,
    Seek(int x, int y),
    Strike(Id<Agent> target)
}

struct Agent
{
    int x;
    int y;
    int health;
    Intent intent;
}

struct World
{
    DenseStore<Agent, 64> agents;
    int tick;
}

World NewWorld()
{
    return World{MakeDenseStore<Agent, 64>(), 0};
}

Result<Id<Agent>, StoreError> Spawn(ref World world, int x, int y)
{
    return Append<Agent, 64>(ref world.agents, Agent{x, y, FullHealth, Intent::Idle});
}
requires compiler.InvalidatesBorrows(Spawn, world);

Result<void, StoreError> Command(ref World world, Id<Agent> id, Intent intent)
{
    ref Agent agent = DenseGetMutable<Agent, 64>(ref world.agents, id)?;
    agent.intent = intent;
    return Result::Ok();
}

bool Alive(ref const Agent agent)
{
    return agent.health > 0;
}

// -1, 0 or +1: one grid step from `from` toward `to`.
int StepToward(int from, int to)
{
    if (from < to) { return 1; }
    if (from > to) { return -1; }
    return 0;
}

void Tick(ref World world)
{
    int population = Count<Agent, 64>(ref const world.agents);
    int[MaxAgents] incoming = [0 ... MaxAgents];

    for (i in 0..population)
    {
        ref Agent agent = DenseGetMutable<Agent, 64>(ref world.agents, IdAt<Agent, 64>(ref const world.agents, i)!)!;
        if (Alive(ref const agent))
        {
            match (agent.intent)
            {
                Intent::Idle => { }
                Intent::Seek(x, y) => {
                    agent.x += StepToward(agent.x, x);
                    agent.y += StepToward(agent.y, y);
                }
                Intent::Strike(target) => {
                    if (target.index < population)
                    {
                        incoming[target.index] += StrikeDamage;
                    }
                }
            }
        }
    }

    for (i in 0..population)
    {
        ref Agent agent = DenseGetMutable<Agent, 64>(ref world.agents, IdAt<Agent, 64>(ref const world.agents, i)!)!;
        agent.health = Max(0, agent.health - incoming[i]);
    }
    world.tick += 1;
}

int CountAlive(ref const World world)
{
    int alive = 0;
    // Index loop: a Span<Agent> is unavailable while Agent holds a payload enum.
    for (i in 0..Count<Agent, 64>(ref const world.agents))
    {
        ref const Agent agent = DenseGet<Agent, 64>(ref const world.agents, IdAt<Agent, 64>(ref const world.agents, i)!)!;
        if (Alive(ref const agent)) { alive += 1; }
    }
    return alive;
}

// A sentry that walks a fixed number of legs, one per step, then stands.
automata Sentry
with state
{
    int legsWalked;
    int legs;
}
{
    machine Watch
    {
        state Walking
        {
            if (legsWalked == legs)
            {
                transition Standing;
            }
            legsWalked += 1;
            yield;
        }

        state Standing
        {
        }
    }
}
