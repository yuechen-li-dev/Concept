module Golden.Claude.Differentiators.Async.JournalTests;
profile Core;
import Golden.Claude.Differentiators.Async.Journal;

bool FailsWith(Result<int, JournalError> result, JournalError expected)
{
    return match (result)
    {
        Result::Ok(value) => false,
        Result::Error(error) => error == expected,
    };
}

[[fact]]
void ATransferFetchesTransformsAndCommits()
{
    Assert.Equals(Run(4)!, 10, "fetch 8, transform to 9, commit receipt 10");
}

[[fact]]
void AMissingRecordFailsAtFetch()
{
    Assert.True(FailsWith(Run(-1), JournalError::Missing), "nothing to fetch");
}

[[fact]]
void AFullJournalFailsAtCommit()
{
    Assert.True(FailsWith(Run(50), JournalError::Full), "fetch succeeds, commit refuses 101");
}

[[fact]]
void TooSmallABudgetStallsInsteadOfPanicking()
{
    Assert.True(FailsWith(RunWithin(4, 1), JournalError::Stalled), "one step cannot finish two awaits");
    Assert.Equals(RunWithin(4, StepBudget)!, 10, "the full budget can");
}

[[fact]]
void TelemetryIgnoresFailureOnPurpose()
{
    RecordTelemetry(-1);
    Assert.True(true, "a failed best-effort send does not propagate");
}

[[fact]]
void TheTaskFrameIsInline()
{
    Assert.Concept<NoAllocation>(Transfer, "owned request in the async frame");
    Assert.Concept<NoAllocation>(RunWithin, "caller-driven stepping");
}
