module Standard.Math;
profile Core;

// C11 binary32 and binary64 primitives; transcendental results follow target libm.
extern "C" float fabsf(float value);
extern "C" float sqrtf(float value);
extern "C" float powf(float base, float exponent);
extern "C" float expf(float value);
extern "C" float logf(float value);
extern "C" float log2f(float value);
extern "C" float log10f(float value);
extern "C" float floorf(float value);
extern "C" float ceilf(float value);
extern "C" float roundf(float value);
extern "C" float truncf(float value);
extern "C" float sinf(float value);
extern "C" float cosf(float value);
extern "C" float tanf(float value);
extern "C" float asinf(float value);
extern "C" float acosf(float value);
extern "C" float atanf(float value);
extern "C" float atan2f(float y, float x);

float Abs(float value) { return fabsf(value); }
float Min(float left, float right) { return if (left < right) left else right; }
float Max(float left, float right) { return if (left > right) left else right; }
float Clamp(float value, float lower, float upper) { return Min(Max(value, lower), upper); }

concept LessComparable<T> { requires bool operator<(T left, T right); }
concept GreaterComparable<T> { requires bool operator>(T left, T right); }
concept MagnitudeOrder<T>
{
    requires LessComparable<T>;
    requires bool operator==(T left, T right);
    requires T operator-(T value);
}

template <typename T> requires LessComparable<T>
T Min(T left, T right) { return if (left < right) left else right; }
template <typename T> requires GreaterComparable<T>
T Max(T left, T right) { return if (left > right) left else right; }
template <typename T> requires MagnitudeOrder<T>
T Abs(T value)
{
    T zero = 0.0;
    if (value == zero) { return zero; }
    if (value < zero) { return -value; }
    return value;
}

int Abs(int value) { return if (value < 0) 0 - value else value; }
int Min(int left, int right) { return if (left < right) left else right; }
int Max(int left, int right) { return if (left > right) left else right; }
int Clamp(int value, int lower, int upper) { return Min(Max(value, lower), upper); }

float Sqrt(float value) { return sqrtf(value); }
float Pow(float base, float exponent) { return powf(base, exponent); }
float Exp(float value) { return expf(value); }
float Log(float value) { return logf(value); }
float Log2(float value) { return log2f(value); }
float Log10(float value) { return log10f(value); }
float Floor(float value) { return floorf(value); }
float Ceil(float value) { return ceilf(value); }
float Round(float value) { return roundf(value); }
float Trunc(float value) { return truncf(value); }
float Sin(float value) { return sinf(value); }
float Cos(float value) { return cosf(value); }
float Tan(float value) { return tanf(value); }
float Asin(float value) { return asinf(value); }
float Acos(float value) { return acosf(value); }
float Atan(float value) { return atanf(value); }
float Atan2(float y, float x) { return atan2f(y, x); }

bool IsNaN(float value) { return value != value; }
bool IsInf(float value) { return value != 0.0 and value + value == value; }
bool IsFinite(float value) { return not IsNaN(value) and not IsInf(value); }

// Binary64 overloads preserve precision through the native boundary.
extern "C" double fabs(double value);
extern "C" double sqrt(double value);
extern "C" double pow(double base, double exponent);
extern "C" double exp(double value);
extern "C" double log(double value);
extern "C" double log2(double value);
extern "C" double log10(double value);
extern "C" double floor(double value);
extern "C" double ceil(double value);
extern "C" double round(double value);
extern "C" double trunc(double value);
extern "C" double sin(double value);
extern "C" double cos(double value);
extern "C" double tan(double value);
extern "C" double asin(double value);
extern "C" double acos(double value);
extern "C" double atan(double value);
extern "C" double atan2(double y, double x);
double Abs(double value) { return fabs(value); }
double Min(double left, double right) { return if (left < right) left else right; }
double Max(double left, double right) { return if (left > right) left else right; }
double Clamp(double value, double lower, double upper) { return Min(Max(value, lower), upper); }
double Sqrt(double value) { return sqrt(value); }
double Pow(double base, double exponent) { return pow(base, exponent); }
double Exp(double value) { return exp(value); }
double Log(double value) { return log(value); }
double Log2(double value) { return log2(value); }
double Log10(double value) { return log10(value); }
double Floor(double value) { return floor(value); }
double Ceil(double value) { return ceil(value); }
double Round(double value) { return round(value); }
double Trunc(double value) { return trunc(value); }
double Sin(double value) { return sin(value); }
double Cos(double value) { return cos(value); }
double Tan(double value) { return tan(value); }
double Asin(double value) { return asin(value); }
double Acos(double value) { return acos(value); }
double Atan(double value) { return atan(value); }
double Atan2(double y, double x) { return atan2(y, x); }
bool IsNaN(double value) { return value != value; }
bool IsInf(double value) { return value != 0.0 and value + value == value; }
bool IsFinite(double value) { return not IsNaN(value) and not IsInf(value); }
