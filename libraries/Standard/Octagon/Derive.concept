module Standard.Octagon.Derive;
profile Core;
import Standard.Octagon.Core;

// R7h1's bounded integer-record derivation uses the ordinary typed byte reader
// and writer. Other field types require their own ordinary codec operations.
generator <typename T> DeriveOctagonRead
Result<T, OctagonError> ReadOctagon(ref OctagonReader reader)
{
    BeginRecord(ref reader, TypeName<T>())!;
    T value = T{foreach (FieldInfo field in Fields<T>()) {
        field = ReadNamedInt(ref reader, NameOf<field>())!;
    }};
    EndRecord(ref reader)!;
    return Result::Ok(move value);
}

generator <typename T> DeriveOctagonWrite
Result<void, OctagonError> WriteOctagon(ref const T value, ref OctagonWriter writer)
{
    BeginRecord(ref writer, TypeName<T>())!;
    foreach (FieldInfo field in Fields<T>()) {
        WriteNamedInt(ref writer, NameOf<field>(), value.field)!;
    }
    EndRecord(ref writer)!;
    return Result::Ok();
}
