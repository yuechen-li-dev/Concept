module Standard.Octagon.Derive;
profile Core;
import Standard.Octagon.Core;

// Reflected record derivation uses the ordinary typed byte reader and writer.
// Each additional field type needs a matching checked ReadNamed/WriteNamed pair.
generator <typename T> DeriveOctagonRead
Result<T, OctagonError> ReadOctagon(ref OctagonReader reader, OctagonType<T> type)
{
    AtNameVoid(BeginRecord(ref reader, TypeName<T>()), TypeName<T>())?;
    T value = T{foreach (FieldInfo field in Fields<T>()) {
        field = AtName(AtName(ReadNamed(ref reader, NameOf<field>(), OctagonType<FieldType<field>>{0}), NameOf<field>()), TypeName<T>())?;
    }};
    AtNameVoid(EndRecord(ref reader), TypeName<T>())?;
    return Result::Ok(move value);
}

generator <typename T> DeriveOctagonWrite
Result<void, OctagonError> WriteOctagon(ref const T value, ref OctagonWriter writer)
{
    AtNameVoid(BeginRecord(ref writer, TypeName<T>()), TypeName<T>())?;
    foreach (FieldInfo field in Fields<T>()) {
        AtNameVoid(AtNameVoid(WriteNamed(ref writer, NameOf<field>(), value.field), NameOf<field>()), TypeName<T>())?;
    }
    AtNameVoid(EndRecord(ref writer), TypeName<T>())?;
    return Result::Ok();
}

// Payload enum writer arms are ordinary exhaustive matches. Each payload
// delegates to the same typed codec operation as a record field.
generator <typename T> DeriveOctagonEnumWrite
Result<void, OctagonError> WriteOctagon(ref const T value, ref OctagonWriter writer)
{
    foreach (EnumCaseInfo variant in Cases<T>()) {
        AtNameVoid(AtNameVoid(WriteLiteral(ref writer, TypeName<T>()), NameOf<variant>()), TypeName<T>())?;
        AtNameVoid(AtNameVoid(WriteLiteral(ref writer, "."), NameOf<variant>()), TypeName<T>())?;
        AtNameVoid(AtNameVoid(WriteLiteral(ref writer, NameOf<variant>()), NameOf<variant>()), TypeName<T>())?;
        int payloadIndex = 0;
        foreach (FieldInfo field in Payload<variant>()) {
            if (payloadIndex == 0) { AtNameVoid(AtNameVoid(AtNameVoid(WriteLiteral(ref writer, "("), NameOf<field>()), NameOf<variant>()), TypeName<T>())?; }
            else { AtNameVoid(AtNameVoid(AtNameVoid(WriteLiteral(ref writer, ", "), NameOf<field>()), NameOf<variant>()), TypeName<T>())?; }
            AtNameVoid(AtNameVoid(AtNameVoid(WriteOctagon(ref const field, ref writer), NameOf<field>()), NameOf<variant>()), TypeName<T>())?;
            payloadIndex = payloadIndex + 1;
        }
        if (payloadIndex > 0) { AtNameVoid(AtNameVoid(WriteLiteral(ref writer, ")"), NameOf<variant>()), TypeName<T>())?; }
    }
    return Result::Ok();
}

generator <typename T> DeriveOctagonEnumRead
Result<T, OctagonError> ReadOctagon(ref OctagonReader reader, OctagonType<T> type)
{
    foreach (EnumCaseInfo variant in Cases<T>()) {
        if (TryCase(ref reader, TypeName<T>(), NameOf<variant>(), HasPayload<variant>())) {
            int payloadIndex = 0;
            foreach (FieldInfo field in Payload<variant>()) {
                if (payloadIndex > 0) { AtNameVoid(AtNameVoid(AtNameVoid(ExpectLiteral(ref reader, ","), NameOf<field>()), NameOf<variant>()), TypeName<T>())?; }
                FieldType<field> field = AtName(AtName(AtName(ReadOctagon(ref reader, OctagonType<FieldType<field>>{0}), NameOf<field>()), NameOf<variant>()), TypeName<T>())?;
                payloadIndex = payloadIndex + 1;
            }
            if (payloadIndex > 0) { AtNameVoid(AtNameVoid(ExpectLiteral(ref reader, ")"), NameOf<variant>()), TypeName<T>())?; }
            return Result::Ok(ConstructCase<variant>());
        }
    }
    return Result::Error(PrefixOctagonError(OctagonError::UnexpectedData, OctagonPathPart::Name(TypeName<T>())));
}

// A single-field nominal refinement reads its representation through the
// ordinary codec and must pass the author's AdmitOctagon operation.
generator <typename T> DeriveOctagonRefinedRead
Result<T, OctagonError> ReadOctagon(ref OctagonReader reader, OctagonType<T> type)
{
    foreach (FieldInfo field in OnlyField<T>()) {
        FieldType<field> raw = AtName(AtName(ReadOctagon(ref reader, OctagonType<FieldType<field>>{0}), NameOf<field>()), TypeName<T>())?;
        return AtName(AdmitOctagon(raw, type), TypeName<T>());
    }
    return Result::Error(OctagonError::UnexpectedData);
}

generator <typename T> DeriveOctagonRefinedWrite
Result<void, OctagonError> WriteOctagon(ref const T value, ref OctagonWriter writer)
{
    foreach (FieldInfo field in OnlyField<T>()) {
        AtNameVoid(AtNameVoid(WriteOctagon(ref const value.field, ref writer), NameOf<field>()), TypeName<T>())?;
    }
    return Result::Ok();
}
