module Standard.Backend.AMD64;
profile Core;
import Standard.Backend.BridgeValidate;
import Standard.Backend.Win64ABI;
import Standard.Semantic.Vocabulary;
record struct MachineOperand
{
    OperandKind kind;
    int id;
    int width;
    int base;
    int baseSlot;
    int index;
    int scale;
    int displacement;
    BridgeText literal;
    BridgeText region;
    bool signedValue;
}
struct ProjectedCall
{
    BridgeText target;
    int argumentCount;
    int[8] values;
    CallValueType[8] types;
    CallValueType result;
}
ProjectedCall EmptyProjectedCall() {
    return ProjectedCall {
        BridgeText{0, 0}, 0,[- 1 ...],[CallValueType::Void ...], CallValueType::Void
    };
}
record struct MachineInstruction
{
    Opcode op;
    MachineOperand destination;
    MachineOperand source0;
    MachineOperand source1;
    int sourceCount;
    int width;
    int flagsDef;
    int flagsUse;
    Condition condition;
    int lirBlock;
    int lirInstruction;
    int sourceLine;
    int sourceColumn;
    ProjectedCall call;
}
record struct MachineBlock
{
    int id;
    int lirBlock;
    int firstInstruction;
    int instructionCount;
    Opcode terminator;
    int trueBlock;
    int falseBlock;
    Condition condition;
    int flagsUse;
    int sourceLine;
    int sourceColumn;
}
record struct MachineVReg {
    int id;
    int width;
    bool address;
}
record struct MachineSlot
{
    int id;
    int size;
    int alignment;
    bool incomingIndirect;
    int baseVReg;
    BridgeText source;
}
record struct MachineArg
{
    BridgeText typeName;
    int index;
    int width;
    bool indirect;
    Register physical;
    int stackOffset;
    bool onStack;
    int virtualReg;
}
struct BackendFunction
{
    BridgeText identity;
    BridgeText name;
    BridgeText result;
    int frameLocalSize;
    int frameAlignment;
    int frameShadowSpace;
    bool hasCalls;
    MachineArg[8] args;
    int argCount;
    MachineVReg[512] virtualRegs;
    int virtualRegCount;
    MachineSlot[64] slots;
    int slotCount;
    MachineBlock[128] blocks;
    int blockCount;
    MachineInstruction[512] instructions;
    int instructionCount;
}
MachineOperand EmptyOperand()
{
    return MachineOperand {
        OperandKind::None, 0, 0, - 1, - 1, - 1, 1, 0,
        BridgeText{0, 0}, BridgeText{0, 0}, false
    };
}
MachineInstruction EmptyInstruction()
{
    return MachineInstruction {
        Opcode::None, EmptyOperand(), EmptyOperand(),
        EmptyOperand(), 0, 0, - 1, - 1, Condition::None, 0, 0, 0, 0, EmptyProjectedCall()
    };
}
BackendFunction EmptyFunction()
{
    return BackendFunction {
        BridgeText{0, 0}, BridgeText{0, 0}, BridgeText{0, 0},
        0, 16, 0, false,
        [MachineArg {
            BridgeText{0, 0}, 0, 0, false, Register::RAX, 0, false, 0
        }
        ...], 0,
        [MachineVReg{0, 0, false}
        ...], 0,
        [MachineSlot {
            0, 0, 0, false, - 1, BridgeText{0, 0}
        }
        ...], 0,
        [MachineBlock{0, 0, 0, 0, Opcode::None, 0, 0, Condition::None, - 1, 0, 0}
        ...], 0,
        [EmptyInstruction() ...], 0
    };
}
bool ValidWidth(int width)
{
    return width == 1 or width == 2 or width == 4 or width == 8;
}
Result<void, BackendError> ValidateOperand(
ref const BackendFunction function, MachineOperand operand)
{
    // Establish bounds before forming the indexed width observation. Result
    // validation must not depend on short-circuit lowering of an array guard.
    if (operand.kind == OperandKind::Virtual) {
        if (operand.id < 0 or operand.id >= function.virtualRegCount) {
            return Result::Error(BackendError::BridgeInvalid);
        }
    }
    bool valid = match (operand.kind)
    {
        OperandKind::None => true,
        OperandKind::Block => operand.id >= 0 and operand.id < function.blockCount,
        OperandKind::Virtual => ValidWidth(operand.width) and
        operand.id >= 0 and operand.id < function.virtualRegCount and
        operand.width == function.virtualRegs[operand.id].width,
        OperandKind::Physical => ValidWidth(operand.width) and
        operand.id >= 0 and operand.id < 16,
        OperandKind::Slot => ValidWidth(operand.width) and
        operand.id >= 0 and operand.id < function.slotCount,
        OperandKind::Immediate => ValidWidth(operand.width) and
        operand.literal.length > 0,
        OperandKind::Memory => ValidWidth(operand.width) and
        operand.baseSlot < function.slotCount and
        operand.base < function.virtualRegCount and
        operand.index < function.virtualRegCount and
        (operand.base >= 0 or operand.baseSlot >= 0 or operand.index < 0) and
        (operand.scale == 1 or operand.scale == 2 or
        operand.scale == 4 or operand.scale == 8),
    };
    if (not valid) { return Result::Error(BackendError::BridgeInvalid); }
    return Result::Ok();
}
MachineOperand ProjectWireOperand(WireMachineOperand value) {
    return MachineOperand {
        value.Kind, value.ID, value.Width, value.Base,
        value.BaseSlot, value.Index, value.Scale, value.Disp,
        value.Literal, value.Region, value.Signed
    };
}
// This is a semantic projection. Wire order belongs exclusively to ReadWire.
Result<void, BackendError> ProjectWireFunction(
ref const BridgeReader source, WireMachineFunction wire, ref BackendFunction function) {
    if (not TextEquals(ref const source, wire.Target, "amd64-windows") or
    not TextEquals(ref const source, wire.ABI, "win64")) {
        return Result::Error(BackendError::BridgeInvalid);
    }
    function.identity = wire.Identity;
    function.name = wire.Name;
    function.result = wire.Result;
    function.frameLocalSize = wire.Frame.LocalSize;
    function.frameAlignment = wire.Frame.Alignment;
    function.frameShadowSpace = wire.Frame.ShadowSpace;
    function.hasCalls = wire.Frame.HasCalls;
    function.argCount = wire.Args.count;
    function.virtualRegCount = wire.VRegs.count;
    function.slotCount = wire.Slots.count;
    function.blockCount = wire.Blocks.count;
    if (function.argCount > Len(function.args) or
    function.virtualRegCount > Len(function.virtualRegs) or
    function.slotCount > Len(function.slots) or
    function.blockCount > Len(function.blocks)) {
        return Result::Error(BackendError::CapacityExceeded);
    }
    BridgeReader reader = BridgeReader{source.data, wire.Args.offset};
    for (i in 0 .. function.argCount) {
        WireMachineArg value = ReadWire(ref reader, BridgeType<WireMachineArg>{0}) ?;
        function.args[i] = MachineArg {
            value.Type, value.Index, value.Width,
            value.Indirect, value.Register, value.StackOffset, value.OnStack, value.VReg
        };
    }
    reader.offset = wire.VRegs.offset;
    for (i in 0 .. function.virtualRegCount) {
        WireMachineVReg value = ReadWire(ref reader, BridgeType<WireMachineVReg>{0}) ?;
        function.virtualRegs[i] = MachineVReg{value.ID, value.Width, value.Address};
    }
    reader.offset = wire.Slots.offset;
    for (i in 0 .. function.slotCount) {
        WireMachineStackSlot value = ReadWire(ref reader, BridgeType<WireMachineStackSlot>{0}) ?;
        function.slots[i] = MachineSlot {
            value.ID, value.Size, value.Align,
            value.IncomingIndirect, value.BaseVReg, value.Source
        };
    }
    reader.offset = wire.Blocks.offset;
    for (bi in 0 .. function.blockCount) {
        WireMachineBlock block = ReadWire(ref reader, BridgeType<WireMachineBlock>{0}) ?;
        int count = block.Instructions.count;
        if (count > Len(function.instructions) - function.instructionCount) {
            return Result::Error(BackendError::CapacityExceeded);
        }
        int first = function.instructionCount;
        if (block.Term.Op == Opcode::Jmp or block.Term.Op == Opcode::Jcc) {
            if (block.Term.True < 0 or block.Term.True >= function.blockCount) {
                return Result::Error(BackendError::BridgeInvalid);
            }
        }
        if (block.Term.Op == Opcode::Jcc) {
            if (block.Term.False < 0 or block.Term.False >= function.blockCount) {
                return Result::Error(BackendError::BridgeInvalid);
            }
        }
        BridgeReader instructions = BridgeReader{source.data, block.Instructions.offset};
        for (ii in 0 .. count) {
            WireMachineInstruction value = ReadWire(ref instructions, BridgeType<WireMachineInstruction>{
                0
            }) ?;
            ProjectedCall call = EmptyProjectedCall();
            if (value.Op == Opcode::Call) {
                BridgeReader calls = BridgeReader{source.data, value.Calls.offset};
                WireMachineCall wireCall = ReadWire(ref calls, BridgeType<WireMachineCall>{0}) ?;
                if (wireCall.Arguments.count > 8) {
                    return Result::Error(BackendError::CapacityExceeded);
                }
                call.target = wireCall.Target;
                call.argumentCount = wireCall.Arguments.count;
                call.result = wireCall.Result;
                BridgeReader arguments = BridgeReader {
                    source.data, wireCall.Arguments.offset
                };
                for (ai in 0 .. call.argumentCount) {
                    WireMachineCallArgument argument = ReadWire(ref arguments, BridgeType<WireMachineCallArgument>{
                        0
                    }) ?;
                    call.values[ai] = argument.Value;
                    call.types[ai] = argument.Type;
                }
            }
            if (value.Src.count > 2) { return Result::Error(BackendError::BridgeInvalid); }
            MachineOperand destination = ProjectWireOperand(value.Dst);
            MachineOperand source0 = EmptyOperand();
            MachineOperand source1 = EmptyOperand();
            BridgeReader operands = BridgeReader{source.data, value.Src.offset};
            if (value.Src.count > 0) {
                source0 = ProjectWireOperand(ReadWire(ref operands, BridgeType<WireMachineOperand>{
                    0
                }) ?);
            }
            if (value.Src.count > 1) {
                source1 = ProjectWireOperand(ReadWire(ref operands, BridgeType<WireMachineOperand>{
                    0
                }) ?);
            }
            ValidateOperand(ref const function, destination) ?;
            if (value.Src.count > 0) {
                ValidateOperand(ref const function, source0) ?;
            }
            if (value.Src.count > 1) {
                ValidateOperand(ref const function, source1) ?;
            }
            function.instructions[function.instructionCount] = MachineInstruction {
                value.Op, destination, source0, source1, value.Src.count,
                value.Width, value.FlagsDef, value.FlagsUse, value.Cond,
                value.LIRBlock, value.LIRInstruction, value.Source.Line, value.Source.Column, call
            };
            function.instructionCount += 1;
        }
        function.blocks[bi] = MachineBlock {
            block.ID, block.LIRBlock, first, count,
            block.Term.Op, block.Term.True, block.Term.False, block.Term.Cond,
            block.Term.FlagsUse, block.Term.Source.Line, block.Term.Source.Column
        };
    }
    return Result::Ok();
}
Result<void, BackendError> DecodeFunction(
ReadOnlySpan<byte> artifact, int ordinal, ref BackendFunction function) {
    ValidateMachineBridge(artifact) ?;
    BridgeReader reader = BridgeReader{artifact, 0};
    ReadBridgeIdentity(ref reader) ?;
    WireMachineModule document = ReadWire(ref reader, BridgeType<WireMachineModule>{0}) ?;
    if (ordinal < 0 or ordinal >= document.Functions.count or reader.offset != Len(artifact)) {
        return Result::Error(BackendError::BridgeInvalid);
    }
    BackendFunction selected = EmptyFunction();
    reader.offset = document.Functions.offset;
    for (i in 0 .. document.Functions.count) {
        WireMachineFunction wire = ReadWire(ref reader, BridgeType<WireMachineFunction>{0}) ?;
        function = EmptyFunction();
        ProjectWireFunction(ref const reader, wire, ref function) ?;
        if (i == ordinal) {
            selected = function;
        }
    }
    function = selected;
    return Result::Ok();
}
string DescribeBackendError(BackendError error)
{
    if (error == BackendError::UnsupportedCallLowering) {
        return "AMD64_UNSUPPORTED_CALL_ENCODING: verified concrete frame/actions require target encoding and fixups";
    }
    return "AMD64_BACKEND_ERROR";
}
struct Allocation
{
    int[512] start;
    int[512] end;
    Register[512] physical;
    bool[512] assigned;
    bool[15] usedCalleeSaved;
    int callCount;
    int shadowSpaceBytes;
    int stackArgumentBytes;
    int temporaryCount;
    int preservationCount;
}
// A bounds/overflow check splits one LIR block into several MachineIR blocks.
// Keep those continuations adjacent before computing linear intervals. Appended
// checks otherwise create artificial overlapping intervals across unrelated
// source blocks. This is general layout, independent of automata or frame tags.
Result<void, BackendError> LayoutLoweredBlocks(ref BackendFunction function)
{
    MachineBlock[128] originalBlocks = function.blocks;
    MachineInstruction[512] originalInstructions = function.instructions;
    bool[128] seen =[false ...];
    int[128] remap =[0 ...];
    int nextBlock = 0;
    int nextInstruction = 0;
    for (first in 0 .. function.blockCount)
    {
        if (not seen[first])
        {
            for (old in first .. function.blockCount)
            {
                if (originalBlocks[old].lirBlock == originalBlocks[first].lirBlock)
                {
                    seen[old] = true;
                    MachineBlock block = originalBlocks[old];
                    remap[old] = nextBlock;
                    function.blocks[nextBlock] = MachineBlock {
                        nextBlock, block.lirBlock, nextInstruction, block.instructionCount,
                        block.terminator, block.trueBlock, block.falseBlock, block.condition,
                        block.flagsUse, block.sourceLine, block.sourceColumn
                    };
                    for (ii in 0 .. block.instructionCount)
                    {
                        function.instructions[nextInstruction] = originalInstructions[block.firstInstruction + ii];
                        nextInstruction = nextInstruction + 1;
                    }
                    nextBlock = nextBlock + 1;
                }
            }
        }
    }
    if (nextInstruction != function.instructionCount)
    { return Result::Error(BackendError::BridgeInvalid); }
    for (bi in 0 .. function.blockCount)
    {
        MachineBlock block = function.blocks[bi];
        int yes = block.trueBlock;
        int no = block.falseBlock;
        if (block.terminator == Opcode::Jmp or block.terminator == Opcode::Jcc)
        {
            if (yes < 0 or yes >= function.blockCount)
            { return Result::Error(BackendError::BridgeInvalid); }
            yes = remap[yes];
        }
        if (block.terminator == Opcode::Jcc)
        {
            if (no < 0 or no >= function.blockCount)
            { return Result::Error(BackendError::BridgeInvalid); }
            no = remap[no];
        }
        function.blocks[bi] = MachineBlock {
            bi, block.lirBlock, block.firstInstruction, block.instructionCount,
            block.terminator, yes, no, block.condition,
            block.flagsUse, block.sourceLine, block.sourceColumn
        };
    }
    return Result::Ok();
}
Allocation EmptyAllocation()
{
    return Allocation {
        [2147483647 ...],[- 1 ...],[Register::RAX ...],[false ...],[false ...], 0, 0, 0, 0, 0
    };
}
void TouchInterval(ref Allocation allocation, int id, int position)
{
    if (position < allocation.start[id]) {
        allocation.start[id] = position;
    }
    if (position > allocation.end[id]) {
        allocation.end[id] = position;
    }
}
void TouchOperand(ref Allocation allocation, MachineOperand operand, int position)
{
    if (operand.kind == OperandKind::Virtual)
    {
        TouchInterval(ref allocation, operand.id, position);
    }
    if (operand.kind == OperandKind::Memory)
    {
        if (operand.base >= 0) {
            TouchInterval(ref allocation, operand.base, position);
        }
        if (operand.index >= 0) {
            TouchInterval(ref allocation, operand.index, position);
        }
    }
}
struct LivenessBits {
    int[17] words;
}
struct Liveness
{
    // 128 blocks * 17 words of 31 bits: 512 virtual registers per block. The same
    // fixed-capacity representation serves ordinary and generated functions.
    LivenessBits[128] use;
    LivenessBits[128] def;
    LivenessBits[128] liveIn;
    LivenessBits[128] liveOut;
}
Liveness EmptyLiveness()
{
    return Liveness {
        [LivenessBits{[0 ...]}
        ...],[LivenessBits{[0 ...]}
        ...],
        [LivenessBits{[0 ...]}
        ...],[LivenessBits{[0 ...]}
        ...]
    };
}
void MarkUse(ref Liveness liveness, int block, int id)
{
    int index = id / 31;
    int bit = 1 <<(id % 31);
    if ((liveness.def[block].words[index] & bit) == 0) {
        liveness.use[block].words[index] = liveness.use[block].words[index] | bit;
    }
}
void MarkOperandUse(ref Liveness liveness, int block, MachineOperand operand)
{
    if (operand.kind == OperandKind::Virtual)
    {
        MarkUse(ref liveness, block, operand.id);
    }
    if (operand.kind == OperandKind::Memory)
    {
        if (operand.base >= 0) {
            MarkUse(ref liveness, block, operand.base);
        }
        if (operand.index >= 0) {
            MarkUse(ref liveness, block, operand.index);
        }
    }
}
Result<void, BackendError> ComputeLiveness(
ref const BackendFunction function, ref Liveness liveness)
{
    if (function.blockCount > 128 or function.virtualRegCount > 512)
    { return Result::Error(BackendError::CapacityExceeded); }
    for (bi in 0 .. function.blockCount)
    {
        MachineBlock block = function.blocks[bi];
        if (block.id != bi) { return Result::Error(BackendError::BridgeInvalid); }
        for (ii in 0 .. block.instructionCount)
        {
            MachineInstruction instruction = function.instructions[block.firstInstruction + ii];
            if (instruction.op == Opcode::Call) {
                if (instruction.call.argumentCount < 0 or instruction.call.argumentCount > 8) {
                    return Result::Error(BackendError::CapacityExceeded);
                }
                for (ai in 0 .. instruction.call.argumentCount) {
                    int id = instruction.call.values[ai];
                    if (id < 0 or id >= function.virtualRegCount) {
                        return Result::Error(BackendError::BridgeInvalid);
                    }
                    MarkUse(ref liveness, bi, instruction.call.values[ai]);
                }
            }
            if (instruction.sourceCount > 0)
            {
                MarkOperandUse(ref liveness, bi, instruction.source0);
            }
            if (instruction.sourceCount > 1)
            {
                MarkOperandUse(ref liveness, bi, instruction.source1);
            }
            if (instruction.op == Opcode::Add or instruction.op == Opcode::Sub or
            instruction.op == Opcode::Imul or instruction.op == Opcode::Umul or
            instruction.op == Opcode::Store)
            {
                MarkOperandUse(ref liveness, bi, instruction.destination);
            }
            if (instruction.destination.kind == OperandKind::Virtual)
            {
                int id = instruction.destination.id;
                int index = id / 31;
                int bit = 1 <<(id % 31);
                liveness.def[bi].words[index] = liveness.def[bi].words[index] | bit;
            }
        }
    }
    bool changed = true;
    for (pass in 0 .. function.blockCount + 1)
    {
        changed = false;
        for (bi in 0 .. function.blockCount)
        {
            MachineBlock block = function.blocks[bi];
            if (block.terminator == Opcode::Jmp or block.terminator == Opcode::Jcc)
            {
                if (block.trueBlock < 0 or block.trueBlock >= function.blockCount)
                { return Result::Error(BackendError::BridgeInvalid); }
            }
            if (block.terminator == Opcode::Jcc and
            (block.falseBlock < 0 or block.falseBlock >= function.blockCount))
            { return Result::Error(BackendError::BridgeInvalid); }
            for (word in 0 ..(function.virtualRegCount + 30) / 31)
            {
                int outgoing = 0;
                if (block.terminator == Opcode::Jmp or block.terminator == Opcode::Jcc)
                {
                    outgoing = liveness.liveIn[block.trueBlock].words[word];
                }
                if (block.terminator == Opcode::Jcc)
                {
                    outgoing = outgoing | liveness.liveIn[block.falseBlock].words[word];
                }
                int allBits = 2147483647;
                int incoming = liveness.use[bi].words[word] |
                (outgoing &(liveness.def[bi].words[word] ^ allBits));
                if (outgoing != liveness.liveOut[bi].words[word] or
                incoming != liveness.liveIn[bi].words[word])
                {
                    changed = true;
                }
                liveness.liveOut[bi].words[word] = outgoing;
                liveness.liveIn[bi].words[word] = incoming;
            }
        }
        if (not changed) { return Result::Ok(); }
    }
    return Result::Error(BackendError::BridgeInvalid);
}
// Live-in/out edges extend intervals across branches and loop backedges.
// The layout order stays deterministic even when the CFG is cyclic.
Result<void, BackendError> ComputeIntervals(
ref const BackendFunction function, ref Allocation allocation)
{
    Liveness liveness = EmptyLiveness();
    ComputeLiveness(ref const function, ref liveness) ?;
    for (bi in 0 .. function.blockCount)
    {
        MachineBlock block = function.blocks[bi];
        for (id in 0 .. function.virtualRegCount)
        {
            int index = id / 31;
            int bit = 1 <<(id % 31);
            if ((liveness.liveIn[bi].words[index] & bit) != 0)
            {
                TouchInterval(ref allocation, id, block.firstInstruction);
            }
            if ((liveness.liveOut[bi].words[index] & bit) != 0)
            {
                TouchInterval(ref allocation, id,
                block.firstInstruction + block.instructionCount);
            }
        }
        for (ii in 0 .. block.instructionCount)
        {
            int position = block.firstInstruction + ii;
            MachineInstruction instruction = function.instructions[position];
            TouchOperand(ref allocation, instruction.destination, position);
            if (instruction.op == Opcode::Call) {
                for (ai in 0 .. instruction.call.argumentCount) {
                    TouchInterval(ref allocation, instruction.call.values[ai], position);
                }
            }
            if (instruction.sourceCount > 0)
            {
                TouchOperand(ref allocation, instruction.source0, position);
            }
            if (instruction.sourceCount > 1)
            {
                TouchOperand(ref allocation, instruction.source1, position);
            }
        }
    }
    return Result::Ok();
}
Register PoolRegister(int ordinal)
{
    if (ordinal == 0) { return Register::R10; }
    if (ordinal == 1) { return Register::R11; }
    if (ordinal == 2) { return Register::RAX; }
    if (ordinal == 3) { return Register::R8; }
    return Register::R9;
}
// R10/R11/RAX handle the initial ABI copies. R8/R9 become available only
// after their incoming arguments have been copied, which happens before any
// later value can require a fourth register. Spills remain explicit failure.
Result<void, BackendError> AllocateRegisters(
ref const BackendFunction function, ref Allocation allocation)
{
    ComputeIntervals(ref const function, ref allocation) ?;
    // Fixed call uses/defs are derived before assignments. General assignments
    // remain the qualified pool; call-point moves and preservation are explicit.
    for (position in 0 .. function.instructionCount) {
        if (function.instructions[position].op == Opcode::Call) {
            CallPlan plan = EmptyCallPlan();
            CallRequest request = RequestForCall(function.instructions[position], position);
            Result<void, ABIError> checked = PlanWin64Call(ref const request, ref plan);
            match (checked) {
                Result::Ok() => { }
                Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
            }
            allocation.callCount += 1;
            allocation.shadowSpaceBytes = plan.shadowSpaceBytes;
            if (plan.stackArgumentBytes > allocation.stackArgumentBytes) {
                allocation.stackArgumentBytes = plan.stackArgumentBytes;
            }
        }
    }
    for (position in 0 .. function.instructionCount)
    {
        for (id in 0 .. function.virtualRegCount)
        {
            if (allocation.start[id] == position)
            {
                bool found = false;
                Register choice = Register::R10;
                int candidateCount = 5;
                if (allocation.callCount > 0) {
                    candidateCount += Len(Win64Registers().calleeSaved);
                }
                for (candidate in 0 .. candidateCount)
                {
                    Register physical = Register::RAX;
                    if (candidate < 5) {
                        physical = PoolRegister(candidate);
                    }
                    else {
                        physical = Win64Registers().calleeSaved[candidate - 5];
                    }
                    bool busy = false;
                    for (other in 0 .. function.virtualRegCount)
                    {
                        if (allocation.assigned[other] and
                        allocation.physical[other] == physical and
                        allocation.end[other] > position)
                        {
                            busy = true;
                        }
                    }
                    if (not busy and not found)
                    {
                        choice = physical;
                        found = true;
                    }
                }
                if (not found) { return Result::Error(BackendError::RegisterExhausted); }
                allocation.physical[id] = choice;
                allocation.assigned[id] = true;
                if (IsCalleeSaved(choice)) {
                    allocation.usedCalleeSaved[RegisterIndex(choice)] = true;
                }
            }
        }
    }
    return Result::Ok();
}
CallRequest RequestForCall(MachineInstruction instruction, int position) {
    CallRequest request = EmptyCallRequest();
    request.target = instruction.call.target;
    request.instruction = position;
    request.argumentCount = instruction.call.argumentCount;
    for (i in 0 .. request.argumentCount) {
        CallValueType type = instruction.call.types[i];
        ABIClass category = ABIClass::Integer;
        if (type == CallValueType::Bool) {
            category = ABIClass::Bool;
        }
        request.arguments[i] = ABIValue {
            instruction.call.values[i], type, category, CallValueWidth(type)
        };
    }
    request.hasResult = instruction.call.result != CallValueType::Void;
    if (request.hasResult) {
        ABIClass category = ABIClass::Integer;
        if (instruction.call.result == CallValueType::Bool) {
            category = ABIClass::Bool;
        }
        request.result = ABIValue {
            instruction.destination.id, instruction.call.result, category, instruction.width
        };
    }
    return request;
}
void SetLive(ref LivenessBits bits, int id) {
    bits.words[id / 31] = bits.words[id / 31] |(1 <<(id % 31));
}
void ClearLive(ref LivenessBits bits, int id) {
    bits.words[id / 31] = bits.words[id / 31] &((1 <<(id % 31)) ^ 2147483647);
}
void AddLiveOperand(ref LivenessBits bits, MachineOperand operand) {
    if (operand.kind == OperandKind::Virtual) {
        SetLive(ref bits, operand.id);
    }
    if (operand.kind == OperandKind::Memory) {
        if (operand.base >= 0) {
            SetLive(ref bits, operand.base);
        }
        if (operand.index >= 0) {
            SetLive(ref bits, operand.index);
        }
    }
}
Result<LivenessBits, ABIError> LiveAcrossCall(
ref const BackendFunction function, ref const Liveness liveness, int position) {
    if (position < 0 or position >= function.instructionCount) {
        return Result::Error(ABIError::InvalidPlan);
    }
    if (function.instructions[position].op != Opcode::Call) {
        return Result::Error(ABIError::InvalidPlan);
    }
    for (bi in 0 .. function.blockCount) {
        MachineBlock block = function.blocks[bi];
        if (position >= block.firstInstruction and position < block.firstInstruction + block.instructionCount) {
            LivenessBits live = liveness.liveOut[bi];
            for (back in 0 .. block.instructionCount) {
                int at = block.firstInstruction + block.instructionCount - 1 - back;
                MachineInstruction instruction = function.instructions[at];
                // The call result is born after the call: never preserve it.
                if (at == position) {
                    if (instruction.destination.kind == OperandKind::Virtual) {
                        ClearLive(ref live, instruction.destination.id);
                    }
                    return Result::Ok(live);
                }
                if (instruction.destination.kind == OperandKind::Virtual) {
                    ClearLive(ref live, instruction.destination.id);
                }
                if (instruction.sourceCount > 0) {
                    AddLiveOperand(ref live, instruction.source0);
                }
                if (instruction.sourceCount > 1) {
                    AddLiveOperand(ref live, instruction.source1);
                }
                if (instruction.op == Opcode::Call) {
                    for (ai in 0 .. instruction.call.argumentCount) {
                        SetLive(ref live, instruction.call.values[ai]);
                    }
                }
                if (instruction.op == Opcode::Add or instruction.op == Opcode::Sub or instruction.op == Opcode::Imul or instruction.op == Opcode::Umul or instruction.op == Opcode::Store) {
                    AddLiveOperand(ref live, instruction.destination);
                }
            }
        }
    }
    return Result::Error(ABIError::InvalidPlan);
}
Result<void, ABIError> ValidateCallFlags(ref const BackendFunction function) {
    for (bi in 0 .. function.blockCount) {
        MachineBlock block = function.blocks[bi];
        int flags = - 1;
        for (ii in 0 .. block.instructionCount) {
            MachineInstruction instruction = function.instructions[block.firstInstruction + ii];
            if (instruction.flagsUse >= 0 and instruction.flagsUse != flags) {
                return Result::Error(ABIError::StaleFlags);
            }
            if (instruction.op == Opcode::Call) {
                flags = - 1;
            }
            else {
                if (instruction.flagsDef >= 0) {
                    flags = instruction.flagsDef;
                }
            }
        }
        if (block.flagsUse >= 0 and block.flagsUse != flags) {
            return Result::Error(ABIError::StaleFlags);
        }
    }
    return Result::Ok();
}
Result<void, ABIError> PlanAllocatedCall(
ref const BackendFunction function, ref const Allocation allocation, ref const Liveness liveness,
int position, ref CallPlan plan, Span<Preservation> preservation, ref int count) {
    ValidateCallFlags(ref const function) ?;
    if (position < 0 or position >= function.instructionCount) {
        return Result::Error(ABIError::InvalidPlan);
    }
    MachineInstruction instruction = function.instructions[position];
    if (instruction.op != Opcode::Call) { return Result::Error(ABIError::InvalidPlan); }
    CallRequest request = RequestForCall(instruction, position);
    PlanWin64Call(ref const request, ref plan) ?;
    Register[8] sources =[Register::RAX ...];
    for (i in 0 .. plan.argumentCount) {
        int id = plan.arguments[i].source.value;
        if (id < 0 or id >= function.virtualRegCount) {
            return Result::Error(ABIError::InvalidAllocation);
        }
        if (not allocation.assigned[id]) {
            return Result::Error(ABIError::InvalidAllocation);
        }
        sources[i] = allocation.physical[id];
    }
    PlanArgumentMoves(ref plan, ref const sources) ?;
    ValidateArgumentMoves(ref const plan, ref const sources) ?;
    LivenessBits across = LiveAcrossCall(ref const function, ref const liveness, position) ?;
    count = 0;
    for (id in 0 .. function.virtualRegCount) {
        if ((across.words[id / 31] &(1 <<(id % 31))) != 0) {
            if (not allocation.assigned[id] or not IsValueRegister(allocation.physical[id])) {
                return Result::Error(ABIError::InvalidAllocation);
            }
            if (count >= Len(preservation)) {
                return Result::Error(ABIError::CapacityExceeded);
            }
            PreservationClass classification = PreservationClass::OutsideClobbers;
            if (IsCallerSaved(allocation.physical[id])) {
                classification = PreservationClass::MustPreserve;
            }
            else {
                if (IsCalleeSaved(allocation.physical[id])) {
                    classification = PreservationClass::SafeInCalleeSaved;
                }
            }
            preservation[count] = Preservation {
                id, function.virtualRegs[id].width, function.virtualRegs[id].address,
                allocation.physical[id], position, allocation.start[id], allocation.end[id], classification
            };
            ValidatePreservation(preservation[count]) ?;
            count += 1;
        }
    }
    return Result::Ok();
}
// Only one bounded per-call plan and one caller-owned preservation buffer are
// resident. Summary maxima feed later shared outgoing/frame storage.
Result<void, BackendError> PlanFunctionCalls(ref const BackendFunction function, ref Allocation allocation) {
    Liveness liveness = EmptyLiveness();
    ComputeLiveness(ref const function, ref liveness) ?;
    Preservation[512] storage =[Preservation {
        0, 0, false, Register::RAX, 0, 0, 0, PreservationClass::OutsideClobbers
    }
    ...];
    allocation.temporaryCount = 0;
    allocation.preservationCount = 0;
    for (i in 0 .. Len(allocation.usedCalleeSaved)) {
        allocation.usedCalleeSaved[i] = false;
    }
    for (id in 0 .. function.virtualRegCount) {
        if (allocation.assigned[id] and IsCalleeSaved(allocation.physical[id])) {
            allocation.usedCalleeSaved[RegisterIndex(allocation.physical[id])] = true;
        }
    }
    for (position in 0 .. function.instructionCount) {
        if (function.instructions[position].op == Opcode::Call) {
            CallPlan plan = EmptyCallPlan();
            int count = 0;
            match (PlanAllocatedCall(ref const function, ref const allocation, ref const liveness, position,
            ref plan, Span(storage), ref count)) {
                Result::Ok() => { }
                Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
            }
            if (plan.temporaryCount > allocation.temporaryCount) {
                allocation.temporaryCount = plan.temporaryCount;
            }
            for (i in 0 .. count) {
                if (storage[i].classification == PreservationClass::MustPreserve) {
                    allocation.preservationCount += 1;
                }
            }
        }
    }
    return Result::Ok();
}
struct ByteWriter {
    Span<byte> bytes;
    int offset;
}
record struct BranchFixup {
    int patchOffset;
    int targetBlock;
}
struct EncodingPlan
{
    int[128] blockOffsets;
    BranchFixup[256] fixups;
    int fixupCount;
}
// Scratch storage belongs to the caller; no phase allocates a hidden heap.
struct EncodingWorkspace
{
    Span<int> blockOffsets;
    Span<BranchFixup> fixups;
    int fixupCount;
}
// Native stack storage is distinct from persistent automata MachineFrame state.
enum FrameError {
    CapacityExceeded, InvalidAlignment, UnsupportedWidth, Overlap, InvalidOffset, UnresolvedSpill, UnresolvedTemporary,
    InvalidSaveRestore, InvalidActions, InvalidInput
}
enum FrameRegionKind {
    OutgoingShadow, OutgoingArguments, LocalSlots, SavedRegisters, SpillSlots, MoveTemps, AlignmentPadding
}
enum FrameActionKind {
    Allocate, Save, Restore, Store, Load, Copy, AbstractCall, Release, Return
}
enum CallReplayInput {
    Store, Load, Copy, Call
}
// The executable protocol rejects stores after the abstract clobber and a
// second call. Register/slot semantics remain the replay checker's authority.
automata CallReplayProtocol with input CallReplayInput {
    machine Main {
        state PreCall {
            on CallReplayInput::Store => PreCall;
            on CallReplayInput::Load => PreCall;
            on CallReplayInput::Copy => PreCall;
            on CallReplayInput::Call => PostCall;
        }
        state PostCall {
            on CallReplayInput::Load => PostCall;
            on CallReplayInput::Copy => PostCall;
        }
    }
}
record struct FrameSlot {
    FrameRegionKind category;
    int identity;
    int offset;
    int size;
    int alignment;
}
record struct FrameRegion {
    FrameRegionKind category;
    int offset;
    int size;
}
record struct FrameAction {
    FrameActionKind kind;
    Register source;
    Register destination;
    int slot;
    int offset;
    int width;
    int value;
}
struct CallSiteActions {
    CallPlan abi;
    FrameAction[32] actions;
    int count;
    int callIndex;
}
FrameAction EmptyFrameAction() {
    return FrameAction {
        FrameActionKind::Copy, Register::RAX, Register::RAX, - 1, - 1, 0, - 1
    };
}
CallSiteActions EmptyCallSiteActions() {
    return CallSiteActions{EmptyCallPlan(),[EmptyFrameAction() ...], 0, - 1};
}
struct FinalizedFrame
{
    int byteCount;
    int[64] slotOffsets;
    int unalignedSize;
    int padding;
    FrameSlot[512] slots;
    int slotCount;
    FrameRegion[7] regions;
    int[512] spillSlots;
    int[15] saveSlots;
    int[4] tempSlots;
    int[4] outgoingSlots;
    FrameAction[10] prologue;
    int prologueCount;
    FrameAction[10] epilogue;
    int epilogueCount;
    int returnCount;
    int[128] returnBlocks;
}
FinalizedFrame EmptyFinalizedFrame() {
    return FinalizedFrame {
        0,[- 1 ...], 0, 0,[FrameSlot{FrameRegionKind::LocalSlots, - 1, 0, 0, 1}
        ...], 0,
        [FrameRegion{FrameRegionKind::OutgoingShadow, 0, 0}
        ...],[- 1 ...],[- 1 ...],[- 1 ...],[- 1 ...],
        [EmptyFrameAction() ...], 0,[EmptyFrameAction() ...], 0, 0,[- 1 ...]
    };
}
string DescribeFrameError(FrameError error) {
    return match (error) {
        FrameError::CapacityExceeded => "AMD64_FRAME_CAPACITY_EXCEEDED",
        FrameError::InvalidAlignment => "AMD64_FRAME_INVALID_ALIGNMENT",
        FrameError::UnsupportedWidth => "AMD64_FRAME_UNSUPPORTED_WIDTH",
        FrameError::Overlap => "AMD64_FRAME_OVERLAP",
        FrameError::InvalidOffset => "AMD64_FRAME_INVALID_OFFSET",
        FrameError::UnresolvedSpill => "AMD64_FRAME_UNRESOLVED_SPILL",
        FrameError::UnresolvedTemporary => "AMD64_FRAME_UNRESOLVED_TEMPORARY",
        FrameError::InvalidSaveRestore => "AMD64_FRAME_INVALID_SAVE_RESTORE",
        FrameError::InvalidActions => "AMD64_FRAME_INVALID_ACTIONS",
        FrameError::InvalidInput => "AMD64_FRAME_INVALID_INPUT",
    };
}
string FrameRegionName(FrameRegionKind category) {
    return match (category) {
        FrameRegionKind::OutgoingShadow => "shadow",
        FrameRegionKind::OutgoingArguments => "outgoing",
        FrameRegionKind::LocalSlots => "local",
        FrameRegionKind::SavedRegisters => "save",
        FrameRegionKind::SpillSlots => "spill",
        FrameRegionKind::MoveTemps => "temp",
        FrameRegionKind::AlignmentPadding => "padding",
    };
}
string FrameActionName(FrameActionKind kind) {
    return match (kind) {
        FrameActionKind::Allocate => "allocate",
        FrameActionKind::Save => "save",
        FrameActionKind::Restore => "restore",
        FrameActionKind::Store => "store",
        FrameActionKind::Load => "load",
        FrameActionKind::Copy => "copy",
        FrameActionKind::AbstractCall => "abstract-call",
        FrameActionKind::Release => "release",
        FrameActionKind::Return => "return",
    };
}
bool FrameAlignmentValid(int alignment) {
    return alignment == 1 or alignment == 2 or alignment == 4 or alignment == 8 or alignment == 16;
}
int FrameRegionIndex(FrameRegionKind category) {
    return match (category) {
        FrameRegionKind::OutgoingShadow => 0,
        FrameRegionKind::OutgoingArguments => 1,
        FrameRegionKind::LocalSlots => 2,
        FrameRegionKind::SavedRegisters => 3,
        FrameRegionKind::SpillSlots => 4,
        FrameRegionKind::MoveTemps => 5,
        FrameRegionKind::AlignmentPadding => 6,
    };
}
bool ScalarStorageWidth(int width) {
    return width == 1 or width == 2 or width == 4 or width == 8;
}
// Check before adding; no wrapped arithmetic participates in frame layout.
Result<int, FrameError> AddFrameBytes(int offset, int count) {
    if (offset < 0 or count < 0 or offset > 65528 or count > 65528 - offset) {
        return Result::Error(FrameError::CapacityExceeded);
    }
    return Result::Ok(offset + count);
}
Result<int, FrameError> AlignFrameBytes(int offset, int alignment) {
    if (not FrameAlignmentValid(alignment)) {
        return Result::Error(FrameError::InvalidAlignment);
    }
    return AddFrameBytes(offset,(alignment - offset % alignment) % alignment);
}
Result<int, FrameError> AppendFrameSlot(ref FinalizedFrame frame, FrameRegionKind category, int identity,
int size, int alignment, ref int used) {
    if (frame.slotCount < 0 or frame.slotCount >= Len(frame.slots)) {
        return Result::Error(FrameError::CapacityExceeded);
    }
    if (size <= 0) { return Result::Error(FrameError::UnsupportedWidth); }
    int offset = AlignFrameBytes(used, alignment) ?;
    used = AddFrameBytes(offset, size) ?;
    int index = frame.slotCount;
    frame.slots[index] = FrameSlot{category, identity, offset, size, alignment};
    frame.slotCount += 1;
    return Result::Ok(index);
}
FrameAction SlotAction(FrameActionKind kind, Register physical, int slot, ref const FinalizedFrame frame,
int width, int value) {
    return FrameAction {
        kind, physical, physical, slot, frame.slots[slot].offset, width, value
    };
}
// One finalizer owns locals and all derived call storage. RSP stays fixed after
// allocation; outgoing area is the maximum across calls, spills are per vreg.
Result<void, FrameError> RealizeFrame(ref const BackendFunction function, ref const Allocation allocation,
ref const Liveness liveness, ref FinalizedFrame frame) {
    frame = EmptyFinalizedFrame();
    if (function.frameAlignment != 16) { return Result::Error(FrameError::InvalidAlignment); }
    if (function.slotCount < 0 or function.slotCount > 64 or function.virtualRegCount < 0 or function.virtualRegCount > 512) {
        return Result::Error(FrameError::CapacityExceeded);
    }
    bool[512] spills =[false ...];
    bool[15] saves =[false ...];
    int calls = 0;
    int stackCount = 0;
    int temps = 0;
    Preservation[512] records =[Preservation {
        0, 0, false, Register::RAX, 0, 0, 0, PreservationClass::OutsideClobbers
    }
    ...];
    for (id in 0 .. function.virtualRegCount) {
        if (allocation.assigned[id] and(not ScalarStorageWidth(function.virtualRegs[id].width) or(function.virtualRegs[id].address and function.virtualRegs[id].width != 8))) {
            return Result::Error(FrameError::UnsupportedWidth);
        }
        if (allocation.assigned[id] and IsCalleeSaved(allocation.physical[id])) {
            saves[RegisterIndex(allocation.physical[id])] = true;
        }
    }
    for (position in 0 .. function.instructionCount) {
        if (function.instructions[position].op == Opcode::Call) {
            CallPlan plan = EmptyCallPlan();
            int count = 0;
            match (PlanAllocatedCall(ref const function, ref const allocation, ref const liveness, position,
            ref plan, Span(records), ref count)) {
                Result::Ok() => { }
                Result::Error(error) => { return Result::Error(FrameError::InvalidInput); }
            }
            calls += 1;
            if (plan.stackArgumentCount > stackCount) {
                stackCount = plan.stackArgumentCount;
            }
            if (plan.temporaryCount > temps) {
                temps = plan.temporaryCount;
            }
            for (i in 0 .. count) {
                if (records[i].classification == PreservationClass::MustPreserve) {
                    spills[records[i].value] = true;
                }
            }
        }
    }
    // CMIRAMD3 transports logical local storage, not derived outgoing geometry.
    // Legacy Frame.HasCalls remains false in current checked producers. The
    // decoded CALL instructions, not that bootstrap summary, own this fact.
    if (allocation.callCount != calls or(calls == 0 and function.frameShadowSpace != 0)) {
        return Result::Error(FrameError::InvalidInput);
    }
    int used = 0;
    int shadow = 0;
    if (calls > 0) {
        shadow = ShadowSpaceBytes;
    }
    frame.regions[0] = FrameRegion{FrameRegionKind::OutgoingShadow, 0, shadow};
    used = shadow;
    for (i in 0 .. stackCount) {
        frame.outgoingSlots[i] = AppendFrameSlot(ref frame, FrameRegionKind::OutgoingArguments, i, 8,
        8, ref used) ?;
    }
    frame.regions[1] = FrameRegion{FrameRegionKind::OutgoingArguments, shadow, used - shadow};
    int begin = used;
    int localUsed = 0;
    for (i in 0 .. function.slotCount) {
        MachineSlot slot = function.slots[i];
        if (not slot.incomingIndirect) {
            if (slot.size <= 0) { return Result::Error(FrameError::UnsupportedWidth); }
            localUsed = AlignFrameBytes(localUsed, slot.alignment) ?;
            localUsed = AddFrameBytes(localUsed, slot.size) ?;
            int index = AppendFrameSlot(ref frame, FrameRegionKind::LocalSlots, i, slot.size, slot.alignment,
            ref used) ?;
            frame.slotOffsets[i] = frame.slots[index].offset;
        }
    }
    if (localUsed != function.frameLocalSize) {
        return Result::Error(FrameError::InvalidInput);
    }
    frame.regions[2] = FrameRegion{FrameRegionKind::LocalSlots, begin, used - begin};
    begin = used;
    ABIRegisterTables tables = Win64Registers();
    for (i in 0 .. 8) {
        Register physical = tables.calleeSaved[i];
        int id = RegisterIndex(physical);
        if (saves[id]) {
            frame.saveSlots[id] = AppendFrameSlot(ref frame, FrameRegionKind::SavedRegisters, id, 8,
            8, ref used) ?;
        }
    }
    frame.regions[3] = FrameRegion{FrameRegionKind::SavedRegisters, begin, used - begin};
    begin = used;
    for (id in 0 .. function.virtualRegCount) {
        if (spills[id]) {
            int width = function.virtualRegs[id].width;
            if (not ScalarStorageWidth(width) or(function.virtualRegs[id].address and width != 8)) {
                return Result::Error(FrameError::UnsupportedWidth);
            }
            frame.spillSlots[id] = AppendFrameSlot(ref frame, FrameRegionKind::SpillSlots, id, width,
            width, ref used) ?;
        }
    }
    frame.regions[4] = FrameRegion{FrameRegionKind::SpillSlots, begin, used - begin};
    begin = used;
    for (i in 0 .. temps) {
        frame.tempSlots[i] = AppendFrameSlot(ref frame, FrameRegionKind::MoveTemps, i, 8, 8, ref used) ?;
    }
    frame.regions[5] = FrameRegion{FrameRegionKind::MoveTemps, begin, used - begin};
    frame.unalignedSize = used;
    if (used > 0 or calls > 0) {
        frame.byteCount = AddFrameBytes(used,(8 - used % 16 + 16) % 16) ?;
    }
    frame.padding = frame.byteCount - used;
    frame.regions[6] = FrameRegion{FrameRegionKind::AlignmentPadding, used, frame.padding};
    if (frame.byteCount > 0) {
        frame.prologue[frame.prologueCount] = FrameAction {
            FrameActionKind::Allocate, Register::RSP, Register::RSP, - 1, frame.byteCount, 0, - 1
        };
        frame.prologueCount += 1;
    }
    for (i in 0 .. 8) {
        Register physical = tables.calleeSaved[i];
        int slot = frame.saveSlots[RegisterIndex(physical)];
        if (slot >= 0) {
            frame.prologue[frame.prologueCount] = SlotAction(FrameActionKind::Save, physical, slot, ref const frame,
            8, - 1);
            frame.prologueCount += 1;
        }
    }
    for (i in 0 .. 8) {
        Register physical = tables.calleeSaved[7 - i];
        int slot = frame.saveSlots[RegisterIndex(physical)];
        if (slot >= 0) {
            frame.epilogue[frame.epilogueCount] = SlotAction(FrameActionKind::Restore, physical, slot,
            ref const frame, 8, - 1);
            frame.epilogueCount += 1;
        }
    }
    if (frame.byteCount > 0) {
        frame.epilogue[frame.epilogueCount] = FrameAction {
            FrameActionKind::Release, Register::RSP, Register::RSP, - 1, frame.byteCount, 0, - 1
        };
        frame.epilogueCount += 1;
    }
    frame.epilogue[frame.epilogueCount] = FrameAction {
        FrameActionKind::Return, Register::RAX, Register::RAX, - 1, - 1, 0, - 1
    };
    frame.epilogueCount += 1;
    for (b in 0 .. function.blockCount) {
        if (function.blocks[b].terminator == Opcode::Ret) {
            frame.returnBlocks[frame.returnCount] = b;
            frame.returnCount += 1;
        }
    }
    return ValidateFrame(ref const frame, calls > 0);
}
Result<void, FrameError> ValidateFrame(ref const FinalizedFrame frame, bool calls) {
    if (frame.slotCount < 0 or frame.slotCount > 512 or frame.byteCount < 0 or frame.byteCount > 65528) {
        return Result::Error(FrameError::CapacityExceeded);
    }
    if ((frame.byteCount > 0 or calls) and frame.byteCount % 16 != 8) {
        return Result::Error(FrameError::InvalidAlignment);
    }
    if (frame.unalignedSize < 0 or frame.padding < 0 or frame.padding > 15 or frame.byteCount - frame.padding != frame.unalignedSize) {
        return Result::Error(FrameError::InvalidOffset);
    }
    int end = 0;
    for (r in 0 .. 7) {
        FrameRegion region = frame.regions[r];
        if (FrameRegionIndex(region.category) != r or region.offset != end or region.size < 0 or region.size > frame.byteCount - end) {
            return Result::Error(FrameError::Overlap);
        }
        end += region.size;
    }
    int shadow = 0;
    if (calls) {
        shadow = 32;
    }
    if (end != frame.byteCount or frame.regions[0].size != shadow or frame.regions[6].size != frame.padding) {
        return Result::Error(FrameError::InvalidOffset);
    }
    for (i in 0 .. frame.slotCount) {
        FrameSlot slot = frame.slots[i];
        int category = FrameRegionIndex(slot.category);
        if (not FrameAlignmentValid(slot.alignment) or slot.offset % slot.alignment != 0) {
            return Result::Error(FrameError::InvalidAlignment);
        }
        if (slot.size <= 0 or category <= 0 or category >= 6) {
            return Result::Error(FrameError::UnsupportedWidth);
        }
        FrameRegion region = frame.regions[category];
        if (slot.offset < region.offset or slot.size > region.size or slot.offset - region.offset > region.size - slot.size) {
            return Result::Error(FrameError::InvalidOffset);
        }
        for (j in 0 .. i) {
            FrameSlot other = frame.slots[j];
            if (other.category == slot.category and other.identity == slot.identity) {
                return Result::Error(FrameError::Overlap);
            }
            if (other.offset < slot.offset + slot.size and slot.offset < other.offset + other.size) {
                return Result::Error(FrameError::Overlap);
            }
        }
        int mapped = - 1;
        match (slot.category) {
            FrameRegionKind::OutgoingArguments => {
                if (slot.identity < 0 or slot.identity >= 4 or slot.size != 8 or slot.alignment != 8 or slot.offset != 32 + slot.identity * 8) {
                    return Result::Error(FrameError::InvalidOffset);
                }
                mapped = frame.outgoingSlots[slot.identity];
            }
            FrameRegionKind::LocalSlots => {
                if (slot.identity < 0 or slot.identity >= 64 or frame.slotOffsets[slot.identity] != slot.offset) {
                    return Result::Error(FrameError::InvalidOffset);
                }
                mapped = i;
            }
            FrameRegionKind::SavedRegisters => {
                if (slot.identity < 7 or slot.identity >= 15 or slot.size != 8 or slot.alignment != 8) {
                    return Result::Error(FrameError::InvalidSaveRestore);
                }
                mapped = frame.saveSlots[slot.identity];
            }
            FrameRegionKind::SpillSlots => {
                if (slot.identity < 0 or slot.identity >= 512 or not ScalarStorageWidth(slot.size) or slot.alignment != slot.size) {
                    return Result::Error(FrameError::UnsupportedWidth);
                }
                mapped = frame.spillSlots[slot.identity];
            }
            FrameRegionKind::MoveTemps => {
                if (slot.identity < 0 or slot.identity >= 4 or slot.size != 8 or slot.alignment != 8) {
                    return Result::Error(FrameError::UnresolvedTemporary);
                }
                mapped = frame.tempSlots[slot.identity];
            }
            FrameRegionKind::OutgoingShadow => {
                return Result::Error(FrameError::InvalidOffset);
            }
            FrameRegionKind::AlignmentPadding => {
                return Result::Error(FrameError::InvalidOffset);
            }
        }
        if (mapped != i) { return Result::Error(FrameError::InvalidOffset); }
    }
    return ValidateFrameEnds(ref const frame);
}
// Qualify coverage against function facts independently of geometry layout.
// Every listed return routes through the same inverse action sequence.
Result<void, FrameError> ValidateFunctionFrame(ref const BackendFunction function, ref const Allocation allocation,
ref const Liveness liveness, ref const FinalizedFrame frame) {
    ValidateFrame(ref const frame, allocation.callCount > 0) ?;
    bool[512] required =[false ...];
    bool[15] saved =[false ...];
    for (r in 0 .. 7) {
        if (frame.saveSlots[r] != - 1) {
            return Result::Error(FrameError::InvalidSaveRestore);
        }
    }
    for (id in 0 .. function.virtualRegCount) {
        if (allocation.assigned[id] and IsCalleeSaved(allocation.physical[id])) {
            saved[RegisterIndex(allocation.physical[id])] = true;
        }
    }
    for (r in 7 .. 15) {
        if ((frame.saveSlots[r] >= 0) != saved[r]) {
            return Result::Error(FrameError::InvalidSaveRestore);
        }
    }
    int temps = 0;
    int outgoing = 0;
    Preservation[512] records =[Preservation {
        0, 0, false, Register::RAX, 0, 0, 0, PreservationClass::OutsideClobbers
    }
    ...];
    for (p in 0 .. function.instructionCount) {
        if (function.instructions[p].op == Opcode::Call) {
            CallPlan plan = EmptyCallPlan();
            int count = 0;
            match (PlanAllocatedCall(ref const function, ref const allocation, ref const liveness, p,
            ref plan, Span(records), ref count)) {
                Result::Ok() => { }
                Result::Error(error) => { return Result::Error(FrameError::InvalidInput); }
            }
            if (plan.temporaryCount > temps) {
                temps = plan.temporaryCount;
            }
            if (plan.stackArgumentCount > outgoing) {
                outgoing = plan.stackArgumentCount;
            }
            for (i in 0 .. count) {
                if (records[i].classification == PreservationClass::MustPreserve) {
                    int id = records[i].value;
                    required[id] = true;
                    int slot = ResolveFrameSlot(ref const frame, FrameRegionKind::SpillSlots, id) ?;
                    if (frame.slots[slot].size != records[i].width) {
                        return Result::Error(FrameError::UnsupportedWidth);
                    }
                }
            }
        }
    }
    for (id in 0 .. 512) {
        if ((frame.spillSlots[id] >= 0) != required[id]) {
            return Result::Error(FrameError::UnresolvedSpill);
        }
    }
    for (i in 0 .. 4) {
        if ((frame.tempSlots[i] >= 0) !=(i < temps)) {
            return Result::Error(FrameError::UnresolvedTemporary);
        }
        if ((frame.outgoingSlots[i] >= 0) !=(i < outgoing)) {
            return Result::Error(FrameError::InvalidOffset);
        }
    }
    if (frame.regions[1].size != outgoing * 8) {
        return Result::Error(FrameError::InvalidOffset);
    }
    int returns = 0;
    for (b in 0 .. function.blockCount) {
        if (function.blocks[b].terminator == Opcode::Ret) {
            if (returns >= frame.returnCount or frame.returnBlocks[returns] != b) {
                return Result::Error(FrameError::InvalidSaveRestore);
            }
            returns += 1;
        }
    }
    if (returns != frame.returnCount) {
        return Result::Error(FrameError::InvalidSaveRestore);
    }
    for (i in 0 .. function.slotCount) {
        MachineSlot slot = function.slots[i];
        if (slot.incomingIndirect) {
            if (frame.slotOffsets[i] != - 1) {
                return Result::Error(FrameError::InvalidOffset);
            }
        }
        else {
            bool found = false;
            for (s in 0 .. frame.slotCount) {
                FrameSlot concrete = frame.slots[s];
                if (concrete.category == FrameRegionKind::LocalSlots and concrete.identity == i and concrete.size == slot.size and concrete.alignment == slot.alignment) {
                    found = true;
                }
            }
            if (not found) { return Result::Error(FrameError::InvalidOffset); }
        }
    }
    return Result::Ok();
}
Result<void, FrameError> ValidateFrameEnds(ref const FinalizedFrame frame) {
    if (frame.prologueCount < 0 or frame.prologueCount > 9 or frame.epilogueCount < 1 or frame.epilogueCount > 10) {
        return Result::Error(FrameError::InvalidSaveRestore);
    }
    int p = 0;
    int e = 0;
    if (frame.byteCount > 0) {
        FrameAction action = frame.prologue[p];
        if (action.kind != FrameActionKind::Allocate or action.offset != frame.byteCount or action.source != Register::RSP or action.destination != Register::RSP or action.slot != - 1 or action.width != 0) {
            return Result::Error(FrameError::InvalidSaveRestore);
        }
        p += 1;
    }
    ABIRegisterTables tables = Win64Registers();
    for (i in 0 .. 8) {
        Register physical = tables.calleeSaved[i];
        int slot = frame.saveSlots[RegisterIndex(physical)];
        if (slot >= 0) {
            if (slot >= frame.slotCount or p >= frame.prologueCount) {
                return Result::Error(FrameError::InvalidSaveRestore);
            }
            FrameSlot saved = frame.slots[slot];
            if (saved.category != FrameRegionKind::SavedRegisters or saved.identity != RegisterIndex(physical)) {
                return Result::Error(FrameError::InvalidSaveRestore);
            }
            FrameAction action = frame.prologue[p];
            if (action.kind != FrameActionKind::Save or action.source != physical or action.destination != physical or action.slot != slot or action.width != 8 or action.offset != saved.offset) {
                return Result::Error(FrameError::InvalidSaveRestore);
            }
            p += 1;
        }
    }
    for (i in 0 .. 8) {
        Register physical = tables.calleeSaved[7 - i];
        int slot = frame.saveSlots[RegisterIndex(physical)];
        if (slot >= 0) {
            if (e >= frame.epilogueCount) {
                return Result::Error(FrameError::InvalidSaveRestore);
            }
            FrameAction action = frame.epilogue[e];
            if (action.kind != FrameActionKind::Restore or action.source != physical or action.destination != physical or action.slot != slot or action.width != 8 or action.offset != frame.slots[slot].offset) {
                return Result::Error(FrameError::InvalidSaveRestore);
            }
            e += 1;
        }
    }
    if (frame.byteCount > 0) {
        if (e >= frame.epilogueCount) {
            return Result::Error(FrameError::InvalidSaveRestore);
        }
        FrameAction action = frame.epilogue[e];
        if (action.kind != FrameActionKind::Release or action.offset != frame.byteCount or action.source != Register::RSP or action.destination != Register::RSP or action.slot != - 1 or action.width != 0) {
            return Result::Error(FrameError::InvalidSaveRestore);
        }
        e += 1;
    }
    if (p != frame.prologueCount or e + 1 != frame.epilogueCount or frame.epilogue[e].kind != FrameActionKind::Return or frame.epilogue[e].source != Register::RAX or frame.epilogue[e].destination != Register::RAX) {
        return Result::Error(FrameError::InvalidSaveRestore);
    }
    return Result::Ok();
}
Result<void, FrameError> AppendCallAction(ref CallSiteActions site, FrameAction action) {
    if (site.count < 0 or site.count >= Len(site.actions)) {
        return Result::Error(FrameError::CapacityExceeded);
    }
    site.actions[site.count] = action;
    site.count += 1;
    return Result::Ok();
}
Result<int, FrameError> ResolveFrameSlot(ref const FinalizedFrame frame, FrameRegionKind category, int identity) {
    int slot = - 1;
    match (category) {
        FrameRegionKind::SpillSlots => {
            if (identity >= 0 and identity < 512) {
                slot = frame.spillSlots[identity];
            }
        }
        FrameRegionKind::SavedRegisters => {
            if (identity >= 7 and identity < 15) {
                slot = frame.saveSlots[identity];
            }
        }
        FrameRegionKind::MoveTemps => {
            if (identity >= 0 and identity < 4) {
                slot = frame.tempSlots[identity];
            }
        }
        FrameRegionKind::OutgoingArguments => {
            if (identity >= 0 and identity < 4) {
                slot = frame.outgoingSlots[identity];
            }
        }
        FrameRegionKind::LocalSlots => { }
        FrameRegionKind::OutgoingShadow => { }
        FrameRegionKind::AlignmentPadding => { }
    }
    if (slot < 0 or slot >= frame.slotCount) {
        if (category == FrameRegionKind::SpillSlots) {
            return Result::Error(FrameError::UnresolvedSpill);
        }
        if (category == FrameRegionKind::MoveTemps) {
            return Result::Error(FrameError::UnresolvedTemporary);
        }
        return Result::Error(FrameError::InvalidOffset);
    }
    if (frame.slots[slot].category != category or frame.slots[slot].identity != identity) {
        return Result::Error(FrameError::InvalidOffset);
    }
    return Result::Ok(slot);
}
Result<void, FrameError> LowerCallActions(ref const CallPlan plan, Span<Preservation> records, int count,
ref const Allocation allocation, ref const FinalizedFrame frame, ref CallSiteActions site) {
    match (ValidateCallPlan(ref const plan)) {
        Result::Ok() => { }
        Result::Error(error) => { return Result::Error(FrameError::InvalidInput); }
    }
    if (plan.moveCount < 0 or plan.moveCount > 12 or plan.temporaryCount < 0 or plan.temporaryCount > 4) {
        return Result::Error(FrameError::InvalidActions);
    }
    site = EmptyCallSiteActions();
    site.abi = plan;
    if (count < 0 or count > Len(records)) {
        return Result::Error(FrameError::CapacityExceeded);
    }
    for (i in 0 .. count) {
        Preservation record = records[i];
        if (record.classification == PreservationClass::MustPreserve) {
            int slot = ResolveFrameSlot(ref const frame, FrameRegionKind::SpillSlots, record.value) ?;
            AppendCallAction(ref site, SlotAction(FrameActionKind::Store, record.physical, slot, ref const frame,
            record.width, record.value)) ?;
        }
    }
    for (i in 0 .. plan.moveCount) {
        ArgumentMove operation = plan.moves[i];
        match (operation.destinationKind) {
            MoveLocation::Physical => {
                match (operation.sourceKind) {
                    MoveLocation::Physical => {
                        AppendCallAction(ref site, FrameAction {
                            FrameActionKind::Copy, operation.source, operation.destination, - 1, - 1,
                            operation.width, - 1
                        }) ?;
                    }
                    MoveLocation::Temporary => {
                        int slot = ResolveFrameSlot(ref const frame, FrameRegionKind::MoveTemps, operation.sourceSlot) ?;
                        AppendCallAction(ref site, SlotAction(FrameActionKind::Load, operation.destination,
                        slot, ref const frame, operation.width, - 1)) ?;
                    }
                    MoveLocation::Outgoing => {
                        return Result::Error(FrameError::InvalidActions);
                    }
                }
            }
            MoveLocation::Outgoing => {
                int slot = ResolveFrameSlot(ref const frame, FrameRegionKind::OutgoingArguments, operation.destinationSlot) ?;
                AppendCallAction(ref site, SlotAction(FrameActionKind::Store, operation.source, slot,
                ref const frame, operation.width, - 1)) ?;
            }
            MoveLocation::Temporary => {
                int slot = ResolveFrameSlot(ref const frame, FrameRegionKind::MoveTemps, operation.destinationSlot) ?;
                AppendCallAction(ref site, SlotAction(FrameActionKind::Store, operation.source, slot,
                ref const frame, operation.width, - 1)) ?;
            }
        }
    }
    site.callIndex = site.count;
    AppendCallAction(ref site, FrameAction {
        FrameActionKind::AbstractCall, Register::RAX, Register::RAX, - 1, - 1, 0, - 1
    }) ?;
    // Capture result first: RAX might then be reloaded with a preserved value.
    if (plan.hasResult) {
        int id = plan.result.value;
        if (id < 0 or id >= 512 or not allocation.assigned[id]) {
            return Result::Error(FrameError::InvalidInput);
        }
        AppendCallAction(ref site, FrameAction {
            FrameActionKind::Copy, Register::RAX, allocation.physical[id], - 1, - 1, plan.result.width,
            id
        }) ?;
    }
    for (i in 0 .. count) {
        Preservation record = records[i];
        if (record.classification == PreservationClass::MustPreserve) {
            int slot = ResolveFrameSlot(ref const frame, FrameRegionKind::SpillSlots, record.value) ?;
            AppendCallAction(ref site, SlotAction(FrameActionKind::Load, record.physical, slot, ref const frame,
            record.width, record.value)) ?;
        }
    }
    return Result::Ok();
}
// Independent identity and available-width replay of the concrete sequence.
Result<void, FrameError> ReplayCallActions(ref const CallSiteActions site, Span<Preservation> records,
int count, ref const Allocation allocation, ref const FinalizedFrame frame) {
    match (ValidateCallPlan(ref const site.abi)) {
        Result::Ok() => { }
        Result::Error(error) => { return Result::Error(FrameError::InvalidInput); }
    }
    ValidateFrame(ref const frame, true) ?;
    if (count < 0 or count > Len(records) or site.count < 1 or site.count > 32 or site.callIndex < 0 or site.callIndex >= site.count) {
        return Result::Error(FrameError::InvalidActions);
    }
    for (r in 0 .. count) {
        if (records[r].value < 0 or records[r].value >= 512 or not IsValueRegister(records[r].physical)) {
            return Result::Error(FrameError::InvalidInput);
        }
        match (ValidatePreservation(records[r])) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(FrameError::InvalidInput); }
        }
    }
    int[15] registers =[0 ...];
    int[15] widths =[8 ...];
    int[512] tokens =[- 1 ...];
    int[512] storedWidths =[0 ...];
    bool[512] spilled =[false ...];
    bool[512] reloaded =[false ...];
    bool called = false;
    for (i in 0 .. 15) {
        registers[i] = i;
    }
    instance CallReplayProtocol protocol();
    for (i in 0 .. site.count) {
        FrameAction action = site.actions[i];
        CallReplayInput input = CallReplayInput::Copy;
        match (action.kind) {
            FrameActionKind::Store => {
                input = CallReplayInput::Store;
            }
            FrameActionKind::Load => {
                input = CallReplayInput::Load;
            }
            FrameActionKind::Copy => {
                input = CallReplayInput::Copy;
            }
            FrameActionKind::AbstractCall => {
                input = CallReplayInput::Call;
            }
            FrameActionKind::Allocate => { return Result::Error(FrameError::InvalidActions); }
            FrameActionKind::Save => { return Result::Error(FrameError::InvalidActions); }
            FrameActionKind::Restore => { return Result::Error(FrameError::InvalidActions); }
            FrameActionKind::Release => { return Result::Error(FrameError::InvalidActions); }
            FrameActionKind::Return => { return Result::Error(FrameError::InvalidActions); }
        }
        if (Step(protocol, Main, input) != StepOutcome::Transitioned) {
            return Result::Error(FrameError::InvalidActions);
        }
        if (action.kind == FrameActionKind::AbstractCall) {
            if (called or i != site.callIndex) {
                return Result::Error(FrameError::InvalidActions);
            }
            for (a in 0 .. site.abi.argumentCount) {
                ArgumentPlacement argument = site.abi.arguments[a];
                int id = argument.source.value;
                if (id < 0 or id >= 512 or not allocation.assigned[id]) {
                    return Result::Error(FrameError::InvalidInput);
                }
                int token = - 1;
                int available = 0;
                if (argument.onStack) {
                    int slot = ResolveFrameSlot(ref const frame, FrameRegionKind::OutgoingArguments,
                    argument.stackSlot) ?;
                    token = tokens[slot];
                    available = storedWidths[slot];
                }
                else {
                    int index = RegisterIndex(argument.physical);
                    token = registers[index];
                    available = widths[index];
                }
                if (token != RegisterIndex(allocation.physical[id]) or available < argument.source.width) {
                    return Result::Error(FrameError::InvalidActions);
                }
            }
            for (r in 0 .. count) {
                if (records[r].classification == PreservationClass::MustPreserve and not spilled[records[r].value]) {
                    return Result::Error(FrameError::UnresolvedSpill);
                }
            }
            ABIRegisterTables tables = Win64Registers();
            for (r in 0 .. 7) {
                int index = RegisterIndex(tables.callerSaved[r]);
                registers[index] = - 1;
                widths[index] = 0;
            }
            if (site.abi.hasResult) {
                registers[RegisterIndex(Register::RAX)] = 1000;
                widths[RegisterIndex(Register::RAX)] = site.abi.result.width;
            }
            called = true;
        } else {
            if (not ScalarStorageWidth(action.width) or not IsValueRegister(action.source) or not IsValueRegister(action.destination)) {
                return Result::Error(FrameError::UnsupportedWidth);
            }
            int source = RegisterIndex(action.source);
            int destination = RegisterIndex(action.destination);
            match (action.kind) {
                FrameActionKind::Copy => {
                    if (action.slot != - 1 or action.offset != - 1 or registers[source] < 0 or widths[source] < action.width) {
                        return Result::Error(FrameError::InvalidActions);
                    }
                    registers[destination] = registers[source];
                    widths[destination] = action.width;
                }
                FrameActionKind::Store => {
                    int slot = action.slot;
                    if (called or slot < 0 or slot >= frame.slotCount or action.offset != frame.slots[slot].offset or action.width > frame.slots[slot].size or registers[source] < 0 or widths[source] < action.width or tokens[slot] >= 0) {
                        return Result::Error(FrameError::InvalidActions);
                    }
                    FrameRegionKind category = frame.slots[slot].category;
                    if (category != FrameRegionKind::SpillSlots and category != FrameRegionKind::MoveTemps and category != FrameRegionKind::OutgoingArguments) {
                        return Result::Error(FrameError::InvalidActions);
                    }
                    if (category == FrameRegionKind::SpillSlots) {
                        int id = frame.slots[slot].identity;
                        if (action.value != id or action.width != frame.slots[slot].size) {
                            return Result::Error(FrameError::UnresolvedSpill);
                        }
                        spilled[id] = true;
                    }
                    tokens[slot] = registers[source];
                    storedWidths[slot] = action.width;
                }
                FrameActionKind::Load => {
                    int slot = action.slot;
                    if (slot < 0 or slot >= frame.slotCount or action.offset != frame.slots[slot].offset or tokens[slot] < 0 or storedWidths[slot] < action.width) {
                        return Result::Error(FrameError::InvalidActions);
                    }
                    FrameRegionKind category = frame.slots[slot].category;
                    if (called) {
                        if (category != FrameRegionKind::SpillSlots or action.value != frame.slots[slot].identity) {
                            return Result::Error(FrameError::UnresolvedSpill);
                        }
                        if (reloaded[action.value]) {
                            return Result::Error(FrameError::UnresolvedSpill);
                        }
                        reloaded[action.value] = true;
                    }
                    else {
                        if (category != FrameRegionKind::MoveTemps) {
                            return Result::Error(FrameError::InvalidActions);
                        }
                    }
                    registers[destination] = tokens[slot];
                    widths[destination] = action.width;
                }
                FrameActionKind::Allocate => {
                    return Result::Error(FrameError::InvalidActions);
                }
                FrameActionKind::Save => { return Result::Error(FrameError::InvalidActions); }
                FrameActionKind::Restore => {
                    return Result::Error(FrameError::InvalidActions);
                }
                FrameActionKind::AbstractCall => {
                    return Result::Error(FrameError::InvalidActions);
                }
                FrameActionKind::Release => {
                    return Result::Error(FrameError::InvalidActions);
                }
                FrameActionKind::Return => {
                    return Result::Error(FrameError::InvalidActions);
                }
            }
        }
    }
    if (not called) { return Result::Error(FrameError::InvalidActions); }
    for (r in 0 .. count) {
        Preservation record = records[r];
        int index = RegisterIndex(record.physical);
        if (registers[index] != index or widths[index] < record.width) {
            return Result::Error(FrameError::UnresolvedSpill);
        }
        if (record.classification == PreservationClass::MustPreserve and not reloaded[record.value]) {
            return Result::Error(FrameError::UnresolvedSpill);
        }
    }
    if (site.abi.hasResult) {
        int index = RegisterIndex(allocation.physical[site.abi.result.value]);
        if (registers[index] != 1000 or widths[index] < site.abi.result.width) {
            return Result::Error(FrameError::InvalidActions);
        }
    }
    return Result::Ok();
}
Result<void, FrameError> RealizeAllocatedCall(ref const BackendFunction function, ref const Allocation allocation,
ref const Liveness liveness, int position, ref const FinalizedFrame frame, ref CallSiteActions site) {
    CallPlan plan = EmptyCallPlan();
    Preservation[512] records =[Preservation {
        0, 0, false, Register::RAX, 0, 0, 0, PreservationClass::OutsideClobbers
    }
    ...];
    int count = 0;
    match (PlanAllocatedCall(ref const function, ref const allocation, ref const liveness, position,
    ref plan, Span(records), ref count)) {
        Result::Ok() => { }
        Result::Error(error) => { return Result::Error(FrameError::InvalidInput); }
    }
    LowerCallActions(ref const plan, Span(records), count, ref const allocation, ref const frame, ref site) ?;
    return ReplayCallActions(ref const site, Span(records), count, ref const allocation, ref const frame);
}
Result<void, FrameError> QualifyFunctionFrame(ref const BackendFunction function, ref const Allocation allocation,
ref FinalizedFrame frame) {
    Liveness liveness = EmptyLiveness();
    match (ComputeLiveness(ref const function, ref liveness)) {
        Result::Ok() => { }
        Result::Error(error) => { return Result::Error(FrameError::InvalidInput); }
    }
    RealizeFrame(ref const function, ref const allocation, ref const liveness, ref frame) ?;
    ValidateFunctionFrame(ref const function, ref const allocation, ref const liveness, ref const frame) ?;
    CallSiteActions site = EmptyCallSiteActions();
    for (position in 0 .. function.instructionCount) {
        if (function.instructions[position].op == Opcode::Call) {
            RealizeAllocatedCall(ref const function, ref const allocation, ref const liveness, position,
            ref const frame, ref site) ?;
        }
    }
    return Result::Ok();
}
void FrameFacts() {
    Assert.Concept<PlainData>(FrameSlot, "native stack slot provenance");
    Assert.Concept<PlainData>(FrameRegion, "explicit native stack region");
    Assert.Concept<PlainData>(FrameAction, "concrete scalar call-site action");
    Assert.Concept<NoAllocation>(RealizeFrame, "bounded function storage");
    Assert.Concept<NoAllocation>(LowerCallActions, "bounded explicit action sequence");
    Assert.Concept<NoAllocation>(ReplayCallActions, "independent bounded identity replay");
}
Result<FinalizedFrame, BackendError> FinalizeFrame(ref const BackendFunction function)
{
    if (function.hasCalls or function.frameShadowSpace != 0 or
    function.frameAlignment != 16)
    { return Result::Error(BackendError::UnsupportedInstruction); }
    FinalizedFrame frame = EmptyFinalizedFrame();
    Allocation allocation = EmptyAllocation();
    Liveness liveness = EmptyLiveness();
    match (RealizeFrame(ref const function, ref const allocation, ref const liveness, ref frame)) {
        Result::Ok() => { }
        Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
    }
    return Result::Ok(move frame);
}
EncodingPlan EmptyEncodingPlan()
{
    return EncodingPlan {
        [- 1 ...],[BranchFixup{0, 0}
        ...], 0
    };
}
Result<void, BackendError> WriteByte(ref ByteWriter writer, int value)
{
    if (value < 0 or value > 255 or writer.offset >= Len(writer.bytes))
    { return Result::Error(BackendError::BufferFull); }
    writer.bytes[writer.offset] = value as byte;
    writer.offset = writer.offset + 1;
    return Result::Ok();
}
Result<void, BackendError> WriteI32LE(ref ByteWriter writer, int value)
{
    int remaining = value;
    for (i in 0 .. 4)
    {
        int digit = remaining % 256;
        if (digit < 0) {
            digit = digit + 256;
        }
        WriteByte(ref writer, digit) ?;
        remaining =(remaining - digit) / 256;
    }
    return Result::Ok();
}
Result<void, BackendError> PatchI32LE(ref ByteWriter writer, int offset, int value)
{
    if (offset < 0 or offset > writer.offset - 4)
    { return Result::Error(BackendError::InvalidEncoding); }
    int saved = writer.offset;
    writer.offset = offset;
    WriteI32LE(ref writer, value) ?;
    writer.offset = saved;
    return Result::Ok();
}
Result<Register, BackendError> RegisterFromID(int id)
{
    return match (id)
    {
        0 => Result::Ok(Register::RAX),
        1 => Result::Ok(Register::RBX),
        2 => Result::Ok(Register::RCX),
        3 => Result::Ok(Register::RDX),
        4 => Result::Ok(Register::RSI),
        5 => Result::Ok(Register::RDI),
        6 => Result::Ok(Register::RBP),
        7 => Result::Ok(Register::RSP),
        8 => Result::Ok(Register::R8),
        9 => Result::Ok(Register::R9),
        10 => Result::Ok(Register::R10),
        11 => Result::Ok(Register::R11),
        12 => Result::Ok(Register::R12),
        13 => Result::Ok(Register::R13),
        14 => Result::Ok(Register::R14),
        15 => Result::Ok(Register::R15),
        _ => Result::Error(BackendError::BridgeInvalid),
    };
}
int RegisterEncoding(Register reg)
{
    return match (reg)
    {
        Register::RAX => 0,
        Register::RCX => 1,
        Register::RDX => 2,
        Register::RBX => 3,
        Register::RSP => 4,
        Register::RBP => 5,
        Register::RSI => 6,
        Register::RDI => 7,
        Register::R8 => 8,
        Register::R9 => 9,
        Register::R10 => 10,
        Register::R11 => 11,
        Register::R12 => 12,
        Register::R13 => 13,
        Register::R14 => 14,
        Register::R15 => 15,
    };
}
Result<Register, BackendError> ResolveRegister(
ref const Allocation allocation, MachineOperand operand)
{
    if (operand.kind == OperandKind::Virtual)
    {
        if (operand.id < 0 or operand.id >= 512 or not allocation.assigned[operand.id])
        { return Result::Error(BackendError::BridgeInvalid); }
        return Result::Ok(allocation.physical[operand.id]);
    }
    if (operand.kind == OperandKind::Physical)
    { return RegisterFromID(operand.id); }
    return Result::Error(BackendError::UnsupportedInstruction);
}
Result<void, BackendError> WriteRex(
ref ByteWriter writer, bool wide, int regCode, int rmCode)
{
    int rex = 64;
    if (wide) {
        rex = rex + 8;
    }
    if (regCode >= 8) {
        rex = rex + 4;
    }
    if (rmCode >= 8) {
        rex = rex + 1;
    }
    if (rex != 64) {
        WriteByte(ref writer, rex) ?;
    }
    return Result::Ok();
}
Result<void, BackendError> WriteRegReg(
ref ByteWriter writer, int opcode, Register rm, Register reg, int width)
{
    if (width != 1 and width != 4 and width != 8)
    { return Result::Error(BackendError::UnsupportedInstruction); }
    int rmCode = RegisterEncoding(rm);
    int regCode = RegisterEncoding(reg);
    WriteRex(ref writer, width == 8, regCode, rmCode) ?;
    WriteByte(ref writer, opcode) ?;
    WriteByte(ref writer, 192 +(regCode % 8) * 8 + rmCode % 8) ?;
    return Result::Ok();
}
int ScaleBits(int scale)
{
    if (scale == 1) { return 0; }
    if (scale == 2) { return 1; }
    if (scale == 4) { return 2; }
    if (scale == 8) { return 3; }
    return - 1;
}
Result<void, BackendError> WriteMemoryReg(
ref ByteWriter writer, ref const Allocation allocation,
int opcode, Register reg, MachineOperand memory, int width)
{
    if (memory.kind != OperandKind::Memory or memory.base < 0 or
    memory.baseSlot >= 0 or(width != 1 and width != 4 and width != 8))
    { return Result::Error(BackendError::UnsupportedInstruction); }
    if (memory.base >= 512 or not allocation.assigned[memory.base])
    { return Result::Error(BackendError::BridgeInvalid); }
    int base = RegisterEncoding(allocation.physical[memory.base]);
    int index = - 1;
    if (memory.index >= 0)
    {
        if (memory.index >= 512 or not allocation.assigned[memory.index])
        { return Result::Error(BackendError::BridgeInvalid); }
        index = RegisterEncoding(allocation.physical[memory.index]);
        if (index == 4) { return Result::Error(BackendError::InvalidEncoding); }
    }
    int scale = ScaleBits(memory.scale);
    if (scale < 0) { return Result::Error(BackendError::InvalidEncoding); }
    int regCode = RegisterEncoding(reg);
    int rex = 64;
    if (width == 8) {
        rex = rex + 8;
    }
    if (regCode >= 8) {
        rex = rex + 4;
    }
    if (index >= 8) {
        rex = rex + 2;
    }
    if (base >= 8) {
        rex = rex + 1;
    }
    if (rex != 64) {
        WriteByte(ref writer, rex) ?;
    }
    WriteByte(ref writer, opcode) ?;
    int mode = 0;
    if (memory.displacement != 0 or base % 8 == 5)
    {
        if (memory.displacement >= - 128 and memory.displacement <= 127)
        {
            mode = 1;
        }
        else {
            mode = 2;
        }
    }
    bool sib = index >= 0 or base % 8 == 4;
    int rm = base % 8;
    if (sib) {
        rm = 4;
    }
    WriteByte(ref writer, mode * 64 +(regCode % 8) * 8 + rm) ?;
    if (sib)
    {
        int indexField = 4;
        if (index >= 0) {
            indexField = index % 8;
        }
        WriteByte(ref writer, scale * 64 + indexField * 8 + base % 8) ?;
    }
    if (mode == 1)
    {
        int displacement = memory.displacement % 256;
        if (displacement < 0) {
            displacement = displacement + 256;
        }
        WriteByte(ref writer, displacement) ?;
    }
    if (mode == 2) {
        WriteI32LE(ref writer, memory.displacement) ?;
    }
    return Result::Ok();
}
Result<void, BackendError> WriteStackReg(
ref ByteWriter writer, ref const FinalizedFrame frame,
int opcode, Register reg, MachineOperand slot, int width)
{
    if (slot.kind != OperandKind::Slot or slot.id < 0 or slot.id >= 64 or
    frame.slotOffsets[slot.id] < 0 or(width != 4 and width != 8))
    { return Result::Error(BackendError::UnsupportedInstruction); }
    int displacement = frame.slotOffsets[slot.id];
    int regCode = RegisterEncoding(reg);
    int rex = 64;
    if (width == 8) {
        rex = rex + 8;
    }
    if (regCode >= 8) {
        rex = rex + 4;
    }
    if (rex != 64) {
        WriteByte(ref writer, rex) ?;
    }
    WriteByte(ref writer, opcode) ?;
    if (displacement <= 127)
    {
        WriteByte(ref writer, 64 +(regCode % 8) * 8 + 4) ?;
        WriteByte(ref writer, 36) ?;
        WriteByte(ref writer, displacement) ?;
    }
    else
    {
        WriteByte(ref writer, 128 +(regCode % 8) * 8 + 4) ?;
        WriteByte(ref writer, 36) ?;
        WriteI32LE(ref writer, displacement) ?;
    }
    return Result::Ok();
}
Result<void, BackendError> WriteStackAdjustment(ref ByteWriter writer, bool subtract, int bytes)
{
    if (bytes == 0) { return Result::Ok(); }
    if (bytes < 0) { return Result::Error(BackendError::InvalidEncoding); }
    WriteByte(ref writer, 72) ?;
    if (bytes <= 127)
    {
        WriteByte(ref writer, 131) ?;
        if (subtract) {
            WriteByte(ref writer, 236) ?;
        }
        else {
            WriteByte(ref writer, 196) ?;
        }
        WriteByte(ref writer, bytes) ?;
    }
    else
    {
        WriteByte(ref writer, 129) ?;
        if (subtract) {
            WriteByte(ref writer, 236) ?;
        }
        else {
            WriteByte(ref writer, 196) ?;
        }
        WriteI32LE(ref writer, bytes) ?;
    }
    return Result::Ok();
}
Result<int, BackendError> ParseI32Literal(
ref const BridgeReader reader, BridgeText text)
{
    if (text.length == 0 or text.length > 11)
    { return Result::Error(BackendError::InvalidEncoding); }
    int index = text.offset;
    int end = text.offset + text.length;
    bool negative = reader.data[index] == 45;
    if (negative) {
        index = index + 1;
    }
    if (index == end) { return Result::Error(BackendError::InvalidEncoding); }
    int value = 0;
    while (index < end) bounded(11)
    {
        int digit = reader.data[index] as int;
        if (digit < 48 or digit > 57)
        { return Result::Error(BackendError::InvalidEncoding); }
        digit = digit - 48;
        if (negative)
        {
            if (value < - 214748364 or
            (value == - 214748364 and digit > 8))
            { return Result::Error(BackendError::InvalidEncoding); }
            value = value * 10 - digit;
        }
        else
        {
            if (value >(2147483647 - digit) / 10)
            { return Result::Error(BackendError::InvalidEncoding); }
            value = value * 10 + digit;
        }
        index = index + 1;
    }
    return Result::Ok(value);
}
Result<void, BackendError> WriteMovImmediate(
ref ByteWriter writer, Register destination, int value, int width)
{
    if (width != 1 and width != 4)
    { return Result::Error(BackendError::UnsupportedInstruction); }
    int code = RegisterEncoding(destination);
    WriteRex(ref writer, false, 0, code) ?;
    if (width == 1)
    {
        if (value < - 128 or value > 255)
        { return Result::Error(BackendError::InvalidEncoding); }
        WriteByte(ref writer, 176 + code % 8) ?;
        if (value < 0) {
            value = value + 256;
        }
        WriteByte(ref writer, value) ?;
    }
    else
    {
        WriteByte(ref writer, 184 + code % 8) ?;
        WriteI32LE(ref writer, value) ?;
    }
    return Result::Ok();
}
Result<void, BackendError> WriteCompareImmediate(
ref ByteWriter writer, Register left, int value, int width)
{
    if (width != 4) { return Result::Error(BackendError::UnsupportedInstruction); }
    int code = RegisterEncoding(left);
    WriteRex(ref writer, false, 7, code) ?;
    WriteByte(ref writer, 129) ?;
    WriteByte(ref writer, 192 + 7 * 8 + code % 8) ?;
    WriteI32LE(ref writer, value) ?;
    return Result::Ok();
}
int ConditionEncoding(Condition condition)
{
    return match (condition)
    {
        Condition::None => - 1,
        Condition::Equal => 4,
        Condition::NotEqual => 5,
        Condition::Less => 12,
        Condition::LessEqual => 14,
        Condition::Greater => 15,
        Condition::GreaterEqual => 13,
        Condition::Below => 2,
        Condition::BelowEqual => 6,
        Condition::Above => 7,
        Condition::AboveEqual => 3,
        Condition::Overflow => 0,
        Condition::Carry => 2,
    };
}
Result<void, BackendError> AddFixup(
ref ByteWriter writer, ref EncodingPlan plan, int target)
{
    if (target < 0 or target >= 128 or plan.fixupCount >= 256)
    { return Result::Error(BackendError::InvalidEncoding); }
    plan.fixups[plan.fixupCount] = BranchFixup{writer.offset, target};
    plan.fixupCount = plan.fixupCount + 1;
    WriteI32LE(ref writer, 0) ?;
    return Result::Ok();
}
Result<void, BackendError> AddWorkspaceFixup(
ref ByteWriter writer, ref EncodingWorkspace workspace, int target)
{
    if (target < 0 or target >= Len(workspace.blockOffsets))
    { return Result::Error(BackendError::InvalidEncoding); }
    if (workspace.fixupCount >= Len(workspace.fixups))
    { return Result::Error(BackendError::CapacityExceeded); }
    workspace.fixups[workspace.fixupCount] = BranchFixup{writer.offset, target};
    workspace.fixupCount += 1;
    WriteI32LE(ref writer, 0) ?;
    return Result::Ok();
}
Result<void, BackendError> EmitInstruction(
ref ByteWriter writer, ref const BridgeReader reader,
ref const Allocation allocation, ref const FinalizedFrame frame,
MachineInstruction instruction)
{
    if (instruction.op == Opcode::Trap)
    {
        WriteByte(ref writer, 15) ?;
        WriteByte(ref writer, 11) ?;
        return Result::Ok();
    }
    if (instruction.op == Opcode::Lea or instruction.op == Opcode::Load)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        int opcode = 141;
        if (instruction.op == Opcode::Load) {
            opcode = 139;
            if (instruction.width == 1) {
                opcode = 138;
            }
        }
        if (instruction.source0.kind == OperandKind::Slot)
        {
            return WriteStackReg(ref writer, ref const frame, opcode,
            destination, instruction.source0, instruction.width);
        }
        return WriteMemoryReg(ref writer, ref const allocation, opcode,
        destination, instruction.source0, instruction.width);
    }
    if (instruction.op == Opcode::Store)
    {
        Register source = ResolveRegister(ref const allocation, instruction.source0) ?;
        int opcode = 137;
        if (instruction.width == 1) {
            opcode = 136;
        }
        if (instruction.destination.kind == OperandKind::Slot)
        {
            return WriteStackReg(ref writer, ref const frame, opcode,
            source, instruction.destination, instruction.width);
        }
        return WriteMemoryReg(ref writer, ref const allocation, opcode,
        source, instruction.destination, instruction.width);
    }
    if (instruction.op == Opcode::Mov)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        if (instruction.source0.kind == OperandKind::Immediate)
        {
            int value = ParseI32Literal(ref const reader, instruction.source0.literal) ?;
            return WriteMovImmediate(ref writer, destination, value, instruction.width);
        }
        Register source = ResolveRegister(ref const allocation, instruction.source0) ?;
        int opcode = 137;
        if (instruction.width == 1) {
            opcode = 136;
        }
        return WriteRegReg(ref writer, opcode, destination, source, instruction.width);
    }
    if (instruction.op == Opcode::Add or instruction.op == Opcode::Sub or
    instruction.op == Opcode::Imul)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        Register source = ResolveRegister(ref const allocation, instruction.source0) ?;
        if (instruction.op == Opcode::Imul)
        {
            WriteRex(ref writer, instruction.width == 8,
            RegisterEncoding(destination), RegisterEncoding(source)) ?;
            WriteByte(ref writer, 15) ?;
            WriteByte(ref writer, 175) ?;
            WriteByte(ref writer, 192 +
            (RegisterEncoding(destination) % 8) * 8 + RegisterEncoding(source) % 8) ?;
            return Result::Ok();
        }
        int opcode = 1;
        if (instruction.op == Opcode::Sub) {
            opcode = 41;
        }
        return WriteRegReg(ref writer, opcode, destination, source, instruction.width);
    }
    if (instruction.op == Opcode::Cmp or instruction.op == Opcode::Test)
    {
        Register left = ResolveRegister(ref const allocation, instruction.source0) ?;
        if (instruction.source1.kind == OperandKind::Immediate)
        {
            if (instruction.op != Opcode::Cmp)
            { return Result::Error(BackendError::UnsupportedInstruction); }
            int value = ParseI32Literal(ref const reader, instruction.source1.literal) ?;
            return WriteCompareImmediate(ref writer, left, value, instruction.width);
        }
        Register right = ResolveRegister(ref const allocation, instruction.source1) ?;
        int opcode = 57;
        if (instruction.op == Opcode::Test) {
            opcode = 133;
            if (instruction.width == 1) {
                opcode = 132;
            }
        }
        if (instruction.op == Opcode::Cmp and instruction.width == 1)
        {
            opcode = 56;
        }
        return WriteRegReg(ref writer, opcode, left, right, instruction.width);
    }
    if (instruction.op == Opcode::Setcc)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        int condition = ConditionEncoding(instruction.condition);
        if (condition < 0) { return Result::Error(BackendError::InvalidEncoding); }
        int code = RegisterEncoding(destination);
        WriteRex(ref writer, false, 0, code) ?;
        WriteByte(ref writer, 15) ?;
        WriteByte(ref writer, 144 + condition) ?;
        WriteByte(ref writer, 192 + code % 8) ?;
        return Result::Ok();
    }
    return Result::Error(BackendError::UnsupportedInstruction);
}
// Callers must discard output on Error; the published count is transactional.
Result<int, BackendError> EncodeFunctionWithWorkspace(
ref const BridgeReader reader, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame, Span<byte> output, ref EncodingWorkspace plan)
{
    ByteWriter writer = ByteWriter{output, 0};
    if (function.blockCount < 0 or function.blockCount > Len(plan.blockOffsets))
    { return Result::Error(BackendError::CapacityExceeded); }
    int requiredFixups = 0;
    for (bi in 0 .. function.blockCount)
    {
        if (function.blocks[bi].terminator == Opcode::Jmp) {
            requiredFixups += 1;
        }
        if (function.blocks[bi].terminator == Opcode::Jcc) {
            requiredFixups += 2;
        }
    }
    if (requiredFixups > Len(plan.fixups))
    { return Result::Error(BackendError::CapacityExceeded); }
    plan.fixupCount = 0;
    WriteStackAdjustment(ref writer, true, frame.byteCount) ?;
    for (bi in 0 .. function.blockCount)
    {
        MachineBlock block = function.blocks[bi];
        plan.blockOffsets[bi] = writer.offset;
        for (ii in 0 .. block.instructionCount)
        {
            EmitInstruction(ref writer, ref const reader, ref const allocation,
            ref const frame, function.instructions[block.firstInstruction + ii]) ?;
        }
        match (block.terminator)
        {
            Opcode::Jmp => {
                WriteByte(ref writer, 233) ?;
                AddWorkspaceFixup(ref writer, ref plan, block.trueBlock) ?;
            }
            Opcode::Jcc => {
                int condition = ConditionEncoding(block.condition);
                if (condition < 0) { return Result::Error(BackendError::InvalidEncoding); }
                WriteByte(ref writer, 15) ?;
                WriteByte(ref writer, 128 + condition) ?;
                AddWorkspaceFixup(ref writer, ref plan, block.trueBlock) ?;
                WriteByte(ref writer, 233) ?;
                AddWorkspaceFixup(ref writer, ref plan, block.falseBlock) ?;
            }
            Opcode::Ret => {
                WriteStackAdjustment(ref writer, false, frame.byteCount) ?;
                WriteByte(ref writer, 195) ?;
            }
            Opcode::Trap => { }
            Opcode::None => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Mov => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Load => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Store => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Lea => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Add => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Sub => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Imul => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Umul => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Cmp => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Test => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Setcc => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Call => { return Result::Error(BackendError::UnsupportedCallLowering); }
        }
    }
    for (i in 0 .. plan.fixupCount)
    {
        BranchFixup fixup = plan.fixups[i];
        if (fixup.targetBlock >= function.blockCount)
        { return Result::Error(BackendError::InvalidEncoding); }
        int displacement = plan.blockOffsets[fixup.targetBlock] -(fixup.patchOffset + 4);
        PatchI32LE(ref writer, fixup.patchOffset, displacement) ?;
    }
    return Result::Ok(writer.offset);
}
// Compatibility entry point retains the original bounded inline scratch budget.
Result<int, BackendError> EncodeFunction(
ref const BridgeReader reader, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame, Span<byte> output)
{
    EncodingPlan storage = EmptyEncodingPlan();
    EncodingWorkspace workspace = EncodingWorkspace {
        Span(storage.blockOffsets), Span(storage.fixups), 0
    };
    return EncodeFunctionWithWorkspace(ref const reader, ref const function,
    ref const allocation, ref const frame, output, ref workspace);
}
Result<int, BackendError> EmitFunctionWithWorkspace(
ReadOnlySpan<byte> artifact, int ordinal, Span<byte> output,
Span<int> blockOffsets, Span<BranchFixup> fixups)
{
    BackendFunction function = EmptyFunction();
    DecodeFunction(artifact, ordinal, ref function) ?;
    LayoutLoweredBlocks(ref function) ?;
    Allocation allocation = EmptyAllocation();
    AllocateRegisters(ref const function, ref allocation) ?;
    if (allocation.callCount > 0) {
        PlanFunctionCalls(ref const function, ref allocation) ?;
        FinalizedFrame concrete = EmptyFinalizedFrame();
        match (QualifyFunctionFrame(ref const function, ref const allocation, ref concrete)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
        }
        return Result::Error(BackendError::UnsupportedCallLowering);
    }
    FinalizedFrame frame = FinalizeFrame(ref const function) ?;
    BridgeReader reader = BridgeReader{artifact, 0};
    EncodingWorkspace workspace = EncodingWorkspace{blockOffsets, fixups, 0};
    return EncodeFunctionWithWorkspace(ref const reader, ref const function,
    ref const allocation, ref const frame, output, ref workspace);
}
Result<int, BackendError> EmitFunction(
ReadOnlySpan<byte> artifact, int ordinal, Span<byte> output)
{
    BackendFunction function = EmptyFunction();
    DecodeFunction(artifact, ordinal, ref function) ?;
    LayoutLoweredBlocks(ref function) ?;
    Allocation allocation = EmptyAllocation();
    AllocateRegisters(ref const function, ref allocation) ?;
    if (allocation.callCount > 0) {
        PlanFunctionCalls(ref const function, ref allocation) ?;
        FinalizedFrame concrete = EmptyFinalizedFrame();
        match (QualifyFunctionFrame(ref const function, ref const allocation, ref concrete)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
        }
        return Result::Error(BackendError::UnsupportedCallLowering);
    }
    FinalizedFrame frame = FinalizeFrame(ref const function) ?;
    BridgeReader reader = BridgeReader{artifact, 0};
    return EncodeFunction(ref const reader, ref const function, ref const allocation,
    ref const frame, output);
}
void BackendFacts()
{
    Assert.Concept<NoAllocation>(LayoutLoweredBlocks, "fixed block and instruction storage");
    Assert.Concept<NoAllocation>(WriteByte, "bounded caller-supplied output");
    Assert.Concept<NoAllocation>(AllocateRegisters, "fixed interval and liveness storage");
    Assert.Concept<NoAllocation>(PlanAllocatedCall, "caller supplied preservation records");
    Assert.Concept<NoAllocation>(PlanFunctionCalls, "one bounded call plan at a time");
    Assert.Concept<NoAllocation>(EncodeFunctionWithWorkspace, "caller-supplied encoding scratch");
    Assert.Concept<NoAllocation>(EmitFunctionWithWorkspace, "caller-supplied phase-local scratch");
    Assert.Concept<NoAllocation>(EncodeFunction, "bounded direct AMD64 encoding");
    Assert.Concept<NoAllocation>(EmitFunction, "artifact to bytes uses fixed storage");
}

// This pins self-contained in-memory records, independently of the explicit
// field-by-field wire codec above. PlainData is not the wire representation.
void CheckBridgeRepresentation()
{
    Assert.Concept<PlainData>(WireHeader, "bridge header carries only data");
    Assert.Concept<PlainData>(WireMachineFrame, "bridge frame carries only data");
    Assert.Concept<PlainData>(WireMachineOperand, "bridge operand carries only data");
}
