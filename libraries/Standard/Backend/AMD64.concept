module Standard.Backend.AMD64;
profile Core;
import Standard.Backend.AMD64.Aggregates;
Result<void, BackendError> EmitInstruction(
ref ByteWriter writer, ref const BridgeReader reader,
ref const Allocation allocation, ref const FinalizedFrame frame,
MachineInstruction instruction)
{
    if (instruction.op == Opcode::Trap)
    {
        WriteByte(ref writer, 15) ?;
        WriteByte(ref writer, 11) ?;
        return Result::Ok();
    }
    if (instruction.op == Opcode::Lea or instruction.op == Opcode::Load)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        int opcode = 141;
        if (instruction.op == Opcode::Load) {
            opcode = 139;
            if (instruction.width == 1) {
                opcode = 138;
            }
        }
        if (instruction.source0.kind == OperandKind::Slot)
        {
            return WriteStackReg(ref writer, ref const frame, opcode,
            destination, instruction.source0, instruction.width);
        }
        return WriteMemoryReg(ref writer, ref const allocation, opcode,
        destination, instruction.source0, instruction.width);
    }
    if (instruction.op == Opcode::Store)
    {
        Register source = ResolveRegister(ref const allocation, instruction.source0) ?;
        int opcode = 137;
        if (instruction.width == 1) {
            opcode = 136;
        }
        if (instruction.destination.kind == OperandKind::Slot)
        {
            return WriteStackReg(ref writer, ref const frame, opcode,
            source, instruction.destination, instruction.width);
        }
        return WriteMemoryReg(ref writer, ref const allocation, opcode,
        source, instruction.destination, instruction.width);
    }
    if (instruction.op == Opcode::Mov)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        if (instruction.source0.kind == OperandKind::Memory and instruction.source0.base == - 1 and
        TextEquals(ref const reader, instruction.source0.region, "incoming-arg")) {
            if (instruction.source0.displacement < 40 or instruction.source0.displacement > 64 or frame.byteCount > 65528) {
                return Result::Error(BackendError::InvalidEncoding);
            }
            return WriteRSPReg(ref writer, true, destination, frame.byteCount + instruction.source0.displacement,
            instruction.width);
        }
        if (instruction.source0.kind == OperandKind::Immediate)
        {
            int value = ParseI32Literal(ref const reader, instruction.source0.literal) ?;
            return WriteMovImmediate(ref writer, destination, value, instruction.width);
        }
        Register source = ResolveRegister(ref const allocation, instruction.source0) ?;
        int opcode = 137;
        if (instruction.width == 1) {
            opcode = 136;
        }
        return WriteRegReg(ref writer, opcode, destination, source, instruction.width);
    }
    if (instruction.op == Opcode::Add or instruction.op == Opcode::Sub or
    instruction.op == Opcode::Imul)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        Register source = ResolveRegister(ref const allocation, instruction.source0) ?;
        if (instruction.op == Opcode::Imul)
        {
            WriteRex(ref writer, instruction.width == 8,
            RegisterEncoding(destination), RegisterEncoding(source)) ?;
            WriteByte(ref writer, 15) ?;
            WriteByte(ref writer, 175) ?;
            WriteByte(ref writer, 192 +
            (RegisterEncoding(destination) % 8) * 8 + RegisterEncoding(source) % 8) ?;
            return Result::Ok();
        }
        int opcode = 1;
        if (instruction.op == Opcode::Sub) {
            opcode = 41;
        }
        return WriteRegReg(ref writer, opcode, destination, source, instruction.width);
    }
    if (instruction.op == Opcode::Cmp or instruction.op == Opcode::Test)
    {
        Register left = ResolveRegister(ref const allocation, instruction.source0) ?;
        if (instruction.source1.kind == OperandKind::Immediate)
        {
            if (instruction.op != Opcode::Cmp)
            { return Result::Error(BackendError::UnsupportedInstruction); }
            int value = ParseI32Literal(ref const reader, instruction.source1.literal) ?;
            return WriteCompareImmediate(ref writer, left, value, instruction.width);
        }
        Register right = ResolveRegister(ref const allocation, instruction.source1) ?;
        int opcode = 57;
        if (instruction.op == Opcode::Test) {
            opcode = 133;
            if (instruction.width == 1) {
                opcode = 132;
            }
        }
        if (instruction.op == Opcode::Cmp and instruction.width == 1)
        {
            opcode = 56;
        }
        return WriteRegReg(ref writer, opcode, left, right, instruction.width);
    }
    if (instruction.op == Opcode::Setcc)
    {
        Register destination = ResolveRegister(ref const allocation, instruction.destination) ?;
        int condition = ConditionEncoding(instruction.condition);
        if (condition < 0) { return Result::Error(BackendError::InvalidEncoding); }
        int code = RegisterEncoding(destination);
        if (code >= 4 and code < 8) {
            WriteByte(ref writer, 64) ?;
        }
        else {
            WriteRex(ref writer, false, 0, code) ?;
        }
        WriteByte(ref writer, 15) ?;
        WriteByte(ref writer, 144 + condition) ?;
        WriteByte(ref writer, 192 + code % 8) ?;
        return Result::Ok();
    }
    return Result::Error(BackendError::UnsupportedInstruction);
}
// Callers must discard output on Error; the published count is transactional.
Result<void, BackendError> EncodeFunctionIntoWriter(
ref ByteWriter writer, ref const BridgeReader reader, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame, ref EncodingWorkspace plan)
{
    if (function.blockCount < 0 or function.blockCount > Len(plan.blockOffsets))
    { return Result::Error(BackendError::CapacityExceeded); }
    int requiredFixups = 0;
    for (bi in 0 .. function.blockCount)
    {
        if (function.blocks[bi].terminator == Opcode::Jmp) {
            requiredFixups += 1;
        }
        if (function.blocks[bi].terminator == Opcode::Jcc) {
            requiredFixups += 2;
        }
    }
    if (requiredFixups > Len(plan.fixups))
    { return Result::Error(BackendError::CapacityExceeded); }
    plan.fixupCount = 0;
    Liveness live = EmptyLiveness();
    if (plan.allowCalls) {
        ComputeLiveness(ref const function, ref live) ?;
        for (a in 0 .. frame.prologueCount) {
            EmitFrameAction(ref writer, frame.prologue[a]) ?;
        }
    } else {
        WriteStackAdjustment(ref writer, true, frame.byteCount) ?;
    }
    for (bi in 0 .. function.blockCount)
    {
        MachineBlock block = function.blocks[bi];
        plan.blockOffsets[bi] = writer.offset;
        for (ii in 0 .. block.instructionCount)
        {
            int position = block.firstInstruction + ii;
            MachineInstruction instruction = function.instructions[position];
            if (instruction.op == Opcode::Call) {
                EmitAllocatedCall(ref writer, ref const function, ref const allocation, ref const live,
                position, ref const frame, ref plan) ?;
            } else {
                EmitInstruction(ref writer, ref const reader, ref const allocation, ref const frame,
                instruction) ?;
            }
        }
        match (block.terminator)
        {
            Opcode::Jmp => {
                WriteByte(ref writer, 233) ?;
                AddWorkspaceFixup(ref writer, ref plan, block.trueBlock) ?;
            }
            Opcode::Jcc => {
                int condition = ConditionEncoding(block.condition);
                if (condition < 0) { return Result::Error(BackendError::InvalidEncoding); }
                WriteByte(ref writer, 15) ?;
                WriteByte(ref writer, 128 + condition) ?;
                AddWorkspaceFixup(ref writer, ref plan, block.trueBlock) ?;
                WriteByte(ref writer, 233) ?;
                AddWorkspaceFixup(ref writer, ref plan, block.falseBlock) ?;
            }
            Opcode::Ret => {
                if (plan.allowCalls) {
                    for (a in 0 .. frame.epilogueCount) {
                        EmitFrameAction(ref writer, frame.epilogue[a]) ?;
                    }
                }
                else {
                    WriteStackAdjustment(ref writer, false, frame.byteCount) ?;
                    WriteByte(ref writer, 195) ?;
                }
            }
            Opcode::Trap => { }
            Opcode::None => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Mov => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Load => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Store => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Lea => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Add => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Sub => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Imul => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Umul => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Cmp => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Test => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Setcc => { return Result::Error(BackendError::UnsupportedInstruction); }
            Opcode::Call => { return Result::Error(BackendError::UnsupportedCallLowering); }
        }
    }
    for (i in 0 .. plan.fixupCount)
    {
        BranchFixup fixup = plan.fixups[i];
        if (fixup.targetBlock >= function.blockCount)
        { return Result::Error(BackendError::InvalidEncoding); }
        int displacement = plan.blockOffsets[fixup.targetBlock] -(fixup.patchOffset + 4);
        PatchI32LE(ref writer, fixup.patchOffset, displacement) ?;
    }
    return Result::Ok();
}
Result<int, BackendError> EncodeFunctionWithWorkspace(ref const BridgeReader reader, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame, Span<byte> output, ref EncodingWorkspace plan) {
    ByteWriter writer = ByteWriter{output, 0};
    EncodeFunctionIntoWriter(ref writer, ref const reader, ref const function, ref const allocation,
    ref const frame, ref plan) ?;
    return Result::Ok(writer.offset);
}
// Compatibility entry point retains the original bounded inline scratch budget.
Result<int, BackendError> EncodeFunction(
ref const BridgeReader reader, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame, Span<byte> output)
{
    EncodingPlan storage = EmptyEncodingPlan();
    CallFixup[1] unused =[EmptyCallFixup() ...];
    EncodingWorkspace workspace = EncodingWorkspace {
        Span(storage.blockOffsets), Span(storage.fixups), 0, Span(unused), 0, 0, false
    };
    return EncodeFunctionWithWorkspace(ref const reader, ref const function,
    ref const allocation, ref const frame, output, ref workspace);
}
Result<int, BackendError> EmitFunctionWithWorkspace(
ReadOnlySpan<byte> artifact, int ordinal, Span<byte> output,
Span<int> blockOffsets, Span<BranchFixup> fixups)
{
    BackendFunction function = EmptyFunction();
    DecodeFunction(artifact, ordinal, ref function) ?;
    LayoutLoweredBlocks(ref function) ?;
    Allocation allocation = EmptyAllocation();
    AllocateRegisters(ref const function, ref allocation) ?;
    if (allocation.callCount > 0) {
        PlanFunctionCalls(ref const function, ref allocation) ?;
        FinalizedFrame concrete = EmptyFinalizedFrame();
        match (QualifyFunctionFrame(ref const function, ref const allocation, ref concrete)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
        }
        return Result::Error(BackendError::UnsupportedCallLowering);
    }
    FinalizedFrame frame = FinalizeFrame(ref const function) ?;
    BridgeReader reader = BridgeReader{artifact, 0};
    CallFixup[1] unused =[EmptyCallFixup() ...];
    EncodingWorkspace workspace = EncodingWorkspace {
        blockOffsets, fixups, 0, Span(unused), 0, 0, false
    };
    return EncodeFunctionWithWorkspace(ref const reader, ref const function,
    ref const allocation, ref const frame, output, ref workspace);
}
Result<int, BackendError> EmitFunction(
ReadOnlySpan<byte> artifact, int ordinal, Span<byte> output)
{
    BackendFunction function = EmptyFunction();
    DecodeFunction(artifact, ordinal, ref function) ?;
    LayoutLoweredBlocks(ref function) ?;
    Allocation allocation = EmptyAllocation();
    AllocateRegisters(ref const function, ref allocation) ?;
    if (allocation.callCount > 0) {
        PlanFunctionCalls(ref const function, ref allocation) ?;
        FinalizedFrame concrete = EmptyFinalizedFrame();
        match (QualifyFunctionFrame(ref const function, ref const allocation, ref concrete)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
        }
        return Result::Error(BackendError::UnsupportedCallLowering);
    }
    FinalizedFrame frame = FinalizeFrame(ref const function) ?;
    BridgeReader reader = BridgeReader{artifact, 0};
    return EncodeFunction(ref const reader, ref const function, ref const allocation,
    ref const frame, output);
}
void BackendFacts()
{
    Assert.Concept<NoAllocation>(LayoutLoweredBlocks, "fixed block and instruction storage");
    Assert.Concept<NoAllocation>(WriteByte, "bounded caller-supplied output");
    Assert.Concept<NoAllocation>(AllocateRegisters, "fixed interval and liveness storage");
    Assert.Concept<NoAllocation>(PlanAllocatedCall, "caller supplied preservation records");
    Assert.Concept<NoAllocation>(PlanFunctionCalls, "one bounded call plan at a time");
    Assert.Concept<NoAllocation>(EncodeFunctionWithWorkspace, "caller-supplied encoding scratch");
    Assert.Concept<NoAllocation>(EmitFunctionWithWorkspace, "caller-supplied phase-local scratch");
    Assert.Concept<NoAllocation>(EncodeFunction, "bounded direct AMD64 encoding");
    Assert.Concept<NoAllocation>(EmitFunction, "artifact to bytes uses fixed storage");
}
Result<int, NativeError> FindNativeSymbol(ref const BridgeReader reader, ref const NativeImage image,
BridgeText identity) {
    if (image.symbolCount < 0 or image.symbolCount > 128) {
        return Result::Error(NativeError::InvalidInput);
    }
    int found = - 1;
    if (identity.offset < 0 or identity.length <= 0 or identity.offset > Len(reader.data) or identity.length > Len(reader.data) - identity.offset) {
        return Result::Error(NativeError::UnresolvedSymbol);
    }
    for (i in 0 .. image.symbolCount) {
        BridgeText candidate = image.symbols[i].identity;
        if (candidate.offset < 0 or candidate.length <= 0 or candidate.offset > Len(reader.data) or candidate.length > Len(reader.data) - candidate.offset) {
            return Result::Error(NativeError::InvalidInput);
        }
        if (SameText(ref const reader, image.symbols[i].identity, identity)) {
            if (found >= 0) { return Result::Error(NativeError::DuplicateSymbol); }
            found = i;
        }
    }
    if (found < 0) { return Result::Error(NativeError::UnresolvedSymbol); }
    return Result::Ok(found);
}
Result<void, NativeError> ValidateCallPatch(ref const NativeImage image, CallFixup fixup, Span<byte> bytes) {
    if (image.symbolCount < 0 or image.symbolCount > 128 or image.byteCount < 5) {
        return Result::Error(NativeError::MalformedPatch);
    }
    if (fixup.kind != CallFixupKind::Rel32Call or fixup.sourceOrdinal < 0 or fixup.sourceOrdinal >= image.symbolCount or
    fixup.callOffset < 0 or fixup.callOffset > image.byteCount - 5 or fixup.patchOffset != fixup.callOffset + 1 or image.byteCount > Len(bytes)) {
        return Result::Error(NativeError::MalformedPatch);
    }
    NativeSymbol source = image.symbols[fixup.sourceOrdinal];
    if (source.offset < 0 or source.size < 5 or source.offset > image.byteCount or source.size > image.byteCount - source.offset) {
        return Result::Error(NativeError::MalformedPatch);
    }
    if (fixup.callOffset < source.offset or fixup.callOffset > source.offset + source.size - 5 or bytes[fixup.callOffset] as int != 232) {
        return Result::Error(NativeError::MalformedPatch);
    }
    return Result::Ok();
}
// Validate all patch sites and targets before touching bytes. Both forward and
// backward calls use this single pass after declaration-order body emission.
Result<void, NativeError> ResolveNativeCalls(ref const BridgeReader reader, ref NativeImage image, Span<byte> bytes) {
    if (image.finalized or image.symbolCount < 0 or image.symbolCount > 128 or image.fixupCount < 0 or image.fixupCount > 512 or image.byteCount < 0 or image.byteCount > Len(bytes)) {
        return Result::Error(NativeError::InvalidInput);
    }
    int end = 0;
    for (i in 0 .. image.symbolCount) {
        NativeSymbol symbol = image.symbols[i];
        if (symbol.ordinal != i or symbol.offset != end or symbol.size <= 0 or symbol.size > image.byteCount - end or symbol.calls < 0 or symbol.calls > 512) {
            return Result::Error(NativeError::InvalidInput);
        }
        FindNativeSymbol(ref const reader, ref const image, symbol.identity) ?;
        end += symbol.size;
    }
    if (end != image.byteCount) { return Result::Error(NativeError::InvalidInput); }
    int[128] counts =[0 ...];
    for (i in 0 .. image.fixupCount) {
        CallFixup fixup = image.fixups[i];
        ValidateCallPatch(ref const image, fixup, bytes) ?;
        counts[fixup.sourceOrdinal] += 1;
        int source = FindNativeSymbol(ref const reader, ref const image, fixup.source) ?;
        if (fixup.resolved or source != fixup.sourceOrdinal) {
            return Result::Error(NativeError::MalformedPatch);
        }
        if (i > 0) {
            if (fixup.callOffset < image.fixups[i - 1].callOffset + 5) {
                return Result::Error(NativeError::MalformedPatch);
            }
        }
        for (b in 0 .. 4) {
            if (bytes[fixup.patchOffset + b] != 0) {
                return Result::Error(NativeError::MalformedPatch);
            }
        }
        int target = FindNativeSymbol(ref const reader, ref const image, fixup.target) ?;
        CallDisplacement(image.symbols[target].offset as uint64, fixup.callOffset as uint64) ?;
    }
    ByteWriter writer = ByteWriter{bytes, image.byteCount};
    for (i in 0 .. image.symbolCount) {
        if (counts[i] != image.symbols[i].calls) {
            return Result::Error(NativeError::UnresolvedFixup);
        }
    }
    for (i in 0 .. image.fixupCount) {
        CallFixup fixup = image.fixups[i];
        int target = FindNativeSymbol(ref const reader, ref const image, fixup.target) ?;
        int delta = CallDisplacement(image.symbols[target].offset as uint64, fixup.callOffset as uint64) ?;
        match (PatchI32LE(ref writer, fixup.patchOffset, delta)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(NativeError::MalformedPatch); }
        }
        image.fixups[i] = CallFixup {
            fixup.kind, fixup.sourceOrdinal, fixup.source, fixup.target, fixup.callOffset, fixup.patchOffset,
            delta, true
        };
    }
    image.finalized = true;
    return ValidateNativeImage(ref const reader, ref const image, bytes);
}
Result<void, NativeError> ValidateNativeImage(ref const BridgeReader reader, ref const NativeImage image,
Span<byte> bytes) {
    if (not image.finalized or image.fixupCount < 0 or image.fixupCount > 512) {
        return Result::Error(NativeError::UnresolvedFixup);
    }
    if (image.symbolCount < 0 or image.symbolCount > 128 or image.byteCount < 0 or image.byteCount > Len(bytes)) {
        return Result::Error(NativeError::InvalidInput);
    }
    int end = 0;
    for (i in 0 .. image.symbolCount) {
        NativeSymbol symbol = image.symbols[i];
        if (symbol.ordinal != i or symbol.offset != end or symbol.size <= 0 or symbol.size > image.byteCount - end or symbol.calls < 0 or symbol.calls > 512) {
            return Result::Error(NativeError::InvalidInput);
        }
        FindNativeSymbol(ref const reader, ref const image, symbol.identity) ?;
        end += symbol.size;
    }
    if (end != image.byteCount) { return Result::Error(NativeError::InvalidInput); }
    int[128] counts =[0 ...];
    for (i in 0 .. image.fixupCount) {
        CallFixup fixup = image.fixups[i];
        if (not fixup.resolved) { return Result::Error(NativeError::UnresolvedFixup); }
        ValidateCallPatch(ref const image, fixup, bytes) ?;
        int source = FindNativeSymbol(ref const reader, ref const image, fixup.source) ?;
        if (source != fixup.sourceOrdinal) {
            return Result::Error(NativeError::MalformedPatch);
        }
        if (i > 0) {
            if (fixup.callOffset < image.fixups[i - 1].callOffset + 5) {
                return Result::Error(NativeError::MalformedPatch);
            }
        }
        counts[fixup.sourceOrdinal] += 1;
        int target = FindNativeSymbol(ref const reader, ref const image, fixup.target) ?;
        int delta = CallDisplacement(image.symbols[target].offset as uint64, fixup.callOffset as uint64) ?;
        if (delta != fixup.displacement) {
            return Result::Error(NativeError::MalformedPatch);
        }
        int remaining = delta;
        for (b in 0 .. 4) {
            int digit = remaining % 256;
            if (digit < 0) {
                digit += 256;
            }
            if (bytes[fixup.patchOffset + b] as int != digit) {
                return Result::Error(NativeError::MalformedPatch);
            }
            remaining =(remaining - digit) / 256;
        }
    }
    for (i in 0 .. image.symbolCount) {
        if (counts[i] != image.symbols[i].calls) {
            return Result::Error(NativeError::UnresolvedFixup);
        }
    }
    return Result::Ok();
}
// Output is scratch until Ok and finalized. Bootstrap callers must never
// publish an image after Error; all code/branch/call patches precede RX.
Result<int, NativeError> EmitModule(ReadOnlySpan<byte> artifact, Span<byte> output, ref NativeImage image) {
    if (Len(artifact) >= 8 and artifact[7] == 54) {
        match (ValidateBorrowMachineBridge(artifact)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(NativeBorrowError(error)); }
        }
        BridgeReader source = BridgeReader{artifact, 0};
        WireObjectModule document = AdmittedObjectDocument(artifact) ?;
        return EmitObjectNativeDocument(ref const source, document, output, ref image, true);
    }
    if (Len(artifact) >= 8) {
        bool object = true;
        for (i in 0 .. 8) {
            if (artifact[i] != ObjectBridgeMagic[i]) {
                object = false;
            }
        }
        if (object) {
            match (ValidateObjectMachineBridge(artifact)) {
                Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
                Result::Ok => { return EmitObjectNativeModule(artifact, output, ref image); }
            }
        }
    }
    if (Len(artifact) >= 8) {
        bool scalar = true;
        for (i in 0 .. 8) {
            if (artifact[i] != ScalarBridgeMagic[i]) {
                scalar = false;
            }
        }
        if (scalar) {
            match (ValidateScalarMachineBridge(artifact)) {
                Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
                Result::Ok => {
                    match (QualifyScalarModule(artifact)) {
                        Result::Error(error) => { return Result::Error(error); }
                        Result::Ok => {
                            return EmitScalarNativeModule(artifact, output, ref image);
                        }
                    }
                }
            }
        }
    }
    image = EmptyNativeImage();
    match (ValidateMachineBridge(artifact)) {
        Result::Ok() => { }
        Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
    }
    BridgeReader reader = BridgeReader{artifact, 0};
    match (ReadBridgeIdentity(ref reader)) {
        Result::Ok() => { }
        Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
    }
    WireMachineModule document = ReadNativeModule(ref reader) ?;
    if (document.Functions.count > 128) {
        return Result::Error(NativeError::CapacityExceeded);
    }
    reader.offset = document.Functions.offset;
    ByteWriter writer = ByteWriter{output, 0};
    EncodingPlan branches = EmptyEncodingPlan();
    EncodingWorkspace workspace = EncodingWorkspace {
        Span(branches.blockOffsets), Span(branches.fixups), 0, Span(image.fixups), 0, 0, true
    };
    for (ordinal in 0 .. document.Functions.count) {
        WireMachineFunction wire = ReadNativeFunction(ref reader) ?;
        BackendFunction function = EmptyFunction();
        match (ProjectWireFunction(ref const reader, wire, ref function)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
        }
        match (LayoutLoweredBlocks(ref function)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
        }
        Allocation allocation = EmptyAllocation();
        match (AllocateRegistersWithPolicy(ref const function, ref allocation, true)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(NativeError::CapacityExceeded); }
        }
        FinalizedFrame frame = EmptyFinalizedFrame();
        match (QualifyFunctionFrame(ref const function, ref const allocation, ref frame)) {
            Result::Ok() => { }
            Result::Error(error) => { return Result::Error(NativeError::FrameFailure); }
        }
        // Large physical adjustments require guard-page probing, not a naked
        // subtraction. Keep that separate production capability explicit.
        if (frame.byteCount >= 4096) {
            return Result::Error(NativeError::StackProbeRequired);
        }
        workspace.functionOrdinal = ordinal;
        int begin = writer.offset;
        // One writer coordinate system for body, branch and call offsets.
        match (EncodeFunctionIntoWriter(ref writer, ref const reader, ref const function, ref const allocation,
        ref const frame, ref workspace)) {
            Result::Ok() => { }
            Result::Error(error) => {
                if (error == BackendError::BufferFull or error == BackendError::CapacityExceeded) {
                    return Result::Error(NativeError::CapacityExceeded);
                }
                return Result::Error(NativeError::UnsupportedEncoding);
            }
        }
        image.symbols[ordinal] = NativeSymbol {
            function.identity, function.name, ordinal, begin, writer.offset - begin, allocation.callCount
        };
        image.symbolCount += 1;
    }
    image.fixupCount = workspace.callCount;
    image.byteCount = writer.offset;
    ResolveNativeCalls(ref const reader, ref image, output) ?;
    return Result::Ok(image.byteCount);
}
Result<WireMachineModule, NativeError> ReadNativeModule(ref BridgeReader reader) {
    return match (ReadWire(ref reader, BridgeType<WireMachineModule>{0})) {
        Result::Ok(value) => Result::Ok(value),
        Result::Error(error) => Result::Error(NativeError::InvalidInput),
    };
}
Result<WireMachineFunction, NativeError> ReadNativeFunction(ref BridgeReader reader) {
    return match (ReadWire(ref reader, BridgeType<WireMachineFunction>{0})) {
        Result::Ok(value) => Result::Ok(value),
        Result::Error(error) => Result::Error(NativeError::InvalidInput),
    };
}
// This pins self-contained in-memory records, independently of the explicit
// field-by-field wire codec above. PlainData is not the wire representation.
void CheckBridgeRepresentation()
{
    Assert.Concept<PlainData>(WireHeader, "bridge header carries only data");
    Assert.Concept<PlainData>(WireMachineFrame, "bridge frame carries only data");
    Assert.Concept<PlainData>(WireMachineOperand, "bridge operand carries only data");
}
Result<void, BackendError> EncodeScalarWireInstruction(ref ByteWriter writer, ref const BridgeReader reader,
WireScalarMachineInstruction instruction, ref const BackendFunction function, ref const Allocation allocation,
ref const FinalizedFrame frame) {
    ScalarRepresentation type = instruction.Representation;
    BridgeReader args = BridgeReader{reader.data, instruction.Args.offset};
    int left = - 1;
    int right = - 1;
    if (instruction.Args.count>0) {
        left = ReadWire(ref args, BridgeType<WireScalarValueUse>{0}) ?.Value;
        if (ScalarFloating(function.scalarTypes[left])) {
            type = function.scalarTypes[left];
        }
    }
    if (instruction.Args.count>1) {
        right = ReadWire(ref args, BridgeType<WireScalarValueUse>{0}) ?.Value;
    }
    return EncodeScalarOperands(ref writer, ref const reader, instruction, left, right,
    ref const function, ref const allocation, ref const frame);
}
// Both scalar wire formats and typed object projections use this selector.
// Object value IDs are mapped to scalar IDs before entering it.
Result<void, BackendError> EncodeScalarOperands(ref ByteWriter writer, ref const BridgeReader reader,
WireScalarMachineInstruction instruction, int left, int right, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame) {
    ScalarRepresentation type = instruction.Representation;
    if (left >= 0 and ScalarFloating(function.scalarTypes[left])) {
        type = function.scalarTypes[left];
    }
    if (instruction.Op == ScalarOpcode::CheckIndex or instruction.Op == ScalarOpcode::IndexAddress) {
        return WriteScalarIndex(ref writer, instruction, left, ref const function, ref const allocation,
        ref const frame);
    }
    if (not ScalarFloating(type)) {
        if (left >= 0) {
            type = function.scalarTypes[left];
        }
        return EncodeScalarIntegerInstruction(ref writer, ref const reader, instruction,
        left, right, type, ref const allocation, ref const frame);
    }
    int scratch = NativeScalarTemporary(ref const frame, 0) ?;
    int accumulator = NativeScalarTemporary(ref const frame, 1) ?;
    WriteSelectedScalar(ref writer, ScalarOpcode::Store, ScalarRepresentation::Float64, ScalarStackOperand(scratch,
    ScalarRepresentation::Float64), ScalarRegisterOperand(XMMRegister::XMM5, ScalarRepresentation::Float64)) ?;
    WriteRSPReg(ref writer, false, Register::RAX, accumulator, 8) ?;
    ScalarSSEOperand destination = ScalarRegisterOperand(XMMRegister::XMM5, type);
    if (left >= 0 and instruction.Op != ScalarOpcode::Load and instruction.Op != ScalarOpcode::Store) {
        WriteSelectedScalar(ref writer, ScalarOpcode::Load, type, destination, NativeScalarSource(left,
        type, ref const allocation, ref const frame, true) ?) ?;
    }
    bool comparison = false;
    match (instruction.Op) {
        ScalarOpcode::FloatAdd => {
            WriteSelectedScalar(ref writer, instruction.Op, type, destination, NativeScalarSource(right,
            type, ref const allocation, ref const frame, true) ?) ?;
        }
        ScalarOpcode::FloatSub => {
            WriteSelectedScalar(ref writer, instruction.Op, type, destination, NativeScalarSource(right,
            type, ref const allocation, ref const frame, true) ?) ?;
        }
        ScalarOpcode::FloatMul => {
            WriteSelectedScalar(ref writer, instruction.Op, type, destination, NativeScalarSource(right,
            type, ref const allocation, ref const frame, true) ?) ?;
        }
        ScalarOpcode::FloatDiv => {
            WriteSelectedScalar(ref writer, instruction.Op, type, destination, NativeScalarSource(right,
            type, ref const allocation, ref const frame, true) ?) ?;
        }
        ScalarOpcode::FloatNeg => {
            WriteScalarNegation(ref writer, XMMRegister::XMM5, type) ?;
        }
        ScalarOpcode::FloatEqual => {
            comparison = true;
        }
        ScalarOpcode::FloatNotEqual => {
            comparison = true;
        }
        ScalarOpcode::FloatLess => {
            comparison = true;
        }
        ScalarOpcode::FloatLessEqual => {
            comparison = true;
        }
        ScalarOpcode::FloatGreater => {
            comparison = true;
        }
        ScalarOpcode::FloatGreaterEqual => {
            comparison = true;
        }
        ScalarOpcode::LoadSlot => {
            WriteSelectedScalar(ref writer, ScalarOpcode::Load, type, destination, ScalarStackOperand(frame.slotOffsets[instruction.Slot],
            type)) ?;
        }
        ScalarOpcode::StoreSlot => {
            WriteSelectedScalar(ref writer, ScalarOpcode::Store, type, ScalarStackOperand(frame.slotOffsets[instruction.Slot],
            type), destination) ?;
        }
        ScalarOpcode::FloatConst => {
            byte[8] bits =[0 ...];
            int width = ScalarWidth(type);
            if (instruction.Literal.length != 2 + width * 2) {
                return Result::Error(BackendError::InvalidEncoding);
            }
            for (i in 0 .. width) {
                int digit = instruction.Literal.offset + 2 +(width - 1 - i) * 2;
                int high = ScalarHexDigit(reader.data[digit] as int);
                int low = ScalarHexDigit(reader.data[digit + 1] as int);
                if (high<0 or low<0) { return Result::Error(BackendError::InvalidEncoding); }
                bits[i] =(high * 16 + low) as byte;
            }
            if (width == 8) {
                WriteScalarConstant(ref writer, ReadOnlySpan(bits), XMMRegister::XMM5, type) ?;
            }
            else {
                byte[4] narrow =[0 ...];
                for (i in 0 .. 4) {
                    narrow[i] = bits[i];
                }
                WriteScalarConstant(ref writer, ReadOnlySpan(narrow), XMMRegister::XMM5, type) ?;
            }
        }
        ScalarOpcode::Const => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::Load => {
            WriteScalarAddressSSE(ref writer, false, type, XMMRegister::XMM5, allocation.scalarLocations[left].gpr) ?;
        }
        ScalarOpcode::Store => {
            WriteSelectedScalar(ref writer, ScalarOpcode::Load, type, destination, NativeScalarSource(right,
            type, ref const allocation, ref const frame, true) ?) ?;
            WriteScalarAddressSSE(ref writer, true, type, XMMRegister::XMM5, allocation.scalarLocations[left].gpr) ?;
        }
        ScalarOpcode::IndexAddress => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::CheckIndex => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::CheckedAdd => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::CheckedSub => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::CheckedMul => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::Add => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::Sub => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::Mul => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::Equal => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::NotEqual => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::Less => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::LessEqual => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::Greater => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::GreaterEqual => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::Call => { return Result::Error(BackendError::UnsupportedInstruction); }
    }
    bool resultRAX = false;
    bool resultScratch = false;
    if (comparison) {
        WriteSelectedScalar(ref writer, instruction.Op, type, destination, NativeScalarSource(right,
        type, ref const allocation, ref const frame, true) ?) ?;
        // Preserve RDX: SETP/SETNP consumes only its low byte.
        int parity = NativeScalarTemporary(ref const frame, 2) ?;
        WriteRSPReg(ref writer, false, Register::RDX, parity, 8) ?;
        WriteScalarCompareBool(ref writer, instruction.Op) ?;
        WriteRSPReg(ref writer, true, Register::RDX, parity, 8) ?;
        ScalarLocation target = allocation.scalarLocations[instruction.Result];
        resultRAX = target.gpr == Register::RAX;
        WriteRegReg(ref writer, 137, target.gpr, Register::RAX, 4) ?;
    } else {
        if (instruction.Result >= 0) {
            ScalarLocation target = allocation.scalarLocations[instruction.Result];
            if (target.kind == ScalarLocationKind::Spill) {
                WriteSelectedScalar(ref writer, ScalarOpcode::Store, type, ScalarStackOperand(frame.slots[frame.spillSlots[instruction.Result]].offset,
                type), destination) ?;
            }
            else {
                WriteSelectedScalar(ref writer, ScalarOpcode::Load, type, ScalarRegisterOperand(target.xmm,
                type), destination) ?;
                resultScratch = target.xmm == XMMRegister::XMM5;
            }
        }
    }
    if (not resultRAX) {
        WriteRSPReg(ref writer, true, Register::RAX, accumulator, 8) ?;
    }
    if (not resultScratch) {
        WriteSelectedScalar(ref writer, ScalarOpcode::Load, ScalarRepresentation::Float64, ScalarRegisterOperand(XMMRegister::XMM5,
        ScalarRepresentation::Float64), ScalarStackOperand(scratch, ScalarRepresentation::Float64)) ?;
    }
    return Result::Ok();
}
int ScalarHexDigit(int value) {
    if (value >= 48 and value <= 57) { return value - 48; }
    if (value >= 97 and value <= 102) { return value - 87; }
    return - 1;
}
// CMIRAMD4 keeps three-address integer operations alongside floating ones.
// Reuse the existing integer instruction writer after preserving borrowed
// registers; this does not change CMIRAMD3 instruction selection.
Result<void, BackendError> EncodeScalarIntegerInstruction(ref ByteWriter writer, ref const BridgeReader reader,
WireScalarMachineInstruction input, int left, int right, ScalarRepresentation type,
ref const Allocation allocation, ref const FinalizedFrame frame) {
    int saved = NativeScalarTemporary(ref const frame, 1) ?;
    int second = NativeScalarTemporary(ref const frame, 2) ?;
    WriteRSPReg(ref writer, false, Register::RAX, saved, 8) ?;
    WriteRSPReg(ref writer, false, Register::RDX, second, 8) ?;
    int width = ScalarWidth(type);
    if (left >= 0) {
        LoadScalarGPR(ref writer, Register::RAX, left, width, ref const allocation, ref const frame) ?;
    }
    if (right >= 0) {
        LoadScalarGPR(ref writer, Register::RDX, right, width, ref const allocation, ref const frame) ?;
    }
    Opcode operation = Opcode::None;
    Condition condition = Condition::None;
    bool checked = false;
    bool comparison = false;
    match (input.Op) {
        ScalarOpcode::Const => {
            if (type != ScalarRepresentation::I32 and type != ScalarRepresentation::Bool) {
                WriteScalarIntegerLiteral(ref writer, ref const reader, input.Literal, type) ?;
            } else {
                int value = 0;
                if (TextEquals(ref const reader, input.Literal, "true")) {
                    value = 1;
                }
                else {
                    if (not TextEquals(ref const reader, input.Literal, "false")) {
                        value = ParseI32Literal(ref const reader, input.Literal) ?;
                    }
                }
                if (width != 4 and type != ScalarRepresentation::Bool) {
                    return Result::Error(BackendError::UnsupportedInstruction);
                }
                WriteMovImmediate(ref writer, Register::RAX, value, 4) ?;
            }
        }
        ScalarOpcode::LoadSlot => {
            WriteRSPReg(ref writer, true, Register::RAX, frame.slotOffsets[input.Slot], width) ?;
        }
        ScalarOpcode::StoreSlot => {
            WriteRSPReg(ref writer, false, Register::RAX, frame.slotOffsets[input.Slot], width) ?;
        }
        ScalarOpcode::Add => {
            operation = Opcode::Add;
        }
        ScalarOpcode::Sub => {
            operation = Opcode::Sub;
        }
        ScalarOpcode::Mul => {
            operation = Opcode::Imul;
        }
        ScalarOpcode::CheckedAdd => {
            operation = Opcode::Add;
            checked = true;
        }
        ScalarOpcode::CheckedSub => {
            operation = Opcode::Sub;
            checked = true;
        }
        ScalarOpcode::CheckedMul => {
            operation = Opcode::Imul;
            checked = true;
        }
        ScalarOpcode::Equal => {
            condition = Condition::Equal;
            comparison = true;
        }
        ScalarOpcode::NotEqual => {
            condition = Condition::NotEqual;
            comparison = true;
        }
        ScalarOpcode::Less => {
            condition = Condition::Less;
            comparison = true;
        }
        ScalarOpcode::LessEqual => {
            condition = Condition::LessEqual;
            comparison = true;
        }
        ScalarOpcode::Greater => {
            condition = Condition::Greater;
            comparison = true;
        }
        ScalarOpcode::GreaterEqual => {
            condition = Condition::GreaterEqual;
            comparison = true;
        }
        ScalarOpcode::FloatConst => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::Load => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::Store => { return Result::Error(BackendError::UnsupportedInstruction); }
        ScalarOpcode::IndexAddress => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::CheckIndex => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatAdd => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatSub => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatMul => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatDiv => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatNeg => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatEqual => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatNotEqual => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatLess => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatLessEqual => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatGreater => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::FloatGreaterEqual => {
            return Result::Error(BackendError::UnsupportedInstruction);
        }
        ScalarOpcode::Call => { return Result::Error(BackendError::UnsupportedInstruction); }
    }
    if (comparison) {
        // Signedness belongs to the representation, not to its byte width.
        if (type == ScalarRepresentation::U8 or type == ScalarRepresentation::U16 or
        type == ScalarRepresentation::U32 or type == ScalarRepresentation::U64) {
            condition = match (condition) {
                Condition::Less => Condition::Below, Condition::LessEqual => Condition::BelowEqual,
                Condition::Greater => Condition::Above, Condition::GreaterEqual => Condition::AboveEqual,
                Condition::None => Condition::None, Condition::Equal => Condition::Equal,
                Condition::NotEqual => Condition::NotEqual, Condition::Below => Condition::Below,
                Condition::BelowEqual => Condition::BelowEqual, Condition::Above => Condition::Above,
                Condition::AboveEqual => Condition::AboveEqual, Condition::Overflow => Condition::Overflow,
                Condition::Carry => Condition::Carry
            };
        }
        EmitInstruction(ref writer, ref const reader, ref const allocation, ref const frame,
        ScalarGPRInstruction(Opcode::Cmp, condition, width)) ?;
        EmitInstruction(ref writer, ref const reader, ref const allocation, ref const frame,
        ScalarGPRInstruction(Opcode::Setcc, condition, width)) ?;
        WriteBoolRegister(ref writer, Register::RAX, Register::RAX) ?;
    } else {
        if (operation != Opcode::None) {
            if (width != 4 or(checked and type != ScalarRepresentation::I32)) {
                return Result::Error(BackendError::UnsupportedInstruction);
            }
            EmitInstruction(ref writer, ref const reader, ref const allocation, ref const frame,
            ScalarGPRInstruction(operation, condition, width)) ?;
            if (checked) {
                // Preserve checked signed arithmetic: JNO past UD2.
                WriteByte(ref writer, 15) ?;
                WriteByte(ref writer, 129) ?;
                WriteI32LE(ref writer, 2) ?;
                WriteByte(ref writer, 15) ?;
                WriteByte(ref writer, 11) ?;
            }
        }
    }
    bool resultRAX = false;
    if (input.Result >= 0) {
        Register target = allocation.scalarLocations[input.Result].gpr;
        resultRAX = target == Register::RAX;
        int resultWidth = ScalarWidth(input.Representation);
        if (input.Representation == ScalarRepresentation::Bool) {
            WriteBoolRegister(ref writer, target, Register::RAX) ?;
        } else {
            int opcode = 137;
            if (resultWidth == 1) {
                opcode = 136;
            }
            WriteRegReg(ref writer, opcode, target, Register::RAX, resultWidth) ?;
        }
    }
    WriteRSPReg(ref writer, true, Register::RDX, second, 8) ?;
    if (not resultRAX) {
        WriteRSPReg(ref writer, true, Register::RAX, saved, 8) ?;
    }
    return Result::Ok();
}
MachineInstruction ScalarGPRInstruction(Opcode operation, Condition condition, int width) {
    MachineOperand accumulator = MachineOperand {
        OperandKind::Physical, 0, width, - 1, - 1, - 1, 1, 0, BridgeText{0, 0}, BridgeText{0, 0}, false
    };
    MachineOperand second = MachineOperand {
        OperandKind::Physical, 3, width, - 1, - 1, - 1, 1, 0, BridgeText{0, 0}, BridgeText{0, 0}, false
    };
    MachineOperand source = second;
    if (operation == Opcode::Cmp) {
        source = accumulator;
    }
    return MachineInstruction {
        operation, accumulator, source, second, 2, width, - 1, - 1, condition, 0, 0, 0, 0, EmptyProjectedCall()
    };
}
Result<void, BackendError> WriteScalarEntry(ref ByteWriter writer, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame) {
    for (i in 0 .. function.argCount) {
        ScalarRepresentation type = function.scalarTypes[function.args[i].virtualReg];
        if (i<4) {
            int offset = NativeScalarTemporary(ref const frame, i) ?;
            if (ScalarFloating(type)) {
                WriteSelectedScalar(ref writer, ScalarOpcode::Store, type, ScalarStackOperand(offset,
                type), ScalarRegisterOperand(XMMAt(i), type)) ?;
            }
            else {
                WriteRSPReg(ref writer, false, Win64Registers().integerArguments[i], offset, ScalarWidth(type)) ?;
            }
        }
    }
    // A spilled floating parameter borrows scratch 3, after the first four
    // floating inputs have been consumed. Load staged GPR inputs first when
    // that scratch could still hold a positional integer argument.
    bool earlyGPR = false;
    for (i in 0 .. function.argCount) {
        if (allocation.spilled[function.args[i].virtualReg]) {
            earlyGPR = true;
        }
    }
    if (earlyGPR) {
        WriteScalarGPRParameters(ref writer, ref const function, ref const allocation, ref const frame) ?;
    }
    for (i in 0 .. function.argCount) {
        int value = function.args[i].virtualReg;
        ScalarRepresentation type = function.scalarTypes[value];
        ScalarLocation target = allocation.scalarLocations[value];
        if (ScalarFloating(type)) {
            int offset = 0;
            if (i<4) {
                offset = NativeScalarTemporary(ref const frame, i) ?;
            } else {
                offset = ScalarIncomingOffset(i, ref const function, ref const frame) ?;
            }
            if (target.kind == ScalarLocationKind::Physical) {
                WriteSelectedScalar(ref writer, ScalarOpcode::Load, type, ScalarRegisterOperand(target.xmm,
                type), ScalarStackOperand(offset, type)) ?;
            }
            else {
                int saved = NativeScalarTemporary(ref const frame, 3) ?;
                WriteSelectedScalar(ref writer, ScalarOpcode::Store, ScalarRepresentation::Float64, ScalarStackOperand(saved,
                ScalarRepresentation::Float64), ScalarRegisterOperand(XMMRegister::XMM5, ScalarRepresentation::Float64)) ?;
                WriteSelectedScalar(ref writer, ScalarOpcode::Load, type, ScalarRegisterOperand(XMMRegister::XMM5,
                type), ScalarStackOperand(offset, type)) ?;
                WriteSelectedScalar(ref writer, ScalarOpcode::Store, type, ScalarStackOperand(frame.slots[frame.spillSlots[value]].offset,
                type), ScalarRegisterOperand(XMMRegister::XMM5, type)) ?;
                WriteSelectedScalar(ref writer, ScalarOpcode::Load, ScalarRepresentation::Float64, ScalarRegisterOperand(XMMRegister::XMM5,
                ScalarRepresentation::Float64), ScalarStackOperand(saved, ScalarRepresentation::Float64)) ?;
            }
        }
    }
    if (not earlyGPR) {
        WriteScalarGPRParameters(ref writer, ref const function, ref const allocation, ref const frame) ?;
    }
    return Result::Ok();
}
Result<void, BackendError> WriteScalarGPRParameters(ref ByteWriter writer, ref const BackendFunction function,
ref const Allocation allocation, ref const FinalizedFrame frame) {
    for (i in 0 .. function.argCount) {
        int value = function.args[i].virtualReg;
        ScalarRepresentation type = function.scalarTypes[value];
        if (not ScalarFloating(type)) {
            int offset = 0;
            if (i<4) {
                offset = NativeScalarTemporary(ref const frame, i) ?;
            } else {
                offset = ScalarIncomingOffset(i, ref const function, ref const frame) ?;
            }
            Register destination = allocation.scalarLocations[value].gpr;
            if (type == ScalarRepresentation::Bool) {
                WriteMovImmediate(ref writer, destination, 0, 4) ?;
            }
            WriteRSPReg(ref writer, true, destination, offset, ScalarWidth(type)) ?;
        }
    }
    return Result::Ok();
}
Result<void, BackendError> WriteScalarBranch(ref ByteWriter writer, ref EncodingPlan plan, int target,
bool conditional) {
    if (plan.fixupCount >= 256) { return Result::Error(BackendError::CapacityExceeded); }
    if (conditional) {
        WriteByte(ref writer, 15) ?;
        WriteByte(ref writer, 132) ?;
    } else {
        WriteByte(ref writer, 233) ?;
    }
    plan.fixups[plan.fixupCount] = BranchFixup{writer.offset, target};
    plan.fixupCount += 1;
    WriteI32LE(ref writer, 0) ?;
    return Result::Ok();
}
Result<int, BackendError> EmitScalarNativeFunction(ReadOnlySpan<byte> artifact, int ordinal, Span<byte> output) {
    ByteWriter writer = ByteWriter{output, 0};
    EncodeScalarNativeFunctionIntoWriter(artifact, ordinal, ref writer) ?;
    return Result::Ok(writer.offset);
}
Result<void, BackendError> EncodeScalarNativeFunctionIntoWriter(ReadOnlySpan<byte> artifact, int ordinal,
ref ByteWriter writer) {
    EncodingPlan branches = EmptyEncodingPlan();
    CallFixup[1] unused =[EmptyCallFixup() ...];
    EncodingWorkspace workspace = EncodingWorkspace {
        Span(branches.blockOffsets), Span(branches.fixups), 0, Span(unused), 0, ordinal, false
    };
    return EncodeScalarNativeFunctionWithCalls(artifact, ordinal, ref writer, ref workspace);
}
Result<void, BackendError> EncodeScalarNativeFunctionWithCalls(ReadOnlySpan<byte> artifact, int ordinal,
ref ByteWriter writer, ref EncodingWorkspace workspace) {
    BackendFunction function = EmptyFunction();
    DecodeScalarFunction(artifact, ordinal, ref function) ?;
    Allocation allocation = EmptyAllocation();
    AllocateRegisters(ref const function, ref allocation) ?;
    if (allocation.callCount>0 and not workspace.allowCalls) {
        return Result::Error(BackendError::UnsupportedCallLowering);
    }
    PlanFunctionCalls(ref const function, ref allocation) ?;
    Liveness live = EmptyLiveness();
    ComputeLiveness(ref const function, ref live) ?;
    FinalizedFrame frame = EmptyFinalizedFrame();
    match (QualifyScalarNativeFrame(ref function, ref const allocation, ref frame)) {
        Result::Ok => { }
        Result::Error(error) => { return Result::Error(BackendError::InvalidEncoding); }
    }
    if (frame.byteCount >= 4096) { return Result::Error(BackendError::CapacityExceeded); }
    BridgeReader reader = BridgeReader{artifact, 0};
    ReadScalarBridgeIdentity(ref reader) ?;
    WireScalarMachineModule module = ReadWire(ref reader, BridgeType<WireScalarMachineModule>{
        0
    }) ?;
    reader.offset = module.Functions.offset;
    WireScalarMachineFunction owner = ReadWire(ref reader, BridgeType<WireScalarMachineFunction>{
        0
    }) ?;
    for (i in 0 .. ordinal) {
        owner = ReadWire(ref reader, BridgeType<WireScalarMachineFunction>{0}) ?;
    }
    for (i in 0 .. frame.prologueCount) {
        EmitFrameAction(ref writer, frame.prologue[i]) ?;
    }
    WriteScalarEntry(ref writer, ref const function, ref const allocation, ref const frame) ?;
    EncodingPlan branches = EmptyEncodingPlan();
    BridgeReader blocks = BridgeReader{artifact, owner.Blocks.offset};
    for (b in 0 .. owner.Blocks.count) {
        WireScalarMachineBlock block = ReadWire(ref blocks, BridgeType<WireScalarMachineBlock>{
            0
        }) ?;
        branches.blockOffsets[b] = writer.offset;
        BridgeReader instructions = BridgeReader{artifact, block.Instructions.offset};
        int position = function.blocks[b].firstInstruction;
        if (b == 0) {
            position += function.argCount;
        }
        for (i in 0 .. block.Instructions.count) {
            WireScalarMachineInstruction instruction = ReadWire(ref instructions, BridgeType<WireScalarMachineInstruction>{
                0
            }) ?;
            if (instruction.Op == ScalarOpcode::Call) {
                EmitAllocatedCall(ref writer, ref const function, ref const allocation, ref const live,
                position, ref const frame, ref workspace) ?;
            } else {
                EncodeScalarWireInstruction(ref writer, ref const reader, instruction, ref const function,
                ref const allocation, ref const frame) ?;
            }
            position += 1;
        }
        match (block.Term.Op) {
            ScalarTerminator::Return => {
                if (function.scalarResult != ScalarRepresentation::Void) {
                    if (ScalarFloating(function.scalarResult)) {
                        WriteSelectedScalar(ref writer, ScalarOpcode::Load, function.scalarResult, ScalarRegisterOperand(XMMRegister::XMM0,
                        function.scalarResult), NativeScalarSource(block.Term.Value, function.scalarResult,
                        ref const allocation, ref const frame, false) ?) ?;
                    }
                    else {
                        int width = ScalarWidth(function.scalarResult);
                        if (function.scalarResult == ScalarRepresentation::Bool) {
                            width = 4;
                        }
                        int opcode = 137;
                        if (width == 1) {
                            opcode = 136;
                        }
                        WriteRegReg(ref writer, opcode, Register::RAX,
                        allocation.scalarLocations[block.Term.Value].gpr, width) ?;
                    }
                }
                for (i in 0 .. frame.epilogueCount) {
                    EmitFrameAction(ref writer, frame.epilogue[i]) ?;
                }
            }
            ScalarTerminator::Jump => {
                WriteScalarBranch(ref writer, ref branches, block.Term.True, false) ?;
            }
            ScalarTerminator::Branch => {
                Register physical = allocation.scalarLocations[block.Term.Value].gpr;
                WriteRegReg(ref writer, 133, physical, physical, 4) ?;
                WriteScalarBranch(ref writer, ref branches, block.Term.False, true) ?;
                WriteScalarBranch(ref writer, ref branches, block.Term.True, false) ?;
            }
        }
    }
    for (i in 0 .. branches.fixupCount) {
        BranchFixup fixup = branches.fixups[i];
        if (fixup.targetBlock<0 or fixup.targetBlock >= function.blockCount) {
            return Result::Error(BackendError::InvalidEncoding);
        }
        int target = branches.blockOffsets[fixup.targetBlock];
        if (target<0) { return Result::Error(BackendError::InvalidEncoding); }
        PatchI32LE(ref writer, fixup.patchOffset, target -(fixup.patchOffset + 4)) ?;
    }
    return Result::Ok();
}
Result<int, NativeError> EmitScalarNativeModule(ReadOnlySpan<byte> artifact, Span<byte> output, ref NativeImage image) {
    BridgeReader reader = BridgeReader{artifact, 0};
    match (ReadScalarBridgeIdentity(ref reader)) {
        Result::Ok => { }
        Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
    }
    WireScalarMachineModule module = WireScalarMachineModule {
        BridgeSequence<WireScalarMachineFunction>{0, 0}
    };
    match (ReadWire(ref reader, BridgeType<WireScalarMachineModule>{0})) {
        Result::Ok(value) => {
            module = value;
        }
        Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
    }
    if (module.Functions.count>128) { return Result::Error(NativeError::CapacityExceeded); }
    BackendFunction function = EmptyFunction();
    // Admit the complete semantic module before any output/image mutation.
    for (i in 0 .. module.Functions.count) {
        match (DecodeScalarFunction(artifact, i, ref function)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(ScalarBackendError(error)); }
        }
    }
    image = EmptyNativeImage();
    ByteWriter writer = ByteWriter{output, 0};
    EncodingPlan branches = EmptyEncodingPlan();
    EncodingWorkspace workspace = EncodingWorkspace {
        Span(branches.blockOffsets), Span(branches.fixups), 0, Span(image.fixups), 0, 0, true
    };
    for (i in 0 .. module.Functions.count) {
        int offset = writer.offset;
        workspace.functionOrdinal = i;
        int calls = workspace.callCount;
        match (EncodeScalarNativeFunctionWithCalls(artifact, i, ref writer, ref workspace)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(ScalarBackendError(error)); }
        }
        match (DecodeScalarFunction(artifact, i, ref function)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(ScalarBackendError(error)); }
        }
        int size = writer.offset - offset;
        image.symbols[i] = NativeSymbol {
            function.identity, function.name, i, offset, size, workspace.callCount - calls
        };
        image.symbolCount += 1;
    }
    image.byteCount = writer.offset;
    image.fixupCount = workspace.callCount;
    ResolveNativeCalls(ref const reader, ref image, output) ?;
    return Result::Ok(writer.offset);
}
// Integer and scalar modules share realization, call encoding, and fixups.
// Only the representation of an already-validated transfer selects its writer.
Result<void, BackendError> EmitAllocatedCall(ref ByteWriter writer, ref const BackendFunction function,
ref const Allocation allocation, ref const Liveness live, int position,
ref const FinalizedFrame frame, ref EncodingWorkspace workspace) {
    CallSiteActions site = EmptyCallSiteActions();
    match (RealizeAllocatedCall(ref const function, ref const allocation, ref const live,
    position, ref const frame, ref site)) {
        Result::Ok => { }
        Result::Error(error) => { return Result::Error(BackendError::InvalidEncoding); }
    }
    for (a in 0 .. site.count) {
        if (a == site.callIndex) {
            WriteCallPlaceholder(ref writer, ref workspace, function.identity, site.abi.target) ?;
        } else {
            if (site.abi.scalar.enabled) {
                EmitScalarCallAction(ref writer, ref const site, a, ref const frame) ?;
            } else {
                EmitFrameAction(ref writer, site.actions[a]) ?;
            }
        }
    }
    return Result::Ok();
}
Result<void, BackendError> EncodeObjectMemoryInstruction(ref ByteWriter writer, ref const BridgeReader reader,
WireObjectModule document, WireObjectFunction owner, WireObjectInstruction input,
ref const ObjectPlacement placement, ref const BackendFunction function, ref const Allocation allocation,
ref const FinalizedFrame frame) {
    WireObjectType type = NativeObjectAt<WireObjectType>(ref const reader, document.Types, input.Type) ?;
    int left = - 1;
    int right = - 1;
    if (input.Args.count > 0) {
        left = NativeObjectAt<WireObjectValueUse>(ref const reader, input.Args, 0) ?.Value;
    }
    if (input.Args.count > 1) {
        right = NativeObjectAt<WireObjectValueUse>(ref const reader, input.Args, 1) ?.Value;
    }
    int t0 = NativeScalarTemporary(ref const frame, 0) ?;
    int t1 = NativeScalarTemporary(ref const frame, 1) ?;
    int t2 = NativeScalarTemporary(ref const frame, 2) ?;
    int t3 = NativeScalarTemporary(ref const frame, 3) ?;
    WriteRSPReg(ref writer, false, Register::RAX, t1, 8) ?;
    WriteRSPReg(ref writer, false, Register::RDX, t2, 8) ?;
    WriteRSPReg(ref writer, false, Register::R10, t3, 8) ?;
    WriteSelectedScalar(ref writer, ScalarOpcode::Store, ScalarRepresentation::Float64, ScalarStackOperand(t0,
    ScalarRepresentation::Float64), ScalarRegisterOperand(XMMRegister::XMM5, ScalarRepresentation::Float64)) ?;
    bool scalarResult = false;
    bool floatingResult = false;
    if (input.Op == ObjectOpcode::CopyValue and input.Result >= 0 and placement.registers[input.Result] >= 0) {
        LoadObjectGPR(ref writer, Register::RAX, placement.registers[left], 8, ref const allocation,
        ref const frame) ?;
        scalarResult = true;
    } else if (input.Op == ObjectOpcode::MakeAggregate or input.Op == ObjectOpcode::MakeArray) {
        int destination = frame.slotOffsets[placement.values[input.Result]];
        for (i in 0 .. input.Args.count) {
            int offset = i * type.Stride;
            if (type.Kind == ObjectKind::Aggregate) {
                offset = NativeObjectAt<WireObjectField>(ref const reader, type.Fields, i) ?.Offset;
            }
            ObjectStackAddress(ref writer, Register::RDX, destination + offset) ?;
            int value = NativeObjectAt<WireObjectValueUse>(ref const reader, input.Args, i) ?.Value;
            WriteObjectValue(ref writer, ref const reader, document, owner, value, ref const placement,
            ref const function, ref const allocation, ref const frame) ?;
        }
    } else if (input.Op == ObjectOpcode::CopyValue or input.Op == ObjectOpcode::ReplaceMember or
    input.Op == ObjectOpcode::LoadSlot or input.Op == ObjectOpcode::StoreSlot or input.Op == ObjectOpcode::InitializeSlot or
    (ObjectAggregate(type.Kind) and(input.Op == ObjectOpcode::Load or input.Op == ObjectOpcode::Store))) {
        if (input.Op == ObjectOpcode::LoadSlot) {
            ObjectStackAddress(ref writer, Register::RAX, frame.slotOffsets[input.Slot]) ?;
        } else if (input.Op == ObjectOpcode::Load) {
            LoadObjectGPR(ref writer, Register::RAX, placement.registers[left], 8, ref const allocation,
            ref const frame) ?;
        } else {
            int source = left;
            if (input.Op == ObjectOpcode::Store) {
                source = right;
            }
            ObjectStackAddress(ref writer, Register::RAX, frame.slotOffsets[placement.values[source]]) ?;
        }
        if (input.Op == ObjectOpcode::StoreSlot or input.Op == ObjectOpcode::InitializeSlot) {
            ObjectStackAddress(ref writer, Register::RDX, frame.slotOffsets[input.Slot]) ?;
        } else if (input.Op == ObjectOpcode::Store) {
            LoadObjectGPR(ref writer, Register::RDX, placement.registers[left], 8, ref const allocation,
            ref const frame) ?;
        } else {
            ObjectStackAddress(ref writer, Register::RDX, frame.slotOffsets[placement.values[input.Result]]) ?;
        }
        CopyObjectFields(ref writer, ref const reader, document, input.Type, 0, 0) ?;
        if (input.Op == ObjectOpcode::ReplaceMember) {
            WireObjectField field = NativeObjectAt<WireObjectField>(ref const reader, type.Fields, input.Member) ?;
            ObjectStackAddress(ref writer, Register::RDX, frame.slotOffsets[placement.values[input.Result]] + field.Offset) ?;
            WriteObjectValue(ref writer, ref const reader, document, owner, right, ref const placement,
            ref const function, ref const allocation, ref const frame) ?;
        }
    } else if (input.Op == ObjectOpcode::Store) {
        LoadObjectGPR(ref writer, Register::RDX, placement.registers[left], 8, ref const allocation,
        ref const frame) ?;
        WriteObjectValue(ref writer, ref const reader, document, owner, right, ref const placement, ref const function,
        ref const allocation, ref const frame) ?;
    } else if (input.Op == ObjectOpcode::Load) {
        LoadObjectGPR(ref writer, Register::RDX, placement.registers[left], 8, ref const allocation,
        ref const frame) ?;
        ScalarRepresentation scalar = ObjectScalar(type.Kind);
        if (ScalarFloating(scalar)) {
            WriteScalarAddressSSE(ref writer, false, scalar, XMMRegister::XMM5, Register::RDX) ?;
            floatingResult = true;
        } else {
            int opcode = 139;
            if (type.Size == 1) {
                opcode = 138;
            }
            WriteAddressReg(ref writer, opcode, Register::RAX, RegisterEncoding(Register::RDX), - 1,
            0, 0, type.Size) ?;
            ExtendObjectInteger(ref writer, Register::RAX, scalar) ?;
            scalarResult = true;
        }
    } else if (input.Op == ObjectOpcode::SlotAddress) {
        ObjectStackAddress(ref writer, Register::RAX, frame.slotOffsets[input.Slot]) ?;
        scalarResult = true;
    } else if (input.Op == ObjectOpcode::FieldAddress) {
        LoadObjectGPR(ref writer, Register::RAX, placement.registers[left], 8, ref const allocation,
        ref const frame) ?;
        WriteAddressReg(ref writer, 141, Register::RAX, RegisterEncoding(Register::RAX), - 1, 0, input.Offset,
        8) ?;
        scalarResult = true;
    } else if (input.Op == ObjectOpcode::CheckIndex or input.Op == ObjectOpcode::IndexAddress) {
        int index = left;
        if (input.Op == ObjectOpcode::IndexAddress) {
            index = right;
        }
        int id = placement.registers[index];
        ScalarRepresentation scalar = function.scalarTypes[id];
        Register target = Register::RAX;
        if (input.Op == ObjectOpcode::IndexAddress) {
            target = Register::RDX;
        }
        LoadObjectGPR(ref writer, target, id, ScalarWidth(scalar), ref const allocation, ref const frame) ?;
        ExtendObjectInteger(ref writer, target, scalar) ?;
        if (input.Op == ObjectOpcode::CheckIndex) {
            // Full-width unsigned compare also rejects negative signed indices.
            WriteByte(ref writer, 72) ?;
            WriteByte(ref writer, 61) ?;
            WriteI32LE(ref writer, input.Extent) ?;
            WriteByte(ref writer, 15) ?;
            WriteByte(ref writer, 130) ?;
            WriteI32LE(ref writer, 2) ?;
            WriteByte(ref writer, 15) ?;
            WriteByte(ref writer, 11) ?;
        } else {
            LoadObjectGPR(ref writer, Register::RAX, placement.registers[left], 8, ref const allocation,
            ref const frame) ?;
            // Guarded index and transported stride bound this product to the
            // checked array's byte extent. Stride 12/24 need no layout rule.
            WriteByte(ref writer, 72) ?;
            WriteByte(ref writer, 105) ?;
            WriteByte(ref writer, 210) ?;
            WriteI32LE(ref writer, input.Stride) ?;
            WriteAddressReg(ref writer, 141, Register::RAX, RegisterEncoding(Register::RAX), RegisterEncoding(Register::RDX),
            0, 0, 8) ?;
            scalarResult = true;
        }
    } else { return Result::Error(BackendError::UnsupportedInstruction); }
    Register resultRegister = Register::RSP;
    bool resultXMM5 = false;
    if (scalarResult) {
        int id = placement.registers[input.Result];
        resultRegister = allocation.scalarLocations[id].gpr;
        // Integer field reads were sign/zero extended above. Preserve the
        // complete extended register rather than restoring stale upper bits.
        int width = 8;
        int opcode = 137;
        if (width == 1) {
            opcode = 136;
        }
        WriteRegReg(ref writer, opcode, resultRegister, Register::RAX, width) ?;
    }
    if (floatingResult) {
        int id = placement.registers[input.Result];
        ScalarRepresentation scalar = ObjectScalar(type.Kind);
        ScalarLocation result = allocation.scalarLocations[id];
        if (result.kind == ScalarLocationKind::Spill) {
            WriteSelectedScalar(ref writer, ScalarOpcode::Store, scalar, ScalarStackOperand(frame.slots[frame.spillSlots[id]].offset,
            scalar), ScalarRegisterOperand(XMMRegister::XMM5, scalar)) ?;
        } else {
            WriteSelectedScalar(ref writer, ScalarOpcode::Load, scalar, ScalarRegisterOperand(result.xmm,
            scalar), ScalarRegisterOperand(XMMRegister::XMM5, scalar)) ?;
            resultXMM5 = result.xmm == XMMRegister::XMM5;
        }
    }
    if (resultRegister != Register::RAX) {
        WriteRSPReg(ref writer, true, Register::RAX, t1, 8) ?;
    }
    if (resultRegister != Register::RDX) {
        WriteRSPReg(ref writer, true, Register::RDX, t2, 8) ?;
    }
    if (resultRegister != Register::R10) {
        WriteRSPReg(ref writer, true, Register::R10, t3, 8) ?;
    }
    if (not resultXMM5) {
        WriteSelectedScalar(ref writer, ScalarOpcode::Load, ScalarRepresentation::Float64, ScalarRegisterOperand(XMMRegister::XMM5,
        ScalarRepresentation::Float64), ScalarStackOperand(t0, ScalarRepresentation::Float64)) ?;
    }
    return Result::Ok();
}
Result<void, BackendError> EncodeObjectInstruction(ref ByteWriter writer, ref const BridgeReader reader,
WireObjectModule document, WireObjectFunction owner, WireObjectInstruction input,
ref const ObjectPlacement placement, ref const BackendFunction function, ref const Allocation allocation,
ref const FinalizedFrame frame) {
    WireObjectType type = NativeObjectAt<WireObjectType>(ref const reader, document.Types, input.Type) ?;
    if ((input.Op == ObjectOpcode::CopyValue and input.Result >= 0 and placement.registers[input.Result] >= 0) or ObjectAggregate(type.Kind) or input.Op == ObjectOpcode::SlotAddress or input.Op == ObjectOpcode::FieldAddress or
    input.Op == ObjectOpcode::IndexAddress or input.Op == ObjectOpcode::CheckIndex or input.Op == ObjectOpcode::Load or input.Op == ObjectOpcode::Store) {
        return EncodeObjectMemoryInstruction(ref writer, ref const reader, document, owner, input, ref const placement,
        ref const function, ref const allocation, ref const frame);
    }
    int left = - 1;
    int right = - 1;
    if (input.Args.count > 0) {
        left = placement.registers[NativeObjectAt<WireObjectValueUse>(ref const reader, input.Args, 0) ?.Value];
    }
    if (input.Args.count > 1) {
        right = placement.registers[NativeObjectAt<WireObjectValueUse>(ref const reader, input.Args,
        1) ?.Value];
    }
    ScalarRepresentation scalar = ObjectScalar(type.Kind);
    ScalarRepresentation operand = scalar;
    if (left >= 0) {
        operand = function.scalarTypes[left];
    }
    ScalarOpcode op = ObjectScalarOperation(input.Op, operand) ?;
    int result = - 1;
    if (input.Result >= 0) {
        result = placement.registers[input.Result];
    }
    WireScalarMachineInstruction adapted = WireScalarMachineInstruction {
        op, result, scalar, BridgeSequence<WireScalarValueUse>{0, 0}, input.Slot, input.Literal, input.Extent,
        input.Stride, input.LIRBlock, input.LIRInstruction, WireScalarSpan {
            input.Source.Line, input.Source.Column
        }, input.Decision, input.Facts, BridgeSequence<WireScalarMachineCall>{0, 0}
    };
    return EncodeScalarOperands(ref writer, ref const reader, adapted, left, right, ref const function,
    ref const allocation, ref const frame);
}
Result<void, BackendError> PrepareObjectFunction(ref const BridgeReader reader, WireObjectModule document,
WireObjectFunction owner, ref BackendFunction function, ref ObjectPlacement placement, ref Allocation allocation,
ref FinalizedFrame frame) {
    ProjectObjectFunction(ref const reader, document, owner, ref function, ref placement) ?;
    allocation = EmptyAllocation();
    AllocateRegisters(ref const function, ref allocation) ?;
    PlanFunctionCalls(ref const function, ref allocation) ?;
    match (QualifyScalarNativeFrame(ref function, ref const allocation, ref frame)) {
        Result::Ok => { }
        Result::Error(error) => { return Result::Error(BackendError::InvalidEncoding); }
    }
    return ValidateObjectFrame(ref const reader, document, owner, ref const function, ref const placement,
    ref const frame);
}
Result<void, BackendError> ValidateObjectFrame(ref const BridgeReader reader, WireObjectModule document,
WireObjectFunction owner, ref const BackendFunction function, ref const ObjectPlacement placement,
ref const FinalizedFrame frame) {
    ValidateObjectFrameSlots(ref const function, ref const frame) ?;
    bool[64] seenObjects =[false ...];
    bool[128] seenScalars =[false ...];
    // Bind storage-backed value IDs to the supplied checked object geometry.
    for (i in 0 .. owner.Values.count) {
        WireObjectValue value = NativeObjectAt<WireObjectValue>(ref const reader, owner.Values, i) ?;
        if (value.Class == ObjectValueClass::Aggregate) {
            int id = placement.values[i];
            if (id < owner.Slots.count or id >= function.slotCount or placement.registers[i] != - 1) {
                return Result::Error(BackendError::InvalidEncoding);
            }
            if (seenObjects[id]) { return Result::Error(BackendError::InvalidEncoding); }
            seenObjects[id] = true;
            WireObjectType type = NativeObjectAt<WireObjectType>(ref const reader, document.Types, value.Type) ?;
            MachineSlot slot = function.slots[id];
            if (slot.size != type.Size or slot.alignment != type.Align or frame.slotOffsets[slot.id] < 0) {
                return Result::Error(BackendError::InvalidEncoding);
            }
        } else {
            int id = placement.registers[i];
            if (id < 0 or id >= function.virtualRegCount or placement.values[i] != - 1) {
                return Result::Error(BackendError::InvalidEncoding);
            }
            if (seenScalars[id]) { return Result::Error(BackendError::InvalidEncoding); }
            seenScalars[id] = true;
        }
    }
    return Result::Ok();
}
Result<void, BackendError> ValidateObjectFrameSlots(ref const BackendFunction function, ref const FinalizedFrame frame) {
    match (ValidateFrame(ref const frame, function.hasCalls)) {
        Result::Ok => { }
        Result::Error(error) => { return Result::Error(BackendError::InvalidEncoding); }
    }
    for (i in 0 .. function.slotCount) {
        int actual = - 1;
        match (ResolveFrameSlot(ref const frame, FrameRegionKind::LocalSlots, i)) {
            Result::Ok(value) => {
                actual = value;
            }
            Result::Error(error) => { return Result::Error(BackendError::InvalidEncoding); }
        }
        FrameSlot stored = frame.slots[actual];
        MachineSlot expected = function.slots[i];
        if (stored.size != expected.size or stored.alignment != expected.alignment or stored.offset != frame.slotOffsets[i]) {
            return Result::Error(BackendError::InvalidEncoding);
        }
    }
    return Result::Ok();
}
// Inspection uses the same production projection, allocator and finalizer.
Result<void, BackendError> PlanObjectNativeFunction(ReadOnlySpan<byte> artifact, int ordinal,
ref BackendFunction function, ref ObjectPlacement placement, ref Allocation allocation, ref FinalizedFrame frame) {
    if (Len(artifact) >= 8 and artifact[7] == 54) {
        match (ValidateBorrowMachineBridge(artifact)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
        }
    } else {
        match (ValidateObjectMachineBridge(artifact)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(BackendError::BridgeInvalid); }
        }
    }
    BridgeReader reader = BridgeReader{artifact, 0};
    WireObjectModule document = NativeObjectDocument(artifact) ?;
    WireObjectFunction owner = NativeObjectAt<WireObjectFunction>(ref const reader, document.Functions,
    ordinal) ?;
    return PrepareObjectFunction(ref const reader, document, owner, ref function, ref placement, ref allocation,
    ref frame);
}
Result<void, BackendError> EncodeObjectFunction(ref ByteWriter writer, ref const BridgeReader reader,
WireObjectModule document, WireObjectFunction owner, ref const BackendFunction function,
ref const ObjectPlacement placement, ref const Allocation allocation, ref const FinalizedFrame frame,
ref EncodingWorkspace workspace) {
    if (frame.byteCount >= 4096) { return Result::Error(BackendError::CapacityExceeded); }
    for (i in 0 .. frame.prologueCount) {
        EmitFrameAction(ref writer, frame.prologue[i]) ?;
    }
    WriteScalarEntry(ref writer, ref const function, ref const allocation, ref const frame) ?;
    Liveness live = EmptyLiveness();
    ComputeLiveness(ref const function, ref live) ?;
    EncodingPlan branches = EmptyEncodingPlan();
    int cursor = 0;
    for (bi in 0 .. owner.Blocks.count) {
        WireObjectBlock block = NativeObjectAt<WireObjectBlock>(ref const reader, owner.Blocks, bi) ?;
        branches.blockOffsets[bi] = writer.offset;
        for (ii in 0 .. block.Instructions.count) {
            WireObjectInstruction instruction = NativeObjectAt<WireObjectInstruction>(ref const reader,
            block.Instructions, ii) ?;
            if (instruction.Op == ObjectOpcode::Call) {
                EmitAllocatedCall(ref writer, ref const function, ref const allocation, ref const live,
                placement.positions[cursor], ref const frame, ref workspace) ?;
            } else {
                EncodeObjectInstruction(ref writer, ref const reader, document, owner, instruction, ref const placement,
                ref const function, ref const allocation, ref const frame) ?;
            }
            cursor += 1;
        }
        match (block.Term.Op) {
            ObjectTerminator::Return => {
                if (function.scalarResult != ScalarRepresentation::Void) {
                    int id = placement.registers[block.Term.Value];
                    if (ScalarFloating(function.scalarResult)) {
                        WriteSelectedScalar(ref writer, ScalarOpcode::Load, function.scalarResult, ScalarRegisterOperand(XMMRegister::XMM0,
                        function.scalarResult), NativeScalarSource(id, function.scalarResult, ref const allocation,
                        ref const frame, false) ?) ?;
                    } else {
                        int width = ScalarWidth(function.scalarResult);
                        if (width < 4) {
                            width = 4;
                        }
                        WriteRegReg(ref writer, 137, Register::RAX, allocation.scalarLocations[id].gpr,
                        width) ?;
                    }
                }
                for (i in 0 .. frame.epilogueCount) {
                    EmitFrameAction(ref writer, frame.epilogue[i]) ?;
                }
            }
            ObjectTerminator::Jump => {
                WriteScalarBranch(ref writer, ref branches, block.Term.True, false) ?;
            }
            ObjectTerminator::Branch => {
                Register condition = allocation.scalarLocations[placement.registers[block.Term.Value]].gpr;
                WriteRegReg(ref writer, 133, condition, condition, 4) ?;
                WriteScalarBranch(ref writer, ref branches, block.Term.False, true) ?;
                WriteScalarBranch(ref writer, ref branches, block.Term.True, false) ?;
            }
        }
    }
    for (i in 0 .. branches.fixupCount) {
        BranchFixup fixup = branches.fixups[i];
        PatchI32LE(ref writer, fixup.patchOffset, branches.blockOffsets[fixup.targetBlock] -(fixup.patchOffset + 4)) ?;
    }
    return Result::Ok();
}
Result<int, NativeError> EmitObjectNativeModule(ReadOnlySpan<byte> artifact, Span<byte> output, ref NativeImage image) {
    BridgeReader reader = BridgeReader{artifact, 0};
    match (ReadObjectBridgeIdentity(ref reader)) {
        Result::Ok => { }
        Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
    }
    WireObjectModule document = WireObjectModule {
        BridgeSequence<WireObjectDependency>{0, 0}, BridgeSequence<WireObjectType>{0, 0}, BridgeSequence<WireObjectFunction>{
            0, 0
        }
    };
    match (ReadWire(ref reader, BridgeType<WireObjectModule>{0})) {
        Result::Ok(value) => {
            document = value;
        }
        Result::Error(error) => { return Result::Error(NativeError::InvalidInput); }
    }
    return EmitObjectNativeDocument(ref const reader, document, output, ref image, false);
}
Result<int, NativeError> EmitObjectNativeDocument(ref const BridgeReader reader, WireObjectModule document,
Span<byte> output, ref NativeImage image, bool references) {
    // Whole-module ABI and frame admission precedes output/image mutation.
    BackendFunction function = EmptyFunction();
    ObjectPlacement placement = EmptyObjectPlacement();
    Allocation allocation = EmptyAllocation();
    FinalizedFrame frame = EmptyFinalizedFrame();
    bool aggregateABI = ObjectModuleHasAggregateABI(ref const reader, document);
    if (aggregateABI) {
        AggregateFunctionPlan aggregatePlan = EmptyAggregateFunctionPlan();
        for (i in 0 .. document.Functions.count) {
            WireObjectFunction owner = AdmittedObjectAt<WireObjectFunction>(ref const reader, document.Functions,
            i) ?;
            match (PrepareAggregateFunction(ref const reader, document, owner, ref function, ref placement,
            ref allocation, ref frame, ref aggregatePlan)) {
                Result::Ok => { }
                Result::Error(error) => {
                    return Result::Error(AggregateNativeError(error));
                }
            }
        }
        return Result::Error(NativeError::UnsupportedAggregateCallEmission);
    }
    for (i in 0 .. document.Functions.count) {
        WireObjectFunction owner = AdmittedObjectAt<WireObjectFunction>(ref const reader, document.Functions,
        i) ?;
        WireObjectType result = AdmittedObjectAt<WireObjectType>(ref const reader, document.Types, owner.ResultType) ?;
        if (ObjectAggregate(result.Kind)) {
            return Result::Error(NativeError::UnsupportedAggregateABI);
        }
        for (p in 0 .. owner.Params.count) {
            WireObjectParameter parameter = AdmittedObjectAt<WireObjectParameter>(ref const reader, owner.Params,
            p) ?;
            WireObjectType type = AdmittedObjectAt<WireObjectType>(ref const reader, document.Types,
            parameter.Type) ?;
            WireObjectValue value = AdmittedObjectAt<WireObjectValue>(ref const reader, owner.Values,
            parameter.Value) ?;
            if (ObjectAggregate(type.Kind) and not(references and value.Class == ObjectValueClass::Location)) {
                return Result::Error(NativeError::UnsupportedAggregateABI);
            }
        }
    }
    for (i in 0 .. document.Functions.count) {
        WireObjectFunction owner = AdmittedObjectAt<WireObjectFunction>(ref const reader, document.Functions,
        i) ?;
        match (PrepareObjectFunction(ref const reader, document, owner, ref function, ref placement,
        ref allocation, ref frame)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(ScalarBackendError(error)); }
        }
        if (frame.byteCount >= 4096) {
            return Result::Error(NativeError::StackProbeRequired);
        }
    }
    image = EmptyNativeImage();
    ByteWriter writer = ByteWriter{output, 0};
    EncodingPlan branches = EmptyEncodingPlan();
    EncodingWorkspace workspace = EncodingWorkspace {
        Span(branches.blockOffsets), Span(branches.fixups), 0, Span(image.fixups), 0, 0, true
    };
    for (i in 0 .. document.Functions.count) {
        WireObjectFunction owner = AdmittedObjectAt<WireObjectFunction>(ref const reader, document.Functions,
        i) ?;
        match (PrepareObjectFunction(ref const reader, document, owner, ref function, ref placement,
        ref allocation, ref frame)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(ScalarBackendError(error)); }
        }
        int begin = writer.offset;
        int calls = workspace.callCount;
        workspace.functionOrdinal = i;
        match (EncodeObjectFunction(ref writer, ref const reader, document, owner, ref const function,
        ref const placement, ref const allocation, ref const frame, ref workspace)) {
            Result::Ok => { }
            Result::Error(error) => { return Result::Error(ScalarBackendError(error)); }
        }
        image.symbols[i] = NativeSymbol {
            owner.Identity, owner.Name, i, begin, writer.offset - begin, workspace.callCount - calls
        };
        image.symbolCount += 1;
    }
    image.byteCount = writer.offset;
    image.fixupCount = workspace.callCount;
    ResolveNativeCalls(ref const reader, ref image, output) ?;
    return Result::Ok(writer.offset);
}
void NativeScalarSSEFacts() {
    Assert.Concept<NoAllocation>(EmitScalarNativeModule, "bounded native scalar image in caller-owned storage");
    Assert.Concept<NoAllocation>(EncodeScalarNativeFunctionIntoWriter, "shared writer and frame-owned scratch");
    Assert.Concept<NoAllocation>(EmitAllocatedCall, "shared checked integer and mixed call actions");
    Assert.Concept<NoAllocation>(EmitObjectNativeModule, "typed objects use the existing frame and caller-owned backend stores");
    Assert.Concept<NoAllocation>(EncodeObjectMemoryInstruction, "scalar field transfers and bounded snapshots");
}
void NativeFacts() {
    Assert.Concept<PlainData>(CallFixup, "transient semantic-identity call patch");
    Assert.Concept<PlainData>(NativeSymbol, "declaration-order code layout");
    Assert.Concept<NoAllocation>(EmitModule, "bounded symbols/fixups and caller-owned bytes");
    Assert.Concept<NoAllocation>(ResolveNativeCalls, "no bootstrap linker policy");
}
NativeError NativeBorrowError(BorrowError error) {
    if (error == BorrowError::Target) { return NativeError::ReferenceTarget; }
    if (error == BorrowError::Authority) { return NativeError::ReferenceAuthority; }
    if (error == BorrowError::Lifetime) { return NativeError::ReferenceLifetime; }
    if (error == BorrowError::Escape) { return NativeError::ReferenceEscape; }
    if (error == BorrowError::Call) { return NativeError::ReferenceCall; }
    if (error == BorrowError::NotLive) { return NativeError::ReferenceNotLive; }
    return NativeError::InvalidInput;
}
