module Standard.Collection.Stores;
profile Core;
// A dense store owns its values. IDs are logical positions, not borrows.
enum StoreError
{
    CapacityExceeded,
    InvalidId,
    StaleId,
}
template <typename T>
struct Id
{
    int index;
};
template <typename T>
struct GenerationalId
{
    int index;
    int generation;
};
template <typename T>
bool EqualId(Id<T> left, Id<T> right)
{
    return left.index == right.index;
}
template <typename T>
bool EqualGenerationalId(GenerationalId<T> left, GenerationalId<T> right)
{
    return left.index == right.index and left.generation == right.generation;
}
template <typename T, usize Capacity>
class DenseStore
{
    public:
    T<raw>[Capacity] backing;
};
template <typename T, usize Capacity>
DenseStore<T, Capacity> MakeDenseStore()
{
    T<raw>[Capacity] backing = Uninitialized();
    DenseStore<T, Capacity> store = DenseStore<T, Capacity>{move backing};
    return move store;
}
template <typename T, usize Capacity>
Result<Id<T>, StoreError> Append(ref DenseStore<T, Capacity> store, T value)
{
    if (RawCount(ref const store.backing) >= Len(store.backing))
    { return Result::Error(StoreError::CapacityExceeded); }
    int index = RawAppend(ref store.backing, move value);
    Id<T> id = Id<T>{index};
    return Result::Ok(move id);
}
template <typename T, usize Capacity>
Result<ref const T, StoreError> DenseGet(ref const DenseStore<T, Capacity> store, Id<T> id)
{
    if (id.index < 0 or id.index >= RawCount(ref const store.backing))
    { return Result::Error(StoreError::InvalidId); }
    return Result::Ok(RawGet(ref const store.backing, id.index));
}
template <typename T, usize Capacity>
Result<ref T, StoreError> DenseGetMutable(ref DenseStore<T, Capacity> store, Id<T> id)
{
    if (id.index < 0 or id.index >= RawCount(ref const store.backing))
    { return Result::Error(StoreError::InvalidId); }
    return Result::Ok(RawGet(ref store.backing, id.index));
}
template <typename T, usize Capacity>
int Count(ref const DenseStore<T, Capacity> store)
{
    return RawCount(ref const store.backing);
}
// The caller can walk 0..Count without constructing an iterator object.
template <typename T, usize Capacity>
Result<Id<T>, StoreError> IdAt(ref const DenseStore<T, Capacity> store, int ordinal)
{
    if (ordinal < 0 or ordinal >= RawCount(ref const store.backing))
    { return Result::Error(StoreError::InvalidId); }
    Id<T> id = Id<T>{ordinal};
    return Result::Ok(move id);
}
requires compiler.InvalidatesBorrows(Append, store);

template <typename T, usize Capacity>
Span<T> Values(ref DenseStore<T, Capacity> store)
{
    return RawValues(ref store.backing);
}

template <typename T, usize Capacity>
ReadOnlySpan<T> ReadOnlyValues(ref const DenseStore<T, Capacity> store)
{
    return RawValues(ref const store.backing);
}
template <typename T, usize Capacity>
class GenerationalStore
{
    public:
    T<sparse>[Capacity] slots;
    int<array>[Capacity] generation;
    int<array>[Capacity] free;
    int next;
    int freeCount;
    int liveCount;
};
template <typename T, usize Capacity>
GenerationalStore<T, Capacity> MakeGenerationalStore()
{
    T<sparse>[Capacity] slots = Uninitialized();
    int<array>[Capacity] generation =[1 ...];
    int<array>[Capacity] free =[0 ...];
    GenerationalStore<T, Capacity> store = GenerationalStore<T, Capacity>{
        move slots, move generation, move free, 0, 0, 0
    };
    return move store;
}
template <typename T, usize Capacity>
Result<GenerationalId<T>, StoreError> Insert(ref GenerationalStore<T, Capacity> store, T value)
{
    int index = 0;
    if (store.freeCount > 0)
    {
        store.freeCount = store.freeCount - 1;
        index = store.free[store.freeCount];
    }
    else
    {
        if (store.next >= Len(store.slots))
        { return Result::Error(StoreError::CapacityExceeded); }
        index = store.next;
        store.next = index + 1;
    }
    SparseInitialize(ref store.slots, index, move value);
    store.liveCount += 1;
    GenerationalId<T> id = GenerationalId<T>{index, store.generation[index]};
    return Result::Ok(move id);
}
template <typename T, usize Capacity>
bool Contains(ref const GenerationalStore<T, Capacity> store, GenerationalId<T> id)
{
    return id.index >= 0 and id.index < store.next and
    id.generation > 0 and store.generation[id.index] == id.generation and
    SparseOccupied(ref const store.slots, id.index);
}

template <typename T, usize Capacity>
int GenerationalCount(ref const GenerationalStore<T, Capacity> store)
{
    return store.liveCount;
}
template <typename T, usize Capacity>
Result<ref const T, StoreError> GenerationalGet(ref const GenerationalStore<T, Capacity> store, GenerationalId<T> id)
{
    if (not Contains<T, Capacity>(ref const store, id))
    { return Result::Error(StoreError::StaleId); }
    return Result::Ok(SparseGet(ref const store.slots, id.index));
}
template <typename T, usize Capacity>
Result<ref T, StoreError> GenerationalGetMutable(ref GenerationalStore<T, Capacity> store, GenerationalId<T> id)
{
    if (not Contains<T, Capacity>(ref const store, id))
    { return Result::Error(StoreError::StaleId); }
    return Result::Ok(SparseGet(ref store.slots, id.index));
}
template <typename T, usize Capacity>
Result<void, StoreError> Remove(ref GenerationalStore<T, Capacity> store, GenerationalId<T> id)
{
    if (not Contains<T, Capacity>(ref const store, id))
    { return Result::Error(StoreError::StaleId); }
    SparseRemove(ref store.slots, id.index);
    store.liveCount -= 1;
    int generation = store.generation[id.index];
    bool exhausted = generation == 2147483647;
    if (exhausted)
    {
        // Retired slots cannot wrap into an ancient live handle.
        store.generation[id.index] = 0;
    }
    else
    {
        store.generation[id.index] = store.generation[id.index] + 1;
        store.free[store.freeCount] = id.index;
        store.freeCount = store.freeCount + 1;
    }
    return Result::Ok();
}
requires compiler.InvalidatesBorrows(Remove, store);
