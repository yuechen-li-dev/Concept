#version 450
// destination[i] = source[i] * scale for i < count.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Source { float values[]; } source;
layout(std430, set = 0, binding = 1) buffer Destination { float values[]; } destination;
layout(push_constant) uniform Constants { uint count; float scale; } constants;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < constants.count) {
        destination.values[i] = source.values[i] * constants.scale;
    }
}
