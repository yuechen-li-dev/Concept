module BufferLifetimeTests;
profile Vulkan;
import BufferLifetime;

// An observer exported by the GPU-free test device that `concept test` links.
extern "C" int ConceptVkTestLiveBuffers();

[[fact]]
void TheStagingBufferIsReleasedWhenTheFunctionReturns()
{
    owned Context context = CreateComputeContext()!;
    Assert.Equal(StagingBytes(ref const context)!, 4096, "the size crosses back");
    Assert.Equal(ConceptVkTestLiveBuffers(), 0, "and the buffer is gone");
}
