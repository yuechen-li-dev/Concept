module BufferLifetimeTests;
profile Vulkan;
import BufferLifetime;

// A lifetime observer; both the test device and the GPU runtime export it.
extern "C" int ConceptVkTestLiveBuffers();

[[fact]]
void TheStagingBufferIsReleasedWhenTheFunctionReturns()
{
    owned Context context = CreateContext()!;
    int before = ConceptVkTestLiveBuffers();
    Assert.Equal(StagingBytes(ref const context)!, 4096, "1024 floats are 4096 bytes");
    Assert.Equal(ConceptVkTestLiveBuffers(), before, "and the buffer is gone");
}
