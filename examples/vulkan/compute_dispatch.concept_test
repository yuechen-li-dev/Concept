module ComputeDispatchTests;
profile Vulkan;
import ComputeDispatch;

// Runs on the GPU with CONCEPT_VULKAN_RUNTIME=device, and on the GPU-free test
// device (which knows double.spv) otherwise.
[[fact]]
void DoublingSixtyFourIntsOnTheDevice()
{
    Assert.Equal(DoubleAndSum("kernels/double.spv")!, 4032, "sum of 2*i for i in 0..63");
}
