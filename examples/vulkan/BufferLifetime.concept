module BufferLifetime;
profile Vulkan;

// profile Vulkan brings the Vulkan library (no import line) and, under
// `concept test`, links the Vulkan runtime. Nothing here is a C header,
// a manifest, or a link setting.
Result<int, VulkanError> StagingBytes(ref const Context context)
{
    owned Buffer<float> staging = CreateBuffer<float>(ref const context, 1024, Placement::Upload)?;
    return Result::Ok(Magnitude(ByteSize(ref const staging)) as int);
}
