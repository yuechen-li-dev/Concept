profile Core;

// Guarded input reactions: every guard for the incoming variant is
// evaluated; one true guard is taken, several are Ambiguous and leave the
// state alone, and none falls back to `otherwise` or reports Unhandled.
enum LifecycleSignal
{
    Submit,
    Resolve,
    Stop
}

struct LifecycleContext
{
    bool queueAvailable;
    bool releaseRequested;
};

bool CanSubmit(LifecycleContext context)
{
    return context.queueAvailable;
}

bool MustRelease(LifecycleContext context)
{
    return context.releaseRequested;
}

automata GuardedLifecycle
with input LifecycleSignal
with state
{
    LifecycleContext context;
}
{
    machine Main
    {
        state Idle
        {
            on LifecycleSignal::Submit when CanSubmit(context) => Submitted;
            on LifecycleSignal::Submit when MustRelease(context) => Released;
            on LifecycleSignal::Submit otherwise => Deferred;
            on LifecycleSignal::Resolve => GuardOnly;
        }

        state GuardOnly
        {
            on LifecycleSignal::Submit when CanSubmit(context) => Submitted;
            on LifecycleSignal::Submit when MustRelease(context) => Released;
            on LifecycleSignal::Resolve => Resolved;
        }

        state Deferred
        {
            on LifecycleSignal::Resolve => Resolved;
        }

        state Submitted
        {
            on LifecycleSignal::Stop => Finished;
        }

        state Released
        {
            on LifecycleSignal::Stop => Finished;
        }

        state Resolved
        {
            on LifecycleSignal::Stop => Finished;
        }

        terminal state Finished
        {
        }
    }
}

int OutcomeCode(StepOutcome outcome)
{
    return match (outcome) {
        StepOutcome::Transitioned => 1,
        StepOutcome::Unhandled => 2,
        StepOutcome::Ambiguous => 5,
        StepOutcome::Finished => 3,
        StepOutcome::AlreadyFinished => 4
    };
}

int UniqueGuardSelectionCode(LifecycleContext context)
{
    instance GuardedLifecycle lifecycle(context);
    StepOutcome a = Step(lifecycle, Main, LifecycleSignal::Submit);
    StepOutcome b = Step(lifecycle, Main, LifecycleSignal::Stop);
    return OutcomeCode(a) * 10 + OutcomeCode(b);
}

int FallbackSelectionCode(LifecycleContext context)
{
    instance GuardedLifecycle lifecycle(context);
    StepOutcome a = Step(lifecycle, Main, LifecycleSignal::Submit);
    StepOutcome b = Step(lifecycle, Main, LifecycleSignal::Resolve);
    StepOutcome c = Step(lifecycle, Main, LifecycleSignal::Stop);
    return OutcomeCode(a) * 100 +
        OutcomeCode(b) * 10 +
        OutcomeCode(c);
}

int GuardedUnhandledPreservesStateCode(LifecycleContext context)
{
    instance GuardedLifecycle lifecycle(context);
    StepOutcome a = Step(lifecycle, Main, LifecycleSignal::Resolve);
    StepOutcome b = Step(lifecycle, Main, LifecycleSignal::Submit);
    StepOutcome c = Step(lifecycle, Main, LifecycleSignal::Resolve);
    StepOutcome d = Step(lifecycle, Main, LifecycleSignal::Stop);
    return OutcomeCode(a) * 1000 +
        OutcomeCode(b) * 100 +
        OutcomeCode(c) * 10 +
        OutcomeCode(d);
}

int AmbiguousPreservesStateCode(LifecycleContext context)
{
    instance GuardedLifecycle lifecycle(context);
    StepOutcome a = Step(lifecycle, Main, LifecycleSignal::Submit);
    StepOutcome b = Step(lifecycle, Main, LifecycleSignal::Resolve);
    StepOutcome c = Step(lifecycle, Main, LifecycleSignal::Submit);
    StepOutcome d = Step(lifecycle, Main, LifecycleSignal::Resolve);
    StepOutcome e = Step(lifecycle, Main, LifecycleSignal::Stop);
    return OutcomeCode(a) * 10000 +
        OutcomeCode(b) * 1000 +
        OutcomeCode(c) * 100 +
        OutcomeCode(d) * 10 +
        OutcomeCode(e);
}

int AlreadyFinishedSkipsGuardSelectionCode(LifecycleContext context)
{
    instance GuardedLifecycle lifecycle(context);
    discard Step(lifecycle, Main, LifecycleSignal::Submit);
    discard Step(lifecycle, Main, LifecycleSignal::Stop);
    return OutcomeCode(Step(lifecycle, Main, LifecycleSignal::Submit));
}
