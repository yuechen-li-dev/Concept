profile Core;

// Stepping nested machines with input. Each Step returns a StepOutcome;
// pushes, pops, and terminal states settle within the Step that causes them.
enum LifecycleSignal
{
    Create,
    Begin,
    Clean,
    Release,
    Sweep,
    Confirm,
    Stop,
    Tick
}

automata ResourceLifecycle
with input LifecycleSignal
{
    machine Main
    {
        state Empty
        {
            on LifecycleSignal::Create => Ready;
        }

        state Ready
        {
            on LifecycleSignal::Tick => Ready;
            on LifecycleSignal::Begin => Running;
            on LifecycleSignal::Clean => { push Cleanup goto AwaitingResume; }
            on LifecycleSignal::Stop => Finished;
        }

        state Running
        {
            on LifecycleSignal::Clean => { push Cleanup goto Finished; }
        }

        state AwaitingResume
        {
            on LifecycleSignal::Stop => Finished;
        }

        terminal state Finished
        {
        }
    }

    machine Cleanup fails int
    {
        state Begin
        {
            on LifecycleSignal::Release => { push SweepMachine goto Resume; }
        }

        state Resume
        {
            on LifecycleSignal::Tick => Resume;
            on LifecycleSignal::Confirm => Complete;
            on LifecycleSignal::Stop => { fail 7; }
        }

        terminal state Complete
        {
        }
    }

    machine SweepMachine
    {
        state Begin
        {
            on LifecycleSignal::Sweep => Complete;
        }

        terminal state Complete
        {
        }
    }
}

automata SingleStepLifecycle
with input LifecycleSignal
{
    machine Main
    {
        state Idle
        {
            on LifecycleSignal::Create => Finished;
        }

        terminal state Finished
        {
        }
    }
}

int OutcomeCode(StepOutcome outcome)
{
    return match (outcome) {
        StepOutcome::Transitioned => 1,
        StepOutcome::Unhandled => 2,
        StepOutcome::Ambiguous => 5,
        StepOutcome::Finished => 3,
        StepOutcome::AlreadyFinished => 4
    };
}

int SingleStepFinishCode()
{
    instance SingleStepLifecycle lifecycle();
    int first = OutcomeCode(Step(lifecycle, Main, LifecycleSignal::Create));
    return first * 10 + OutcomeCode(Step(lifecycle, Main, LifecycleSignal::Create));
}

int UnhandledPreservesStateCode()
{
    instance ResourceLifecycle lifecycle();
    StepOutcome first = Step(lifecycle, Main, LifecycleSignal::Stop);
    StepOutcome second = Step(lifecycle, Main, LifecycleSignal::Create);
    return OutcomeCode(first) * 10 + OutcomeCode(second);
}

int NestedPushResumesCallerCode()
{
    instance ResourceLifecycle lifecycle();
    StepOutcome a = Step(lifecycle, Main, LifecycleSignal::Create);
    StepOutcome b = Step(lifecycle, Main, LifecycleSignal::Clean);
    StepOutcome c = Step(lifecycle, Main, LifecycleSignal::Release);
    StepOutcome d = Step(lifecycle, Main, LifecycleSignal::Sweep);
    StepOutcome e = Step(lifecycle, Main, LifecycleSignal::Confirm);
    StepOutcome f = Step(lifecycle, Main, LifecycleSignal::Stop);
    return OutcomeCode(a) * 100000 +
        OutcomeCode(b) * 10000 +
        OutcomeCode(c) * 1000 +
        OutcomeCode(d) * 100 +
        OutcomeCode(e) * 10 +
        OutcomeCode(f);
}

int RootTerminalContinuationFinishesImmediatelyCode()
{
    instance ResourceLifecycle lifecycle();
    StepOutcome a = Step(lifecycle, Main, LifecycleSignal::Create);
    StepOutcome b = Step(lifecycle, Main, LifecycleSignal::Begin);
    StepOutcome c = Step(lifecycle, Main, LifecycleSignal::Clean);
    StepOutcome d = Step(lifecycle, Main, LifecycleSignal::Release);
    StepOutcome e = Step(lifecycle, Main, LifecycleSignal::Sweep);
    StepOutcome f = Step(lifecycle, Main, LifecycleSignal::Confirm);
    StepOutcome g = Step(lifecycle, Main, LifecycleSignal::Tick);
    return OutcomeCode(a) * 1000000 +
        OutcomeCode(b) * 100000 +
        OutcomeCode(c) * 10000 +
        OutcomeCode(d) * 1000 +
        OutcomeCode(e) * 100 +
        OutcomeCode(f) * 10 +
        OutcomeCode(g);
}

// The child fails; its parent resumes and can read why.
int ChildFailureReturnsToParentCode()
{
    instance ResourceLifecycle lifecycle();
    StepOutcome a = Step(lifecycle, Main, LifecycleSignal::Create);
    StepOutcome b = Step(lifecycle, Main, LifecycleSignal::Clean);
    StepOutcome c = Step(lifecycle, Main, LifecycleSignal::Release);
    StepOutcome d = Step(lifecycle, Main, LifecycleSignal::Sweep);
    StepOutcome e = Step(lifecycle, Main, LifecycleSignal::Stop);
    StepOutcome f = Step(lifecycle, Main, LifecycleSignal::Stop);
    return OutcomeCode(a) * 1000000 +
        OutcomeCode(b) * 100000 +
        OutcomeCode(c) * 10000 +
        OutcomeCode(d) * 1000 +
        OutcomeCode(e) * 100 +
        OutcomeCode(f) * 10 +
        Result(lifecycle, Cleanup).failure;
}

int IndependentInstancesStayIndependentCode()
{
    instance ResourceLifecycle left();
    instance ResourceLifecycle right();
    StepOutcome a = Step(left, Main, LifecycleSignal::Create);
    StepOutcome b = Step(left, Main, LifecycleSignal::Tick);
    StepOutcome c = Step(right, Main, LifecycleSignal::Stop);
    StepOutcome d = Step(right, Main, LifecycleSignal::Create);
    return OutcomeCode(a) * 1000 +
        OutcomeCode(b) * 100 +
        OutcomeCode(c) * 10 +
        OutcomeCode(d);
}
