module R9d.Runtime; profile Core;
int Decode(int x) { if (x == 1) { return 10; } else if (x == 2) { return 20; } else if (x == 3) { return 30; } else { return 40; } }
int Expression(int x) { return if (x == 1) 10 else if (x == 2) 20 else 40; }
int Nested(int x) { if (x > 0) { if (x == 1) { return 1; } else if (x == 2) { return 2; } } else if (x == -1) { return 3; } return 4; }
int Match(int x) { return match (x) { 1 => 10, 2 => 20, 3 => 30, _ => 40 }; }

[[fact]]
void StatementLadderAgreesWithMatch()
{
    for (x in 0..5) { Assert.Equal(Decode(x), Match(x), "ladder and match agree"); }
}
[[fact]]
void ExpressionAndNestedLadders()
{
    Assert.Equal(Expression(1), 10, "first expression arm");
    Assert.Equal(Expression(2), 20, "second expression arm");
    Assert.Equal(Expression(9), 40, "expression fallback");
    Assert.Equal(Nested(-1), 3, "outer else-if arm");
    Assert.Equal(Nested(2), 2, "nested else-if arm");
}
