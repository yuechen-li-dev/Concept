module Testing.Results;
profile Core;

enum ParseError {
    Invalid, Missing
}
enum OtherError {
    Invalid, Missing
}
[[repr(C)]] record struct Item {
    int count;
    double amount;
}
struct Pair {
    int first;
    int second;
}

Result<int, ParseError> Parse(bool valid, int value) {
    if (valid) { return Result::Ok(value); }
    return Result::Error(ParseError::Missing);
}
Result<int, OtherError> Other(bool valid, int value) {
    if (valid) { return Result::Ok(value); }
    return Result::Error(OtherError::Invalid);
}
int Code(Result<int, ParseError> value) {
    return match (value) {
        Result::Ok(number) => number,
        Result::Error(error) => match (error) {
            ParseError::Invalid => - 1, ParseError::Missing => - 2
        }
    };
}
Result<int, ParseError> Double(bool valid, int value) {
    int number = Parse(valid, value) ?;
    return Result::Ok(number * 2);
}
Result<void, ParseError> Validate(bool valid) {
    if (valid) { return Result::Ok; }
    return Result::Error(ParseError::Invalid);
}
Result<void, ParseError> ValidateTwice(bool valid, ref int calls) {
    calls++;
    Validate(valid) ?;
    calls++;
    Validate(true) ?;
    return Result::Ok;
}
int VoidCode(Result<void, ParseError> value) {
    return match (value) {
        Result::Ok => 7, Result::Error(error) => - 3
    };
}

Result<double, ParseError> MakeDouble(bool valid, double value) {
    if (valid) { return Result::Ok(value); }
    return Result::Error(ParseError::Missing);
}
double DoubleValue(Result<double, ParseError> value) {
    return match (value) {
        Result::Ok(number) => number, Result::Error(error) => - 2.0
    };
}
Result<float, bool> MakeFloat(bool valid, float value) {
    if (valid) { return Result::Ok(value); }
    return Result::Error(true);
}
float FloatValue(Result<float, bool> value) {
    return match (value) {
        Result::Ok(number) => number, Result::Error(error) => - 1.0
    };
}
bool FloatErrorValue(Result<float, bool> value) {
    return match (value) {
        Result::Ok(number) => false, Result::Error(error) => error
    };
}
Result<bool, uint8> MakeBool(bool valid, bool value) {
    if (valid) { return Result::Ok(value); }
    return Result::Error(7);
}
bool BoolValue(Result<bool, uint8> value) {
    return match (value) {
        Result::Ok(answer) => answer, Result::Error(error) => false
    };
}
uint8 BoolErrorValue(Result<bool, uint8> value) {
    return match (value) {
        Result::Ok(answer) => 0, Result::Error(error) => error
    };
}
Result<Pair, uint16> MakePair(bool valid, int value) {
    if (valid) {
        return Result::Ok(Pair{value, value + 1});
    }
    return Result::Error(50000);
}
int PairValue(Result<Pair, uint16> value) {
    return match (value) {
        Result::Ok(pair) => pair.first, Result::Error(error) => - 1
    };
}
uint16 PairErrorValue(Result<Pair, uint16> value) {
    return match (value) {
        Result::Ok(pair) => 0, Result::Error(error) => error
    };
}
Result<Pair, uint16> PairCopy(Result<Pair, uint16> value) {
    Result<Pair, uint16> copy = value;
    match (value) {
        Result::Ok(pair) => {
            pair.first = pair.first + 10;
        }
        Result::Error(error) => { }
    }
    return copy;
}
Result<Item, ParseError> MakeItem(bool valid, int count) {
    if (valid) {
        return Result::Ok(Item{count, 3.5});
    }
    return Result::Error(ParseError::Invalid);
}
Item ItemValue(Result<Item, ParseError> value) {
    return match (value) {
        Result::Ok(item) => item, Result::Error(error) => Item{- 1, 0.0}
    };
}
Result<Item, ParseError> RecordCopy(Result<Item, ParseError> value) {
    Result<Item, ParseError> copy = value;
    match (value) {
        Result::Ok(item) => {
            item = Item{item.count + 1, 9.0};
        }
        Result::Error(error) => { }
    }
    value = Result::Error(ParseError::Invalid);
    return copy;
}
Result<int<array>[3], ParseError> MakeArray(bool valid) {
    if (valid) { return Result::Ok([3, 6, 9]); }
    return Result::Error(ParseError::Invalid);
}
int ArrayValue(Result<int<array>[3], ParseError> value) {
    return match (value) {
        Result::Ok(numbers) => numbers[0] + numbers[2], Result::Error(error) => - 1
    };
}
Result<int<array>[3], ParseError> ForwardArray(bool valid) {
    return Result::Ok(MakeArray(valid) ?);
}
Result<Item, ParseError> ForwardItem(bool valid, int count) {
    Item item = MakeItem(valid, count) ?;
    return Result::Ok(item);
}
int MutateArrayBinding(Result<int<array>[3], ParseError> value) {
    int first = match (value) {
        Result::Ok(numbers) => numbers[0], Result::Error(error) => - 1
    };
    match (value) {
        Result::Ok(numbers) => {
            numbers[0] = 99;
        }
        Result::Error(error) => { }
    }
    return first + ArrayValue(value);
}
Result<int, Item> RecordError(bool valid, int count) {
    if (valid) { return Result::Ok(count); }
    return Result::Error(Item{count + 1, 3.5});
}
int RecordErrorCode(Result<int, Item> value) {
    return match (value) {
        Result::Ok(number) => number, Result::Error(error) => error.count
    };
}
Result<int, double> DoubleError(bool valid, double value) {
    if (valid) { return Result::Ok(5); }
    return Result::Error(value);
}
double DoubleErrorValue(Result<int, double> value) {
    return match (value) {
        Result::Ok(number) => 5.0, Result::Error(error) => error
    };
}
Result<int, int<array>[3]> ArrayError(bool valid) {
    if (valid) { return Result::Ok(1); }
    return Result::Error([4, 7, 10]);
}
int ArrayErrorCode(Result<int, int<array>[3]> value) {
    return match (value) {
        Result::Ok(number) => number, Result::Error(error) => error[0] + error[2]
    };
}
Result<void, Item> VoidRecord(bool valid) {
    if (valid) { return Result::Ok; }
    return Result::Error(Item{7, 3.5});
}
int VoidRecordCode(Result<void, Item> value) {
    return match (value) {
        Result::Ok => 8, Result::Error(error) => error.count
    };
}
int LocalCopies(int value) {
    Result<int, ParseError> first = Result::Ok(value);
    Result<int, ParseError> second = first;
    first = Result::Error(ParseError::Missing);
    int total = Code(first) + Code(second);
    first = Result::Ok(value + 10);
    second = first;
    return total + Code(second);
}
int Mark(ref int log, int digit) {
    log = log * 10 + digit;
    return digit;
}
Result<int, ParseError> Probe(ref int log, bool valid, int value) {
    discard Mark(ref log, 2);
    return Parse(valid, value);
}
Result<int, ParseError> ExpressionOrder(ref int log, bool valid, int value) {
    int number = Mark(ref log, 1) + Probe(ref log, valid, value) ? + Mark(ref log, 3);
    return Result::Ok(number);
}
int Sum(int first, int second, int third) {
    return first + second + third;
}
Result<int, ParseError> ArgumentOrder(ref int log, bool valid, int value) {
    return Result::Ok(Sum(Mark(ref log, 1), Probe(ref log, valid, value) ?, Mark(ref log, 3)));
}
Result<Item, ParseError> RecordOrder(ref int log, bool valid) {
    return Result::Ok(Item{Mark(ref log, 1), MakeDouble(valid, 3.5) ?});
}
OtherError Remapped(ref int log) {
    log++;
    return OtherError::Missing;
}
Result<int, OtherError> Remap(ref int log, bool valid, int value) {
    int number = Parse(valid, value) ? else Remapped(ref log);
    return Result::Ok(number + 1);
}
int OtherCode(Result<int, OtherError> value) {
    return match (value) {
        Result::Ok(number) => number, Result::Error(error) => match (error) {
            OtherError::Invalid => - 1, OtherError::Missing => - 2
        }
    };
}
Result<bool, ParseError> Positive(bool valid, int value) {
    int number = Parse(valid, value) ?;
    return Result::Ok(number > 0);
}
bool PositiveValue(Result<bool, ParseError> value) {
    return match (value) {
        Result::Ok(answer) => answer, Result::Error(error) => false
    };
}
Result<int, ParseError> Recursive(bool valid, int depth) {
    if (depth == 0) { return Parse(valid, 4); }
    int value = Recursive(valid, depth - 1) ?;
    return Result::Ok(value + 1);
}
Result<int, ParseError> Read(ref int calls, bool valid, int value) {
    calls++;
    return Parse(valid, value);
}
Result<int, ParseError> Loop(int count, int failAt, ref int calls) {
    int sum = 0;
    for (int index in 0 .. count) {
        int value = Read(ref calls, index != failAt, index) ?;
        sum += value;
    }
    return Result::Ok(sum);
}
Result<double, ParseError> Mixed(Result<int, ParseError> first, int bias, double amount,
ref int calls, Result<double, ParseError> fifth, float sixth, bool seventh) {
    int number = first ?;
    double decimal = fifth ?;
    if (number + bias < 0) { return Result::Error(ParseError::Invalid); }
    if (sixth != 1.25) { return Result::Error(ParseError::Invalid); }
    if (seventh == false) { return Result::Error(ParseError::Invalid); }
    calls++;
    return Result::Ok(decimal + amount);
}
Result<double, ParseError> MixedCaller(bool firstValid, bool secondValid, ref int calls) {
    return Mixed(Parse(firstValid, 7), 1, MakeDouble(secondValid, 2.0) ?, ref calls, MakeDouble(true,
    3.5), 1.25, true);
}
Result<double, ParseError> Seven(double a, double b, double c, double d, double e, double f, double g) {
    return Result::Ok(a + b + c + d + e + f + g);
}
Result<double, ParseError> FloatingPressure(double a, double b, double c, double d, double e, double f,
double g) {
    double value = Seven(g, f, e, d, c, b, a) ?;
    return Result::Ok(value + a + b + c + d + e + f + g);
}
Result<double, ParseError> DoubleCopy(Result<double, ParseError> value) {
    Result<double, ParseError> copy = value;
    value = Result::Error(ParseError::Invalid);
    return copy;
}
int Discard(ref int calls) {
    discard Read(ref calls, false, 7);
    return calls;
}
Result<int, ParseError> Conditional(bool valid, int value) {
    if (Positive(valid, value) ?) { return Result::Ok(9); }
    return Result::Ok(0);
}
