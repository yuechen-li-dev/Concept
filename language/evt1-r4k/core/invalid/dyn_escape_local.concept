profile Core;

interface Resettable<T>
{
    requires void Reset(ref T self);
}

struct Device
{
    int state;

    void Reset(ref Device self)
    {
        self.state = 0;
    }
}

dyn Resettable InvalidEscape()
{
    Device device = Device{1};
    dyn Resettable resettable = ref device;
    return resettable;
}
