profile Core;

automata Chooser
{
    machine Run
    {
        int priority = 9;

        state Idle
        {
            transition decide
            {
                Waiting score 2;
                Running score priority;
            }
        }

        state Waiting { }
        state Running { }
    }
}

int Main()
{
    instance Chooser chooser();
    Step(chooser, Run);
    return State(chooser, Run);
}
