profile Core;

automata Chooser
with state
{
    int urgency;
}
{
    machine Run
    {
        state Idle
        {
            transition decide
            {
                Waiting score 2;
                Running score urgency;
            }
        }

        state Waiting { }
        state Running { }
    }
}

int Main()
{
    instance Chooser chooser(9);
    Step(chooser, Run);
    return State(chooser, Run);
}
