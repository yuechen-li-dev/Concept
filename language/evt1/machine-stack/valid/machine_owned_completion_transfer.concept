profile Core;

struct Resource
{
    int value;
}

void Drop(owned Resource resource)
{
}

automata Owner
{
    machine Parent
    {
        state Start
        {
            push Child goto Resumed;
        }

        state Resumed
        {
        }
    }

    machine Child returns owned Resource
    {
        owned Resource resource = Resource{9};

        state Done
        {
            complete move resource;
        }
    }
}

int Main()
{
    instance Owner owner();
    Step(owner, Parent);
    Step(owner, Parent);
    return 0;
}
