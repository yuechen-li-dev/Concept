profile Core;

layout TensorStreamLayout
{
    int<ndarray>[2, 2] values;
}

stream TensorStream over TensorStreamLayout
{
    Values = values;
}

int TensorFromStreamChannel()
{
    int<array>[4] backing = [1, 2, 3, 4];
    ref TensorStreamLayout layout = bind backing;
    ref TensorStream stream = bind layout;
    tensor<int, 2> values = Tensor(stream.Values);
    return values[1, 0];
}
