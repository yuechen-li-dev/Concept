profile Core;

int TensorBroadcastRejected()
{
    int<ndarray>[2, 3] matrixStorage = [[1, 2, 3], [4, 5, 6]];
    int<ndarray>[3] rowStorage = [10, 20, 30];
    int<ndarray>[2, 3] outStorage = [[0, 0, 0], [0, 0, 0]];
    tensor<int, 2> Matrix = Tensor(matrixStorage);
    tensor<int, 1> Row = Tensor(rowStorage);
    tensor<int, 2> Out = Tensor(outStorage);
    Out = Matrix + Row;
    return 0;
}
