module R6h.FactCapture;
profile Core;
import Standard.MemoryGeometry;
int Main()
{
    int<array>[4] backing = [0, 0, 0, 0];
    Address<SystemMemory> start = AddressOf<SystemMemory>(ref backing);
    usize<byte> extent = 16;
    usize<byte> alignment = 4;
    MemoryRegion<SystemMemory> region = MemoryRegion<SystemMemory>{start, extent, alignment};
    const auto inspect = callback() with (region)
    {
        Assert.Concept<Aligned<4>>(region, "capture field retains alignment");
        return 1;
    };
    return inspect();
}
