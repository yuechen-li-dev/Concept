module R6h.FactGenericWrapper;
profile Core;
import Standard.MemoryGeometry;
import Standard.Generic;
int Main()
{
    int<array>[4] backing = [0, 0, 0, 0];
    Address<SystemMemory> start = AddressOf<SystemMemory>(ref backing);
    usize<byte> extent = 16;
    usize<byte> alignment = 4;
    MemoryRegion<SystemMemory> source = MemoryRegion<SystemMemory>{start, extent, alignment};
    Box<MemoryRegion<SystemMemory>> box = Box<MemoryRegion<SystemMemory>>{source};
    MemoryRegion<SystemMemory> result = box.value;
    Assert.Concept<SameRegion>(source, result, "generic field retains origin");
    return 0;
}
