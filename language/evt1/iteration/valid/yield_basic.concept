profile Core;

automata Worker
with state
{
    int entries;
}
{
    machine Run
    {
        int attempts;

        state Waiting
        {
            state.entries = state.entries + 1;
            machine.attempts = machine.attempts + 1;
            yield;
        }
    }
}

int Main()
{
    instance Worker worker(0);
    Step(worker, Run);
    Step(worker, Run);
    return worker.state.entries;
}
