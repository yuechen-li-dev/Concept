module Research.Protocol;
profile Core;
template <typename T> record struct Box {
    T value;
}
enum Failure {
    Unsupported(typename subject), Missing
}
template <typename T> comptime T Identity(T value) {
    return value;
}
comptime Verdict<Box<uint8>, Failure> Judge(typename subject) {
    return match {
        when compiler.TypeName(subject) == "int" => Verdict::Proven(Identity<Box<uint8>>(Box<uint8>{
            7
        })),
        when compiler.TypeName(subject) == "float" => Verdict::Unknown,
        otherwise => Verdict::Disproven(Failure::Unsupported(subject)),
    };
}
comptime string JudgeDescribe(Failure failure) {
    return match (failure) {
        Failure::Unsupported(subject) => "unsupported type " + compiler.TypeName(subject),
        Failure::Missing => "missing evidence",
    };
}
concept Supported<T> {
    requires Judge(T);
}
int Use() {
    Assert.Concept<Supported>(int, "typed proof");
    return 7;
}
comptime Verdict<Box<uint8>, Failure> ValueJudge(int mode) {
    return match {
        when mode == 0 => Verdict::Proven(Box<uint8>{7}), when mode == 1 => Verdict::Disproven(Failure::Missing),
        otherwise => Verdict::Unknown,
    };
}
comptime Verdict<Box<uint8>, Failure> Good = ValueJudge(0);
comptime Verdict<Box<uint8>, Failure> Bad = ValueJudge(1);
comptime Verdict<Box<uint8>, Failure> Missing = ValueJudge(2);
static_assert(match (Good) {
    Verdict::Proven(e) => e.value == 7, Verdict::Disproven(r) => false, Verdict::Unknown => false,
}, "selected evidence");
static_assert(match (Bad) {
    Verdict::Proven(e) => false, Verdict::Disproven(r) => true, Verdict::Unknown => false,
}, "selected refutation");
static_assert(match (Missing) {
    Verdict::Proven(e) => false, Verdict::Disproven(r) => false, Verdict::Unknown => true,
}, "unknown stays unknown");
