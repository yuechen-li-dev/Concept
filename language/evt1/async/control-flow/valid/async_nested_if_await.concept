profile Core;
async int A() { return 42; }
async int B() { return 7; }
async int Work(bool outer, bool inner) {
    int value = 0;
    if (outer) {
        if (inner) { value = await A(); }
        else { value = await B(); }
    }
    return value;
}
int Main()
{
    Async<int> work = Work(true, true);
    while (not Complete(work)) bounded(8)
    {
        Step(work);
    }
    return Result(work);
}
