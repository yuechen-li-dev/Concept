profile Core;
enum ReadError { Missing }
enum Command { Read, Idle }
async Result<int, ReadError> Read() { return Result::Ok(42); }
async Result<int, ReadError> Work(Command command) {
    int answer = 0;
    match (command) {
        Command::Read => { answer = answer + await Read()?; }
        Command::Idle => { answer = 0; }
    }
    return Result::Ok(answer);
}
int Unwrap(Result<int, ReadError> result) { return match (result) { Result::Ok(value) => value, Result::Error(error) => 0, }; }
int Main() { Async<Result<int, ReadError>> work = Work(Command::Read); while (not Complete(work)) bounded(8) { Step(work); } return Unwrap(Result(work)); }
