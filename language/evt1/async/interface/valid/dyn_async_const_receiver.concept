profile Core;

interface Reader<T>
{
    requires async int Read(ref const T self);
}

struct Device
{
    int value;

    async int Read(ref const Device self)
    {
        return self.value;
    }
}

int Main()
{
    const Device device = Device{42};
    dyn const Reader reader = ref const device;
    Async<int> work = reader.Read();
    while (not Complete(work)) bounded(2)
    {
        Step(work);
    }
    return Result(work);
}
