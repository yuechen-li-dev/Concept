profile Core;

interface Reader<T>
{
    requires async int Read(ref T self);
}

class Device
{
public:
    int value;

    async int Read()
    {
        return value;
    }
}

requires Reader<Device>;

int Main()
{
    Device device = Device{42};
    Async<int> work = device.Read();
    while (not Complete(work)) bounded(2)
    {
        Step(work);
    }
    return Result(work);
}
