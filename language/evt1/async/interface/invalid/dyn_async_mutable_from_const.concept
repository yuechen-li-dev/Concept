profile Core;

interface Reader<T>
{
    requires async int Read(ref T self);
}

struct Device
{
    int value;

    async int Read(ref Device self)
    {
        return 1;
    }
}

int Main()
{
    const Device device = Device{1};
    dyn const Reader reader = ref const device;
    Async<int> work = reader.Read();
    return 0;
}
