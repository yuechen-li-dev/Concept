profile Core;

auto MakeAdder(int amount)
{
    return callback(int value)
    with (amount)
    {
        return value + amount;
    };
}

using Adder = typeof(MakeAdder(1));

int Apply(ref const Adder add, int value)
{
    return add(value);
}

int Main()
{
    Adder add = MakeAdder(2);
    return Apply(ref const add, 8);
}
