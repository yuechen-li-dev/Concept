profile Core;

struct Ticket
{
    int number;
}

int Redeem(owned Ticket ticket)
{
    return ticket.number;
}

int Main()
{
    owned Ticket ticket = Ticket{3};
    auto redeem = callback()
    with (move ticket)
    {
        return Redeem(move ticket);
    };
    redeem();
    return redeem();
}
