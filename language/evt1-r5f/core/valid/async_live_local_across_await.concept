profile Core;

async int Child()
{
    return 2;
}

async int LiveLocal()
{
    int retained = 40;
    int child = await Child();
    return retained + child;
}

int Main()
{
    Async<int> work = LiveLocal();
    while (not Complete(work)) bounded(4)
    {
        Step(work);
    }
    return Result(work);
}
