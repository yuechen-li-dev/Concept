profile Core;

async int Child(int value)
{
    return value;
}

async int Choose(bool first)
{
    int value = 0;
    if (first)
    {
        value = await Child(40);
    }
    else
    {
        value = await Child(1);
    }
    return value + 2;
}

int Main()
{
    Async<int> work = Choose(true);
    while (not Complete(work)) bounded(8)
    {
        Step(work);
    }
    return Result(work);
}
