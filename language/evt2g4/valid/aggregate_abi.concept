TwentyFour Shifted(int a, double b, int c, float d) {
    return TwentyFour{1.0, b, 3.0};
}
TwentyFour Blend(Eight small, TwentyFour large, double scale, ref const Four view, float bias, int count) {
    return large;
}
int Mixed(int a, bool flag, float b, double c, Eight small, TwentyFour large, ref int mutable, ref const Four view) {
    mutable = a;
    return view.value;
}
int FivePlus(One a, Two b, Four c, Eight d, Eight e, TwentyFour f) {
    return c.value;
}
int MutateValue(MutableValue value) {
    value.a = 91.0;
    return 7;
}
TwentyFour Early(bool flag, TwentyFour value) {
    if (flag) { return value; }
    return TwentyFour{4.0, 5.0, 6.0};
}
int Consume(TwentyFour value) {
    return 9;
}
TwentyFour Produce() {
    return TwentyFour{1.0, 2.0, 3.0};
}
int Chain() {
    return Consume(Produce());
}
int Driver() {
    Four four = Four{4};
    Eight small = Eight{8};
    TwentyFour large = TwentyFour{1.0, 2.0, 3.0};
    TwentyFour first = Shifted(1, 2.0, 3, 4.0);
    TwentyFour second = Blend(small, large, 2.0, ref const four, 1.0, 2);
    TwentyFour third = Early(true, second);
    int a = Consume(first);
    int b = Consume(third);
    return a + b;
}
int Isolation() {
    MutableValue original = MutableValue{1.0, 2.0, 3.0};
    int result = MutateValue(original);
    return result;
}
int DirectChain() {
    Four value = RoundFour(Four{4});
    Eight other = RoundEight(Eight{8});
    return value.value;
}
int StackArguments() {
    return FivePlus(One{1}, Two{2}, Four{3}, Eight{4}, Eight{5}, TwentyFour{1.0, 2.0, 3.0});
}
int CallMixed() {
    int mutable = 0;
    Four view = Four{4};
    int result = Mixed(1, true, 2.0, 3.0, Eight{8}, TwentyFour{1.0, 2.0, 3.0}, ref mutable, ref const view);
    return result;
}
