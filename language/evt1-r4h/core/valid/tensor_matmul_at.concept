profile Core;

int TensorMatmulAt()
{
    int<ndarray>[2, 3] aStorage = [[1, 2, 3], [4, 5, 6]];
    int<ndarray>[3, 2] bStorage = [[7, 8], [9, 10], [11, 12]];
    int<ndarray>[2, 2] cStorage = [[0, 0], [0, 0]];
    tensor<int, 2> A = Tensor(aStorage);
    tensor<int, 2> B = Tensor(bStorage);
    tensor<int, 2> C = Tensor(cStorage);
    C = A @ B;
    return C[1, 1];
}
