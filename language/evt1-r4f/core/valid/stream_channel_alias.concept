profile Core;

layout AliasLayout
{
    int<array>[2] physical;
}

stream AliasStream over AliasLayout
{
    Semantic = physical;
}

int StreamChannelAliasesRegion()
{
    int<array>[2] backing = [4, 5];
    ref AliasLayout layout = bind backing;
    ref AliasStream stream = bind layout;
    stream.Semantic[0] = 17;
    return layout.physical[0];
}
