profile Core;

enum Command { Read, Idle }

asynchronous int First()
{
    return 20;
}

asynchronous int Second(int value)
{
    return value + 22;
}

asynchronous int Work(Command command)
{
    int value = 0;
    match (command)
    {
        Command::Read =>
        {
            int first = awaitchronous First();
            value = awaitchronous Second(first);
        }
        Command::Idle =>
        {
            value = 1;
        }
    }
    return value;
}

int Main()
{
    Async<int> work = Work(Command::Read);
    while (not Complete(work)) bounded(8)
    {
        Step(work);
    }
    return Result(work);
}
