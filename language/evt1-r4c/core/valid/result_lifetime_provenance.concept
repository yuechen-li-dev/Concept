profile Core;

ref struct View {
    ref const int data;
}

enum ViewError { Missing, }

Result<View, ViewError> Borrow(ref const int source) {
    View view = View { ref const source };
    return Result::Ok(view);
}

Result<View, ViewError> Forward(ref const int source) {
    View view = Borrow(ref const source)?;
    return Result::Ok(view);
}
