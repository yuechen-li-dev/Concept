profile Core;

automata Chooser
{
    machine Run
    {
        state Idle
        {
            transition decide
            {
                Idle score 5;
                Running score 1;
            }
        }

        state Running { }
    }
}

int Main()
{
    instance Chooser chooser();
    Step(chooser, Run);
    return State(chooser, Run);
}
