profile Core;

automata Chooser
{
    machine Run
    {
        state Idle
        {
            transition decide
            {
                Waiting score 1.5;
                Running score 2.5;
            }
        }

        state Waiting { }
        state Running { }
    }
}

int Main()
{
    instance Chooser chooser();
    Step(chooser, Run);
    return State(chooser, Run);
}
