profile Core;

int Add(int a, int b)
{
    return a + b;
}

int Max(int a, int b)
{
    if (a > b)
    { return a; }
    return b;
}

int Sum4(int[4] values)
{
    int total = 0;
    for (i in 0 .. 4)
    {
        total += values[i];
    }
    return total;
}

int CheckedIndex(int[4] values, int index)
{
    return values[index];
}

int StoreIndex(int[4] values, int index, int value)
{
    values[index] = value;
    return values[index];
}

int Choose(bool condition, int a, int b)
{
    if (condition)
    { return a; }
    else
    { return b; }
}

int Early(int value)
{
    int result = value;
    if (result > 0)
    {
        result = result - 1;
        return result;
    }
    return result;
}
