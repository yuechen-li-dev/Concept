profile Core;
struct Token
{
    int value;
}

void Drop(owned Token token)
{
}
automata Chooser
{
    machine Run
    {
        state Idle
        {
            owned Token token = Token { 1 };
            transition infer with HardMax
            {
                Running score 1.0;
            }
        }
        state Running { }
    }
}

int Main()
{
    instance Chooser chooser();
    Step(chooser, Run);
    return State(chooser, Run);
}
