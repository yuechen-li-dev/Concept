profile Core;
enum Action
{
    Attack,
    Idle
}
automata Brain
{
    machine Run
    {
        float urgency = 3.0;
        state Idle
        {
            Inference<Action> belief = infer
            {
                Attack score urgency;
                Idle score 0.0;
            };
        }
    }
}

void Main()
{
    instance Brain brain();
    Step(brain, Run);
}
