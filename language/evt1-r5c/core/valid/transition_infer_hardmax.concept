profile Core;
automata Chooser
{
    machine Run
    {
        state Idle
        {
            transition infer with HardMax
            {
                Waiting score 1.0;
                Running score 2.0;
            }
        }
        state Waiting { }
        state Running { }
    }
}
int Main()
{
    instance Chooser chooser();
    Step(chooser, Run);
    return State(chooser, Run);
}
