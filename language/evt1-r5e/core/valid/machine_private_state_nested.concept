profile Core;

automata PrivateFrames
with state
{
    int value;
}
{
    machine Parent
    {
        int local = 4;

        state Start
        {
            push Child goto Resumed;
        }

        state Resumed
        {
            state.value = machine.local;
        }
    }

    machine Child
    {
        int local = 9;

        state Done
        {
            state.value = machine.local;
            pop;
        }
    }
}

int Main()
{
    instance PrivateFrames worker(0);
    Step(worker, Parent);
    Step(worker, Parent);
    Step(worker, Parent);
    return worker.state.value;
}
